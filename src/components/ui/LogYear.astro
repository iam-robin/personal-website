---
/**
 * One year of a media log: the year label, a count, and the rows below it.
 * The header is the same row /books gives each shelf, so every log reads as
 * one habit recorded several ways. Rows go in the slot as <LogRow>s.
 */
interface Props {
    /** The heading — a year, or "Undated" for entries logged without one. */
    label: string;
    count: number;
    /** Singular; pluralised with an "s" for the count line. */
    noun: string;
}

const { label, count, noun } = Astro.props;
---

<section>
    <div
        class="flex items-baseline justify-between gap-4 border-b border-dotted border-ink/30 pb-4"
    >
        <h2 class="text-sm font-bold">{label}</h2>
        <p class="font-mono text-xs opacity-40">
            {`${count} ${count === 1 ? noun : `${noun}s`}`}
        </p>
    </div>

    <ul class="mt-4">
        <slot />
    </ul>
</section>

---
interface Props {
    label: string;
    count: number;
    noun: string;
}

const { label, count, noun } = Astro.props;
---

<section>
    <div
        class="flex items-baseline justify-between gap-4 border-b border-dotted border-ink/30 pb-4"
    >
        <h2 class="text-sm font-bold">{label}</h2>
        <p class="font-mono text-xs text-ink-muted">
            {`${count} ${count === 1 ? noun : `${noun}s`}`}
        </p>
    </div>

    <ul class="mt-4">
        <slot />
    </ul>
</section>

---
/** Primary navigation with native popovers for grouped links. */
import { Icon } from "astro-icon/components";
import PopoverPanel from "./PopoverPanel.astro";
import { navItems as items } from "../../data/navigation";

interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<nav class={`hidden flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm md:flex ${className}`} aria-label="Primary">
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {items.map((item, index) => (
            <li class="nav-item relative flex items-center">
                {!item.children ? (
                    <a
                        href={item.href}
                        class:list={[
                            "underline-offset-4",
                            isActive(item.href) ? "underline" : "text-ink-muted hover:underline hover:text-ink",
                        ]}
                        aria-current={path === item.href ? "page" : undefined}
                        {...(item.external && { target: "_blank", rel: "noopener noreferrer" })}
                    >
                        {item.label}{item.external && " ↗"}
                    </a>
                ) : (
                    <>
                        <button
                            type="button"
                            popovertarget={`nav-submenu-${index}`}
                            style={{ "anchor-name": `--nav-submenu-${index}` }}
                            class:list={[
                                "flex min-h-6 cursor-pointer items-center gap-1 rounded underline-offset-4 hover:text-ink",
                                item.children.some((child) => isActive(child.href)) ? "underline" : "text-ink-muted",
                            ]}
                        >
                            {item.label}
                            <Icon name="ph:caret-down" size={14} class="nav-caret" />
                        </button>
                        <PopoverPanel id={`nav-submenu-${index}`} class="min-w-40 max-md:hidden">
                            <ul>
                                {item.children.map((child) => (
                                    <li>
                                        <a
                                            href={child.href}
                                            class:list={["block rounded px-3 py-2 underline-offset-4 hover:bg-ink/5 hover:text-ink", isActive(child.href) ? "underline" : "text-ink-muted"]}
                                            aria-current={path === child.href ? "page" : undefined}
                                        >{child.label}</a>
                                    </li>
                                ))}
                            </ul>
                        </PopoverPanel>
                    </>
                )}
            </li>
        ))}
    </ul>
</nav>

<style>
    .nav-item:has(:popover-open) :global(.nav-caret) { rotate: 180deg; }
</style>

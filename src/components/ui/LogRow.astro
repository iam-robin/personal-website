---
import { Icon } from "astro-icon/components";
import Rating from "./Rating.astro";

interface Props {
    title: string;
    chip?: string | number | null;
    /** Decorative: what it stands for is in the meta or implied. */
    favourite?: boolean;
    rating?: number | null;
    date?: string;
    meta?: string;
    cover?: string | null;
    /** Garden note URL. Marks the row and makes it a link. */
    note?: string | null;
}

const {
    title,
    chip,
    favourite = false,
    rating,
    date = "",
    meta = "",
    cover,
    note,
} = Astro.props;
---

<li
    class="list-item-image-hover-effect group relative border-b border-dotted border-ink/15 py-3 md:border-0 md:py-2"
>
    <div class="flex items-center justify-between gap-4">
        {
            cover && (
                <img
                    class="cover-image pointer-events-none absolute z-10 hidden w-36 rounded-sm shadow-[var(--shadow-floating)] outline outline-1 -outline-offset-1 outline-black/10 md:group-hover:block"
                    src={cover}
                    alt=""
                    width="400"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.style.display='none'"
                />
            )
        }

        {/* Below md the title truncates against the meta. From md the hairline's
            `grow` would eat it, so it holds its width and the cap keeps it off the meta. */}
        <div class="flex min-w-0 items-center gap-2 md:max-w-[75%] md:shrink-0">
            <p class="truncate font-mono text-sm" title={title}>
                {
                    note ? (
                        /* Stretched over the row, which is the positioned box. */
                        <a
                            href={note}
                            class="underline-offset-4 group-hover:underline after:absolute after:inset-0 after:content-['']"
                        >
                            {title}
                            <span class="sr-only"> — read my note</span>
                        </a>
                    ) : (
                        title
                    )
                }
            </p>
            {
                chip && (
                    <span class="shrink-0 font-mono text-xs text-ink-muted">
                        {chip}
                    </span>
                )
            }
            {
                note && (
                    /* Positioned above the title's stretched ::after, or it
                       never gets the hover for its tooltip. */
                    <a
                        href={note}
                        tabindex="-1"
                        aria-hidden="true"
                        title="I wrote a note on this"
                        class="relative shrink-0 opacity-55"
                    >
                        <Icon name="ph:pen-nib-fill" width={12} />
                    </a>
                )
            }
            {
                favourite && (
                    <span class="shrink-0 opacity-55" aria-hidden="true">
                        <Icon name="ph:heart-fill" width={11} />
                    </span>
                )
            }
        </div>

        <div class="hidden h-px w-full grow bg-ink/10 md:block"></div>

        {
            (rating || date || meta) && (
                <p class="flex shrink-0 items-center gap-2 font-mono text-xs text-ink-muted">
                    {rating && <Rating value={rating} />}
                    {rating && (date || meta) && <span aria-hidden="true">·</span>}
                    {date && (
                        <span class="inline-block w-[6ch] whitespace-nowrap">{date}</span>
                    )}
                    {meta}
                </p>
            )
        }
    </div>
</li>

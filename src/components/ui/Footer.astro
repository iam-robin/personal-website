---
/*
 * Site footer. No sitemap: the nav is already at the top and in the mobile
 * menu. Two robins stand on the rule (one resting, one smitten), drawn from
 * the logo's shapes with its wobble filter.
 */
import { Icon } from "astro-icon/components";
import BirdParts from "../BirdParts.astro";
import { BIRD_MOODS } from "../../data/birdShape";
import { contactChannels, siteLinks } from "../../data/links";
import { carbon } from "../../data/carbon";

interface Props {
    class?: string;
}
const { class: className } = Astro.props;

/* The site has been around since 2022. The end year is the build year; the
   daily rebuild rolls it over in January. */
const FIRST_YEAR = 2022;
const year = new Date().getFullYear();
const filterId = `footer-wobble-${Math.random().toString(36).slice(2, 8)}`;
const externalAttrs = (href: string, me?: boolean) =>
    href.startsWith("http")
        ? { target: "_blank", rel: me ? "me noopener noreferrer" : "noopener noreferrer" }
        : {};

const resting = BIRD_MOODS.resting;
const smitten = BIRD_MOODS.smitten;
/* The second bird is mirrored to face the first; 172 + 139 = its right edge. */
const SECOND_BIRD_X = 172;
---

<footer class:list={["site-footer", className]}>
    <!-- Bird units (139x162 each) with the ground at y = 162, so the feet land on the rule. -->
    <svg class="love-birds" viewBox="0 0 312 162" fill="none" aria-hidden="true">
        <defs>
            <filter id={filterId} x="-20%" y="-20%" width="140%" height="140%" filterUnits="objectBoundingBox">
                <feTurbulence type="fractalNoise" baseFrequency="0.07" numOctaves="3" seed="81" result="n" />
                <feDisplacementMap in="SourceGraphic" in2="n" scale="3" />
            </filter>
        </defs>
        <g filter={`url(#${filterId})`}>
            <g transform={resting.transform}><BirdParts parts={resting.parts} /></g>
        </g>
        <g transform={`translate(${SECOND_BIRD_X + 139} 0) scale(-1 1)`}>
            <g filter={`url(#${filterId})`}>
                <g transform={smitten.transform}><BirdParts parts={smitten.parts} /></g>
            </g>
        </g>
    </svg>

    <div class="rule">
        <div class="row">
            <p>© {FIRST_YEAR}–{year} Robin Spielmann</p>
            <ul class="icons" aria-label="Elsewhere">
                {contactChannels.map((channel) => (
                    <li>
                        <a href={channel.href} aria-label={channel.label} title={channel.label} {...externalAttrs(channel.href, channel.me)}>
                            <Icon name={channel.icon} size={18} aria-hidden="true" />
                        </a>
                    </li>
                ))}
            </ul>
        </div>
        <div class="row secondary">
            <a class="badge" href={carbon.reportUrl} target="_blank" rel="noopener noreferrer">
                <span class="grade">{carbon.rating}</span>
                <span>{carbon.gramsPerVisit} g CO₂ per visit ↗</span>
            </a>
            <nav class="small-print" aria-label="Small print">
                {siteLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </nav>
        </div>
    </div>
</footer>

<style>
    /* One line height and one gap for every row, so the footer keeps a single
       rhythm whether rows sit side by side or wrap. 36px still clears the 24px
       minimum target size. */
    .site-footer { --line: 2.25rem; --gap: 1.5rem; --icon-box: calc(var(--line) + .5rem); container-type: inline-size; font: .8125rem/1.5 var(--font-mono); }
    .love-birds { display: block; block-size: 5.5rem; width: auto; margin-inline: auto 6%; margin-block-end: -1px; color: var(--color-ink); overflow: visible; }
    /* The birds stand on it, so the rule is solid, like a ground line. */
    .rule { border-block-start: 1.5px solid var(--color-ink); padding-block-start: .75rem; }
    .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 2rem; }
    .row > p { display: flex; align-items: center; min-block-size: var(--line); }
    .secondary { color: var(--color-ink-muted); }
    /* Icon boxes are wider than the glyph; the negative margin keeps the glyph on the edge. */
    .icons { display: flex; margin-inline-end: calc((var(--icon-box) - 18px) / -2); }
    .icons a { display: grid; place-items: center; inline-size: var(--icon-box); block-size: var(--line); opacity: .6; transition: opacity 150ms ease-out; }
    .small-print { display: flex; flex-wrap: wrap; gap: 0 var(--gap); }
    .small-print a { display: inline-flex; align-items: center; min-block-size: var(--line); }
    .badge { display: inline-flex; align-items: center; gap: .5rem; min-block-size: var(--line); }
    .grade { padding: .125rem .5rem; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-weight: 700; font-size: .75rem; }
    @media (hover: hover) {
        .icons a:hover { opacity: 1; }
        .small-print a:hover, .badge:hover span:last-child { color: var(--color-ink); text-decoration: underline; text-underline-offset: .25rem; }
    }
    @container (max-width: 30rem) {
        .love-birds { block-size: 4.25rem; margin-inline-end: 0; }
        .secondary { flex-direction: column-reverse; align-items: flex-start; }
        .icons { margin-inline: calc((var(--icon-box) - 18px) / -2) 0; }
    }
</style>

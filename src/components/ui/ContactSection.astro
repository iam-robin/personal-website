---
/** Email and postcards are the primary actions; social links form the address book. */
import { contactChannels as channels, contactLinks } from "../../data/links";
import InkMark from "./InkMark.astro";
import PostcardStampPreview from "../postcards/PostcardStampPreview.astro";

const socialChannels = channels.filter((channel) => channel.icon !== "email");
const leavesSite = (href: string) =>
    href.startsWith("http") || href.startsWith("mailto:");
const externalAttrs = (href: string, me?: boolean) =>
    href.startsWith("http")
        ? {
              target: "_blank",
              rel: me ? "me noopener noreferrer" : "noopener noreferrer",
          }
        : {};

const actionClass = "grid min-h-25 content-center gap-1.5 rounded-xl border border-inset bg-transparent p-4 font-bold underline-offset-4 hover:underline";
const detailClass = "font-mono text-[0.8125rem] leading-normal font-normal text-ink-muted";
---

<section
    class="@container grid gap-4 min-[54rem]:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] min-[54rem]:grid-rows-[auto_auto] min-[54rem]:items-stretch min-[54rem]:gap-x-6"
    aria-labelledby="contact-title"
>
    <h2 class="text-[0.875rem] leading-5 font-bold min-[54rem]:col-span-full" id="contact-title">Contact</h2>

    <div
        class="grid grid-cols-2 gap-3 min-[54rem]:col-start-1 min-[54rem]:row-start-2 min-[54rem]:grid-cols-1 min-[54rem]:grid-rows-2 min-[54rem]:self-stretch @max-[34rem]:grid-cols-1"
        aria-label="Primary contact actions"
    >
        <a href={contactLinks.email.href} class={actionClass}>
            Email me
            <span class={detailClass}>{contactLinks.email.handle} ↗</span>
        </a>
        <div class="postcard-action-wrap group relative min-w-0">
            <a href="/postcards/new" class:list={[actionClass, "h-full [@media(hover:hover)]:pe-22"]}>
                <span class="grid gap-1.5">
                    Send a postcard
                    <span class={detailClass}>leave a note →</span>
                </span>
            </a>
            <PostcardStampPreview />
        </div>
    </div>

    <ul
        class="grid border-t border-dotted border-ink/30 min-[54rem]:col-start-2 min-[54rem]:row-start-2 min-[54rem]:flex min-[54rem]:flex-col min-[54rem]:self-stretch"
        aria-label="Elsewhere"
    >
        {socialChannels.map((channel) => (
            <li class="min-[54rem]:flex min-[54rem]:flex-1">
                <a
                    href={channel.href}
                    {...externalAttrs(channel.href, channel.me)}
                    class="group grid grid-cols-[1.25rem_minmax(0,1fr)_auto] items-center gap-4 border-b border-dotted border-ink/30 py-3.5 font-mono text-[0.875rem] leading-normal min-[54rem]:flex-1 @max-[34rem]:grid-cols-[1.25rem_minmax(0,1fr)]"
                >
                    <InkMark
                        name={channel.icon}
                        class="h-5 w-5 opacity-60 transition-opacity group-hover:opacity-100"
                    />
                    <span class="underline-offset-4 group-hover:underline">{channel.label}</span>
                    <small class="text-ink-muted @max-[34rem]:col-start-2">
                        {channel.handle}
                        {leavesSite(channel.href) && " ↗"}
                    </small>
                </a>
            </li>
        ))}
    </ul>
</section>

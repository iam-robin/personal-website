---
/**
 * Contact block for the foot of the homepage's right column — a roomier take
 * on the horizontal ContactLinks row. Each channel is its own full-width line
 * with a handle, divided by hairlines, so it fills the column and reads big.
 * Mastodon keeps rel="me" for profile verification.
 */
type Channel = { label: string; handle: string; href: string; me?: boolean; icon: string };

// Brand marks (GitHub/Mastodon/Bluesky from Simple Icons, CC0) plus a plain
// envelope for email, all normalised to a 24×24 box as a single filled path.
const icons = {
    email: "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.24-7.47 4.67a1 1 0 0 1-1.06 0L4 8.24V6.4l8 5 8-5v1.84Z",
    github: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
    mastodon: "M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.667-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z",
    bluesky: "M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z",
};

const channels: Channel[] = [
    {
        label: "Email",
        handle: "hey@iamrob.in",
        href: "mailto:hey@iamrob.in",
        icon: icons.email,
    },
    {
        label: "GitHub",
        handle: "@iam-robin",
        href: "https://github.com/iam-robin",
        icon: icons.github,
    },
    {
        label: "Mastodon",
        handle: "@iamrobin",
        href: "https://mastodon.social/@iamrobin",
        me: true,
        icon: icons.mastodon,
    },
    {
        label: "Bluesky",
        handle: "@iam-robin.bsky.social",
        href: "https://bsky.app/profile/iam-robin.bsky.social",
        icon: icons.bluesky,
    },
];

const isExternal = (href: string) => href.startsWith("http");

// Same feTurbulence + feDisplacementMap pair the bird logo uses. Both values
// are in user units, so they're rescaled for the 24-unit icon box to land on
// the bird's *rendered* wobble (~0.6px of displacement over a ~2.8px noise
// period at its ~27px logo size) — matching its numbers outright would shake
// a 22px icon apart.
const filterId = "contact-icon-turbulence";
---

<style>
    /* Perforated stamp edge: a grid of transparent dots punched out of a white
       frame, so the inner white square shows a scalloped border — the same
       trick the real postcard stamps use, scaled down to the ~22px glyph. */
    .pc-stamp {
        background: radial-gradient(
            transparent 0px,
            transparent 1.2px,
            white 1.2px,
            white
        );
        background-size: 4px 4px;
        background-position: -6px -6px;
    }
</style>

{/* Filter defined once and shared by every icon below — the noise rasterizes
    once instead of per instance. */}
<svg class="absolute h-0 w-0" aria-hidden="true">
    <filter
        id={filterId}
        x="-20%"
        y="-20%"
        width="140%"
        height="140%"
        filterUnits="objectBoundingBox"
    >
        <feTurbulence
            type="fractalNoise"
            baseFrequency="0.33"
            numOctaves="3"
            seed="81"
            result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="0.65"
        ></feDisplacementMap>
    </filter>
</svg>

<section>
    <h2 class="text-sm font-bold">Contact</h2>

    <ul class="mt-4 flex flex-col border-t border-ink/10">
        {/*
          Sending a postcard is just another way to reach me, so it sits as a
          plain channel row like the rest — only marked by a small geometric
          stamp (one fixed SVG, no client JS) before the label. Links to the
          composer; sent cards land on /postcards.
        */}
        <li class="border-b border-ink/10">
            <a
                href="/postcards/new"
                data-hero-panel="postcards"
                class="group flex items-baseline justify-between gap-4 py-5"
            >
                <span class="flex items-center gap-3 text-lg">
                    <span
                        class="pc-stamp inline-block h-[30px] w-[30px] shrink-0 self-center p-[2px] drop-shadow-[0_0.5px_1px_rgba(0,0,0,0.2)]"
                        aria-hidden="true"
                    >
                        <span class="block h-full w-full bg-white p-px">
                            <svg viewBox="0 0 100 100" class="block h-full w-full">
                                <polygon points="0,0 100,0 50,50" fill="#457B9D" />
                                <polygon points="100,0 100,100 50,50" fill="#1D3557" />
                                <polygon points="100,100 0,100 50,50" fill="#2A9D8F" />
                                <polygon points="0,100 0,0 50,50" fill="#A8DADC" />
                            </svg>
                        </span>
                    </span>
                    Send a postcard
                </span>
                <span class="font-mono text-sm opacity-50 transition-opacity group-hover:opacity-100">
                    leave a note
                </span>
            </a>
        </li>
        {
            channels.map((c) => (
                <li class="border-b border-ink/10">
                    <a
                        href={c.href}
                        class="group flex items-baseline justify-between gap-4 py-5"
                        {...(isExternal(c.href) && {
                            target: "_blank",
                            rel: c.me
                                ? "me noopener noreferrer"
                                : "noopener noreferrer",
                        })}
                    >
                        <span class="flex items-center gap-3 text-lg">
                            {/* Kept light so the icons read as quiet markers
                                next to the label, not as the loudest thing in
                                the row — the stamp above is the one mark that
                                gets to be full strength. The slot keeps the
                                stamp's width so every label starts on the same
                                x, whatever the icon inside measures. */}
                            <span
                                class="flex h-[30px] w-[30px] shrink-0 items-center justify-center self-center opacity-30"
                                aria-hidden="true"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    class="block h-[19px] w-[19px]"
                                    filter={`url(#${filterId})`}
                                >
                                    <path d={c.icon} fill="currentColor" />
                                </svg>
                            </span>
                            {c.label}
                        </span>
                        <span class="font-mono text-sm opacity-50 transition-opacity group-hover:opacity-100">
                            {c.handle}
                            {isExternal(c.href) && " ↗"}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</section>

---
/**
 * Contact block for the foot of the homepage's right column, built to the same
 * row shape as the project and blog teasers above it so the three lists read
 * as one column. Mastodon keeps rel="me" for profile verification.
 */
import InkMark from "./InkMark.astro";

type Channel = {
    label: string;
    handle: string;
    href: string;
    me?: boolean;
    icon: string;
};

// <InkMark> glyphs rather than brand logos — the latter were the only filled
// shapes on the page and read as borrowed assets.
const channels: Channel[] = [
    {
        label: "Email",
        handle: "hey@iamrob.in",
        href: "mailto:hey@iamrob.in",
        icon: "email",
    },
    {
        label: "GitHub",
        handle: "@iam-robin",
        href: "https://github.com/iam-robin",
        icon: "github",
    },
    {
        label: "Mastodon",
        handle: "@iamrobin",
        href: "https://mastodon.social/@iamrobin",
        me: true,
        icon: "mastodon",
    },
    {
        label: "Bluesky",
        handle: "@iam-robin.bsky.social",
        href: "https://bsky.app/profile/iamrob.in",
        icon: "bluesky",
    },
];

const isExternal = (href: string) => href.startsWith("http");

// The trailing glyph is about where the click lands, not the protocol: ↗ for
// anything that hands you off, → for a link that stays here. So mailto: gets
// the diagonal despite not opening a new tab.
const leavesSite = (href: string) =>
    isExternal(href) || href.startsWith("mailto:");
---

<style>
    /*
      The postcard row is the one invitation in a list of addresses, so it gets
      the marker highlight the hero uses on "design engineer" — the emphasis
      lives in the type, and the row's mark, size and spacing stay identical to
      its neighbours.

      isolation is load-bearing: .marker draws its swatch in a ::before at
      z-index -1, which on the homepage would fall behind the tinted content
      column and vanish. Isolating keeps it in the span's own stacking context,
      behind the text and above the column.
    */
    .pc-marker {
        isolation: isolate;
    }

    /* Same deepening the hero marker does on hover, minus the italic tilt —
       that one belongs to the headline. Paired with the row's title underline
       it would be two emphases on one line, so the underline is dropped for
       this row only. */
    .ink-row:hover .pc-marker {
        --marker-color: color-mix(
            in srgb,
            var(--color-ink) 10%,
            var(--color-surface)
        );
    }

    .ink-row:hover .pc-title {
        text-decoration: none;
    }
</style>

<section>
    <h2 class="text-sm font-bold">Contact</h2>

    <ul class="mt-4 flex flex-col border-t border-dotted border-ink/30">
        {
            /*
          Sending a postcard is just another way to reach me, so it sits as a
          plain channel row like the rest — same mark weight, same type, same
          spacing. Only the marker highlight sets it apart, because it's the one
          row that asks for something rather than listing an address. (It was a
          colour stamp illustration once: the only saturated thing on the page,
          and it read as a picture pasted into a column of quiet glyphs.) Links
          to the composer; sent cards land on /postcards.
        */
        }
        <li class="border-b border-dotted border-ink/30">
            <a
                href="/postcards/new"
                data-hero-panel="postcards"
                class="ink-row flex items-start gap-4 py-5 font-mono"
            >
                <span
                    class="ink-row-mark flex h-[1.625em] w-5 shrink-0 items-center justify-center text-base"
                    aria-hidden="true"
                >
                    <InkMark name="postcard" class="h-5 w-5" />
                </span>
                <span class="ink-row-title pc-title min-w-0 flex-1 text-base">
                    <span class="marker pc-marker">Send a postcard</span>
                </span>
                <span class="ink-row-meta shrink-0 text-sm">
                    leave a note →
                </span>
            </a>
        </li>
        {
            channels.map((c) => (
                <li class="border-b border-dotted border-ink/30">
                    <a
                        href={c.href}
                        class="ink-row flex items-start gap-4 py-5 font-mono"
                        {...(isExternal(c.href) && {
                            target: "_blank",
                            rel: c.me
                                ? "me noopener noreferrer"
                                : "noopener noreferrer",
                        })}
                    >
                        {/* Same 20px slot and same 0.4 base as the project and
                            blog rows — now that these are stroked glyphs in the
                            same hand, they carry the same amount of ink and no
                            longer need the lower base the filled logos did.

                            The slot is as tall as the label's line box — not
                            20px — so centring inside it puts the mark on the
                            label's optical centre. A 20px box under an ~1.625em
                            line sits a couple of pixels high, which is enough to
                            see once five of them stack up. */}
                        <span
                            class="ink-row-mark flex h-[1.625em] w-5 shrink-0 items-center justify-center text-base"
                            aria-hidden="true"
                        >
                            <InkMark name={c.icon} class="h-5 w-5" />
                        </span>
                        <span class="ink-row-title min-w-0 flex-1 text-base">
                            {c.label}
                        </span>
                        <span class="ink-row-meta shrink-0 text-sm">
                            {c.handle}
                            {leavesSite(c.href) && " ↗"}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</section>

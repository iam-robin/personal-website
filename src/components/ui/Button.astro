---
import type { HTMLAttributes } from "astro/types";

// Both elements' attributes, so the rest pass through type-checked.
type Props = Omit<HTMLAttributes<"a">, "type" | "href"> &
    Omit<HTMLAttributes<"button">, "type" | "href"> & {
        href?: string;
        /** Defaults to "button" so a stray button never submits. */
        type?: "button" | "submit";
        variant?: "primary" | "secondary" | "outline" | "ghost" | "plain";
        size?: "sm" | "md" | "lg";
        shape?: "pill" | "box";
        external?: boolean;
        disabled?: boolean;
        /**
         * Semantic only: toggles flip aria-pressed from JS, so style the pressed look
         * with an [aria-pressed="true"] rule.
         */
        pressed?: boolean;
        current?: boolean;
        /** Needs a label: there's no text for a screen reader. */
        iconOnly?: boolean;
        label?: string;
        class?: string;
    };

const {
    href,
    type = "button",
    variant = "secondary",
    size = "md",
    shape = "pill",
    external = false,
    disabled = false,
    pressed,
    current = false,
    iconOnly = false,
    label,
    class: className = "",
    ...rest
} = Astro.props;

// A 0.96 squeeze on press: the fill change alone is nearly invisible under a
// cursor.
const base =
    "inline-flex items-center justify-center gap-1.5 font-mono transition-[color,background-color,border-color,scale] duration-150 ease-out active:scale-96 motion-reduce:active:scale-100";

const sizes = {
    sm: iconOnly ? "p-1.5 text-sm" : "px-3 py-1 text-sm",
    md: iconOnly ? "p-2 text-sm" : "px-4 py-2 text-sm",
    lg: iconOnly ? "h-12 w-12 text-base" : "px-6 py-3 text-base",
};

const shapes = { pill: "rounded-full", box: "rounded-md" };

// Hover moves the fill, never opacity: fading an ink pill greys its label.
const variants = {
    primary: "bg-ink text-paper hover:bg-ink/85 active:bg-ink/70",
    secondary: "bg-ink/5 text-ink hover:bg-ink/10 active:bg-ink/20",
    outline:
        "border border-ink bg-paper hover:bg-ink hover:text-paper active:bg-ink/85",
    ghost: "hover:bg-ink/5 active:bg-ink/15",
    // No fill and no hover, for surfaces other than paper. The caller supplies
    // the interaction.
    plain: "",
};

const classes = [
    base,
    shapes[shape],
    sizes[size],
    variants[variant],
    disabled && "disabled:cursor-not-allowed disabled:opacity-55",
    className,
];

const Tag = href ? "a" : "button";
---

<Tag
    class:list={classes}
    aria-label={label}
    {...href
        ? {
              href,
              ...(current && { "aria-current": "page" }),
              ...(external && {
                  target: "_blank",
                  rel: "noopener noreferrer",
              }),
          }
        : {
              type,
              ...(disabled && { disabled: true }),
              ...(pressed !== undefined && { "aria-pressed": pressed }),
          }}
    {...rest}
>
    <slot />{external && " ↗"}
</Tag>

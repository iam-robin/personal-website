---
/**
 * A small hand-drawn glyph, wobbled by the shared #ink-wobble filter so it
 * reads as a sibling of the bird logo. Decorative — its container carries the
 * label. Requires <InkDefs />, which Layout.astro renders site-wide.
 */
interface Props {
    /** A key of `glyphs`. Unknown names fall back to the generic `project`
     *  window, so a new project has a mark before one is drawn for it. */
    name: keyof typeof glyphs | (string & {});
    class?: string;
}

// Shared by `oh-my` and `feel`, which never appear on the same page.
const eye = [
    "M3.4 12.2Q7.8 6.8 12.1 6.9Q16.5 7 20.6 12.1Q16.4 17.5 12 17.4Q7.6 17.2 3.4 12.2Z",
    "M12 9.7Q14.5 10 14.4 12.2Q14.2 14.5 12 14.5Q9.6 14.3 9.7 12.1Q9.9 9.8 12 9.7Z",
] as const;

// All glyphs live in a 24-unit box, to match the filter's calibration.
//
// The character has to be in the geometry, not the filter: at 20px the wobble
// only frays an edge by a fraction of a pixel. So every shape is built wrong on
// purpose — no edge straight or parallel, corners at differing heights — and no
// two may share a silhouette, since the outline is all you get at this size.
const glyphs = {
    post: [
        "M6.6 4.6Q11.5 3 17.8 4.2Q18.6 12.4 17 20.6Q11 21.4 5.8 19.8Q5.2 12 6.6 4.6Z",
        "M8.9 9Q12 8.3 15.4 8.9",
        "M8.7 12.6Q11.5 12 14.9 12.7",
        "M9 16.2Q10.8 15.8 12.9 16.1",
    ],
    // Fallback for projects without a drawing. Landscape, so it doesn't read
    // as the post glyph's portrait sheet at 20px.
    project: [
        "M4.1 6.5Q12 5.1 20.1 6.7Q20.9 12.2 19.7 18.3Q12 19.6 3.9 18Q3.3 12.1 4.1 6.5Z",
        "M4.4 10.2Q12 9.4 19.9 10.4",
    ],

    // Per-project drawings, keyed by content slug.
    "robins-photos": [
        "M3.7 8.3Q8 7.7 8.6 7.6Q9.4 5.6 10.2 5.2Q12 4.9 14 5.3Q14.8 5.9 15.5 7.6Q18.6 7.9 20.3 8.5Q21.1 13 20.1 18.4Q12 19.7 3.8 18.1Q3.1 13.1 3.7 8.3Z",
        "M12.1 9.6Q15.3 10 15.4 13.1Q15.1 16.2 12 16.4Q8.9 16.1 8.7 13.1Q8.9 9.9 12.1 9.6Z",
    ],
    // Football. The seams stop short of the rim — run them all the way out
    // and the mark collapses into a spoked wheel.
    matchprint: [
        "M12 3.6Q20.5 4 20.6 12.1Q20.2 20.3 12 20.5Q3.8 20.1 3.5 12Q3.9 4 12 3.6Z",
        "M11.9 6.5L17.2 10.4L15.1 16.5L8.9 16.3L6.8 10.4Z",
        "M11.9 6.5L12 4.5",
        "M17.2 10.4L19.1 9.6",
        "M15.1 16.5L16.5 18.1",
        "M8.9 16.3L7.5 18",
        "M6.8 10.4L4.9 9.8",
    ],
    geeenerated: [
        "M14.9 12.1Q14.8 15.1 12 15.1Q9 15 9 11.8Q9.1 8.2 12.4 8.2Q16.7 8.3 16.8 12.4Q16.7 17.7 11.6 17.8Q5.5 17.6 5.4 11.6Q5.6 5.3 12.2 5.3",
    ],
    lumon: [
        "M3.8 5.4Q12 4.3 20.2 5.6Q21 10.5 19.9 15.7Q12 16.9 3.9 15.4Q3.2 10.4 3.8 5.4Z",
        "M12 17L11.9 19.3",
        "M8.5 19.7Q12 19.1 15.5 19.6",
    ],
    "meaningful-animations": [
        "M16.4 8.6Q19.7 9 19.8 12.1Q19.4 15.4 16.3 15.5Q13.1 15.1 13 12.1Q13.3 8.8 16.4 8.6Z",
        "M10.4 9.7Q7.5 9.4 4.5 9.9",
        "M9.5 12.2Q6.3 11.9 3.5 12.4",
        "M10.4 14.7Q7.7 14.3 4.9 14.8",
    ],
    "media-camp": [
        "M12 4.2L20.3 19.1Q12 20.3 3.7 18.9Z",
        "M12 10.3L8.8 19.6",
        "M12 10.3L15.3 19.5",
    ],
    // Bars must ascend: uneven heights read as random ticks, a climb as a chart.
    "notion-budget": [
        "M3.7 19.5Q12 20.3 20.3 19.3",
        "M7.4 19.4Q7.1 17.4 7.5 15.3",
        "M12 19.6Q11.7 15.6 12.1 11.8",
        "M16.6 19.4Q16.3 13.9 16.7 8.1",
    ],
    "oh-my": eye,
    procrastisaurus: [
        "M6.5 4.4Q12 3.7 17.5 4.5L12 12L17.4 19.6Q12 20.3 6.6 19.4L12 12Z",
    ],
    // Leaves run wide rather than tight to the stem, or it thins out to an
    // illegible squiggle at 20px.
    "time-garden": [
        "M12 20.3Q11.6 16 11.9 11.3",
        "M12 14.4Q12.2 8.8 17.7 7.7Q18.3 13.5 12 14.4Z",
        "M11.9 18Q11.1 13.3 6.3 12.6Q5.9 17.5 11.9 18Z",
    ],

    // The four facets on /work. Familiar signs rather than the invented
    // objects the project marks use — these have to survive being scanned.
    build: [
        "M9.3 7.6Q6.6 9.9 4.2 12.1Q6.7 14.3 9.1 16.5",
        "M14.8 7.7Q17.4 9.9 19.8 12Q17.3 14.3 14.9 16.4",
        "M13.5 6.4Q12 12.1 10.6 17.7",
    ],
    feel: eye,
    // A heart leans on the "Longevity" heading to redirect "favourite" toward
    // care-over-time; the hourglass and plant were already taken.
    longevity: [
        "M12 19.2Q5.2 14.6 4.1 10.4Q3.3 6.2 7.4 5.4Q10.5 5 12 8.2Q13.6 5.1 16.7 5.5Q20.7 6.4 19.8 10.5Q18.6 14.7 12 19.2Z",
    ],
    // Speech bubble, tail bottom-left — kept empty so it stays distinct from
    // mastodon, whose tail hooks the other way.
    "both-languages": [
        "M12 5.2Q19.6 5.4 20.3 10.2Q20.6 15 12.2 15.4Q10.4 15.4 8.8 15.1L5.2 18.6Q6.2 16.3 6.1 14.6Q3.5 13 3.6 10.1Q4.1 5.5 12 5.2Z",
    ],

    // Destination arrows: diagonal leaves the site, straight stays here. Same
    // shaft length and head size, so only the angle separates the pair.
    "arrow-external": [
        "M5.2 18.9Q11.9 12.4 18.7 5.3",
        "M11.8 5Q15.4 4.6 18.8 5.2",
        "M18.8 5.2Q19.3 8.6 18.9 12.2",
    ],
    "arrow-internal": [
        "M4.3 12.4Q11.6 11.7 19.2 12",
        "M14.9 7.6Q17.2 9.8 19.3 12",
        "M19.3 12Q17.1 14.2 14.7 16.1",
    ],

    // Contact channels. The brand marks are traced by hand rather than reused
    // from Simple Icons — a precise official path next to these reads as a
    // pasted-in asset. Each is reduced to the silhouette that survives 20px.
    email: [
        "M3.5 6.3Q12 5.2 20.6 6.5Q21.2 12.1 20.1 17.7Q12 18.9 3.7 17.5Q3.1 11.9 3.5 6.3Z",
        "M4 6.9Q8.2 10.4 12.1 12.9Q16.2 10.1 20.2 7.1",
    ],
    // Shares the envelope's rectangle; the stamp corner and ruled lines are
    // what tell the two apart.
    postcard: [
        "M3.5 6.2Q12 5.1 20.5 6.4Q21.1 12.1 20.1 17.8Q12 19 3.7 17.6Q3.1 11.9 3.5 6.2Z",
        "M15.6 8.6Q17.9 8.2 19.2 8.7Q19.5 10.3 19.1 12Q17.4 12.3 15.4 11.9Q15.2 10.2 15.6 8.6Z",
        "M5.6 9.6Q9 9 12.8 9.7",
        "M5.4 12.6Q8.6 12.1 11.9 12.7",
        "M5.7 15.5Q7.9 15.2 10.3 15.5",
    ],
    // The Octocat as head and tail. Both feet of each ear must land *on* the
    // head outline — the one thing the wobble can't cover for, since a free
    // endpoint reads as a rendering fault rather than a loose hand.
    github: [
        "M12 6.2Q18.5 6.6 18.7 12Q18.3 17.6 11.9 17.9Q5.5 17.5 5.3 11.9Q5.6 6.5 12 6.2Z",
        "M8.2 7.2L6.8 4.1L10.8 6.3",
        "M15.5 7.1L17.4 4.2L13.2 6.3",
        "M10.1 17.7Q8.9 20.2 6.5 20.2Q4.8 19.9 5.2 18.4",
    ],
    // The m in its shield. Both humps run nearly its full height — smaller and
    // the letter closes into a blot at 20px.
    mastodon: [
        "M12 3.6Q20.4 4.1 20.8 10.2Q21 16.1 15.5 16.8Q12.2 17.2 8.3 16.9Q8.9 19.4 12.4 19.8Q15.1 20 17.5 19.3",
        "M12 3.6Q3.6 4.1 3.2 10.2Q3 15.6 8.3 16.9",
        "M7.6 14.2Q7.1 10.2 7.9 8.2Q9.6 6.3 11.1 8.4Q11.9 9.8 12 13.7",
        "M12 13.6Q11.7 9.7 12.9 8.3Q14.5 6.4 16 8.5Q16.8 10.2 16.9 14.1",
    ],
    bluesky: [
        "M12 10.6Q9.5 6 5.9 4.5Q3.3 3.5 3.1 6.2Q2.9 10 5.2 11.7Q6.7 12.8 8.8 13Q5.7 14.1 6.5 16.7Q7.7 20 9.7 19.4Q11.4 18.6 12 14.7Q12.9 18.7 14.6 19.5Q16.6 20.1 17.8 16.8Q18.6 14.2 15.4 13Q17.5 12.8 19 11.6Q21.2 9.8 21 6Q20.7 3.5 18.2 4.6Q14.6 6.2 12 10.6Z",
    ],
} as const;

const { name, class: className } = Astro.props;
const paths: readonly string[] =
    glyphs[name as keyof typeof glyphs] ?? glyphs.project;
---

<svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter="url(#ink-wobble)"
    aria-hidden="true"
    class:list={["ink-mark", className]}
>
    {paths.map((d) => <path d={d} />)}
</svg>

<style>
    .ink-mark {
        display: block;
    }
</style>

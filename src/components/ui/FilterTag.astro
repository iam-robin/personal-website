---
/**
 * Active tags are solid ink: two tints of ink are too close to read. Inactive
 * tags mute the text, not the element, so slotted dots and flags keep colour.
 */
interface Props {
    href: string;
    active?: boolean;
    count?: number;
}

const { href, active = false, count } = Astro.props;

const base =
    "inline-flex items-center gap-1.5 rounded-full py-1 font-mono text-sm transition-colors";
// The knockout slot has its own padding, so the active chip pulls its right
// padding in.
const state = active
    ? `bg-ink text-paper active:bg-ink/85 ${count !== undefined ? "pr-1.5 pl-3" : "px-3"}`
    : "bg-ink/5 px-3 text-ink-muted hover:bg-ink/10 hover:text-ink focus-visible:text-ink active:bg-ink/20";
---

<a href={href} class:list={[base, state]}>
    <slot />
    {
        count !== undefined && (
            <span
                class:list={[
                    active ? "rounded-full bg-paper/20 px-1.5 py-px" : "text-ink-muted",
                ]}
            >
                {count}
            </span>
        )
    }
</a>

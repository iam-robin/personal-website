---
import Button from "./Button.astro";
/**
 * RSS feed dropdown: an icon that opens a flyout listing the site's feeds,
 * each with copy-URL and open-feed actions. Ported from v3.
 */
import { Icon } from "astro-icon/components";

const rssFeeds = [
    { label: "Blog", url: "/blog-rss.xml" },
    { label: "Bookmarks", url: "/bookmarks-rss.xml" },
];
---

<details id="rss-dropdown" class="relative">
    <summary
        class="cursor-pointer list-none p-2 text-ink-muted transition-colors hover:text-ink"
        aria-label="RSS Feeds"
        title="Subscribe to RSS"
    >
        <Icon name="ph:rss-simple-bold" size={18} />
    </summary>

    <div
        class="absolute right-0 z-50 mt-2 w-64 rounded-xl border border-ink/15 bg-surface p-2 shadow-lg"
    >
        <div class="mb-1 border-b border-dotted border-ink/30 px-3 py-2">
            <h3 class="font-mono text-xs tracking-wide text-ink-muted uppercase">
                RSS Feeds
            </h3>
        </div>
        {
            rssFeeds.map((feed) => (
                <div class="flex items-center gap-2 rounded px-3 py-2 transition-colors hover:bg-ink/5">
                    <Icon
                        name="ph:rss-simple-bold"
                        size={16}
                        class="shrink-0 opacity-55"
                    />
                    <span class="flex-1 text-sm">{feed.label}</span>
                    <Button
                        iconOnly
                        size="sm"
                        variant="plain"
                        shape="box"
                        class="rss-copy-btn hover:bg-paper active:bg-paper/70"
                        data-url={feed.url}
                        title="Copy feed URL"
                        label={`Copy ${feed.label} RSS feed URL`}
                    >
                        <span class="icon-swap">
                            <Icon
                                name="ph:copy-bold"
                                size={14}
                                class="copy-icon"
                            />
                            <Icon
                                name="ph:check-bold"
                                size={14}
                                class="check-icon"
                            />
                        </span>
                    </Button>
                    <Button
                        href={feed.url}
                        iconOnly
                        size="sm"
                        variant="plain"
                        shape="box"
                        class="hover:bg-paper active:bg-paper/70"
                        title="Open feed"
                        label={`Open ${feed.label} RSS feed`}
                    >
                        <Icon name="ph:arrow-square-out-bold" size={14} />
                    </Button>
                </div>
            ))
        }
    </div>
</details>

<style>
    summary::marker,
    summary::-webkit-details-marker {
        display: none;
    }

    /*
      Copy -> check confirmation. This swap is the only signal the clipboard
      write landed, so it cross-fades rather than cutting: both icons stay in
      the DOM, stacked, and trade opacity/scale/blur. `display` can't
      transition, which is why the old .hidden toggle had no motion at either
      end. The state class sits on this span rather than the <Button> so the
      rule never depends on scoping reaching another component's root.

      No green: the check inherits currentColor like every other icon here,
      and the palette in theme/colors.css is ink, paper and surface only.
    */
    .icon-swap {
        position: relative;
        display: inline-flex;
        width: 14px;
        height: 14px;
    }

    .icon-swap :global(svg) {
        position: absolute;
        inset: 0;
        transition-property: opacity, scale, filter;
        transition-duration: 300ms;
        transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }

    .icon-swap :global(.copy-icon),
    .icon-swap.is-copied :global(.check-icon) {
        opacity: 1;
        scale: 1;
        filter: blur(0);
    }

    .icon-swap :global(.check-icon),
    .icon-swap.is-copied :global(.copy-icon) {
        opacity: 0;
        scale: 0.25;
        filter: blur(4px);
    }

    @media (prefers-reduced-motion: reduce) {
        .icon-swap :global(svg) {
            transition-property: opacity;
            scale: 1;
            filter: none;
        }
    }
</style>

<script>
    function initRssDropdown() {
        const dropdown = document.getElementById(
            "rss-dropdown",
        ) as HTMLDetailsElement | null;
        if (!dropdown || dropdown.dataset.initialized) return;
        dropdown.dataset.initialized = "true";

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (!dropdown.contains(e.target as Node)) dropdown.open = false;
        });

        // Copy feed URL to clipboard
        dropdown.querySelectorAll(".rss-copy-btn").forEach((button) => {
            const swap = button.querySelector(".icon-swap");
            // Per button: a second click while the check is still showing has
            // to restart the two seconds, not inherit the first click's
            // deadline and reset early.
            let resetTimer: ReturnType<typeof setTimeout>;

            button.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();

                const url = button.getAttribute("data-url");
                if (!url) return;

                try {
                    await navigator.clipboard.writeText(
                        `${window.location.origin}${url}`,
                    );
                    swap?.classList.add("is-copied");
                    clearTimeout(resetTimer);
                    resetTimer = setTimeout(
                        () => swap?.classList.remove("is-copied"),
                        2000,
                    );
                } catch (err) {
                    console.error("Failed to copy:", err);
                }
            });
        });
    }

    initRssDropdown();
    document.addEventListener("astro:page-load", initRssDropdown);
</script>

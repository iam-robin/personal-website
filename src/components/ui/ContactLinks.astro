---
/**
 * Contact / social links. Used at the bottom of the hero and every
 * subpage. Mastodon gets rel="me" so profile verification works.
 */
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

const items: { label: string; href: string; me?: boolean }[] = [
    { label: "Email", href: "mailto:hey@iamrob.in" },
    { label: "GitHub", href: "https://github.com/iam-robin" },
    { label: "Mastodon", href: "https://mastodon.social/@iamrobin", me: true },
    { label: "Bluesky", href: "https://bsky.app/profile/iam-robin.bsky.social" },
];
---

<footer class={`flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm ${className}`}>
    {
        items.map((item) => (
            <a
                href={item.href}
                class="opacity-60 underline-offset-4 hover:underline hover:opacity-100"
                {...(item.href.startsWith("http") && {
                    target: "_blank",
                    rel: item.me ? "me noopener noreferrer" : "noopener noreferrer",
                })}
            >
                {item.label}
            </a>
        ))
    }
</footer>

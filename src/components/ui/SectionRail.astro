---
/**
 * `rail`: the wide-screen sidebar. `inline`: the narrow fallback, a <details>.
 * Unresolvable ids are ignored.
 */
export interface RailSection {
    id: string;
    text: string;
    nested?: boolean;
}

interface Props {
    sections: RailSection[];
    label?: string;
    variant?: "inline" | "rail";
    class?: string;
}

const {
    sections,
    label = "Contents",
    variant = "inline",
    class: className = "",
} = Astro.props;

const show = sections.length >= 2;
---

{
    show &&
        (variant === "rail" ? (
            <nav aria-label={label} data-rail-root class={className}>
                <p class="font-mono text-xs tracking-wide text-ink-muted">
                    {label}
                </p>
                <ul class="mt-4 flex flex-col gap-2 font-sans text-sm">
                    {sections.map((section) => (
                        <li class:list={[section.nested && "pl-3"]}>
                            <a
                                href={`#${section.id}`}
                                data-rail-link
                                class="rail-link block leading-snug underline-offset-4 hover:underline"
                            >
                                {section.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        ) : (
            <details
                data-rail-root
                class={`rail-details group text-sm ${className}`}
            >
                <summary
                    aria-label={label}
                    class="inline-flex cursor-pointer items-center gap-2 py-2 font-mono text-ink-muted transition-colors hover:text-ink"
                >
                    <span aria-hidden="true" class="caret inline-block">
                        ›
                    </span>
                    {label} ({sections.length})
                </summary>
                <ul class="mt-2 flex flex-col gap-1.5 font-sans">
                    {sections.map((section) => (
                        <li class:list={[section.nested && "pl-5"]}>
                            <a
                                href={`#${section.id}`}
                                data-rail-link
                                class="rail-link underline-offset-4 hover:underline"
                            >
                                {section.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        ))
}

<style>
    .rail-details > summary {
        list-style: none;
    }
    .rail-details > summary::-webkit-details-marker {
        display: none;
    }

    .caret {
        transition: transform 150ms ease;
    }
    .rail-details[open] > summary .caret {
        transform: rotate(90deg);
    }

    /* Full strength before the first heading, or it would look disabled. */
    .rail-link {
        position: relative;
        color: var(--color-ink);
        /* Apercu bold is a wider file and would re-wrap the entry. A stroke keeps the
           advance widths; it sits on every link, transparent until active. */
        -webkit-text-stroke-width: 0.4px;
        -webkit-text-stroke-color: transparent;
        paint-order: stroke fill;
        transition:
            color 200ms var(--ease-out, ease-out),
            -webkit-text-stroke-color 200ms var(--ease-out, ease-out);
    }

    /* Colour, not opacity: links need 4.5:1. */
    [data-rail-reading] .rail-link {
        color: var(--color-ink-muted);
    }
    [data-rail-reading] .rail-link:hover,
    [data-rail-reading] .rail-link[aria-current] {
        color: var(--color-ink);
    }

    /* Weight, not just colour: ink/70 vs ink is too small a gap to say "you are
       here". */
    .rail-link[aria-current] {
        -webkit-text-stroke-color: currentColor;
    }
    .rail-link[aria-current]::before {
        content: "";
        position: absolute;
        left: -0.85rem;
        top: 0.6em;
        width: 0.5rem;
        height: 1px;
        background-color: var(--color-ink);
    }

    @media (prefers-reduced-motion: reduce) {
        .caret,
        .rail-link {
            transition: none;
        }
    }
</style>

<script>
    // Marks the section being read: one passive listener, one rAF per frame.
    const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]"),
    );
    const roots = Array.from(document.querySelectorAll("[data-rail-root]"));

    if (links.length > 0) {
        // Both variants render, so several links can point at one heading.
        const pairs = links
            .map((link) => ({
                link,
                heading: document.getElementById(
                    decodeURIComponent(link.hash.slice(1)),
                ),
            }))
            .filter(
                (p): p is { link: HTMLAnchorElement; heading: HTMLElement } =>
                    p.heading !== null,
            );

        const headings = [...new Set(pairs.map((p) => p.heading))];

        // Reached once a heading passes roughly where the eye sits.
        const OFFSET = 120;

        let current: HTMLElement | null = null;
        let queued = false;

        const update = () => {
            queued = false;

            let active: HTMLElement | null = null;
            for (const heading of headings) {
                if (heading.getBoundingClientRect().top > OFFSET) break;
                active = heading;
            }

            if (active === current) return;
            current = active;

            for (const { link, heading } of pairs) {
                if (heading === active) {
                    link.setAttribute("aria-current", "location");
                } else {
                    link.removeAttribute("aria-current");
                }
            }

            // Above the first heading nothing is marked: the intro isn't a section.
            for (const root of roots) {
                if (active) {
                    root.setAttribute("data-rail-reading", "");
                } else {
                    root.removeAttribute("data-rail-reading");
                }
            }
        };

        const schedule = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
        };

        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule, { passive: true });
        update();
    }
</script>

---
/**
 * Mobile navigation: a fixed "Menu" pill at the bottom of the viewport
 * that expands into a panel of links — the concept from v3, restyled for
 * v4. Shown below md, where the inline <Nav> is hidden. Also renders a
 * spacer in the page flow so the floating pill never covers the last
 * content on the page.
 */
import { Icon } from "astro-icon/components";
import { navItems } from "../../data/navigation";

const items = [{ label: "Home", href: "/" }, ...navItems];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
    href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<div class="h-24 md:hidden" aria-hidden="true"></div>

<nav class="fixed inset-x-6 bottom-6 z-50 md:hidden" aria-label="Site menu">
    <details id="mobile-menu">
        <summary
            class="flex h-12 cursor-pointer list-none items-center justify-center gap-2 rounded-xl bg-ink font-mono text-sm text-paper shadow-lg"
        >
            <span class="icon-swap">
                <Icon name="ph:list-bold" size={16} class="menu-icon" />
                <Icon name="ph:x-bold" size={16} class="close-icon" />
            </span>
            Menu
        </summary>

        <ul
            class="absolute inset-x-0 bottom-14 flex flex-col rounded-xl bg-ink p-2 font-mono text-sm text-paper shadow-lg"
        >
            {
                items.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                                "block rounded px-4 py-3 underline-offset-4 transition-colors hover:bg-paper/10",
                                isActive(item.href)
                                    ? "underline"
                                    : "opacity-60",
                            ]}
                            aria-current={
                                isActive(item.href) ? "page" : undefined
                            }
                            {...(item.external && {
                                target: "_blank",
                                rel: "noopener noreferrer",
                            })}
                        >
                            {item.label}
                            {item.external && " ↗"}
                        </a>
                    </li>
                ))
            }
        </ul>
    </details>
</nav>

<style>
    summary::marker,
    summary::-webkit-details-marker {
        display: none;
    }

    /* The one ink-filled surface with focusable children, where global.css's
       ink ring would disappear. Set at rest, like the global one, so the ring
       never has a colour to transition. The summary pill is excluded on
       purpose: it sits on the page, so its ink ring is correct. */
    ul :global(a) {
        outline-color: var(--color-paper);
    }

    /* List -> x. Both icons stay in the DOM, stacked, and trade
       opacity/scale/blur — `display` can't transition, so the old toggle cut
       between them with no motion at either end. Driven straight off
       [open], so the pill needs no JS to animate. */
    .icon-swap {
        position: relative;
        display: inline-flex;
        width: 16px;
        height: 16px;
    }

    .icon-swap :global(svg) {
        position: absolute;
        inset: 0;
        transition-property: opacity, scale, filter;
        transition-duration: 300ms;
        transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }

    .menu-icon,
    details[open] .close-icon {
        opacity: 1;
        scale: 1;
        filter: blur(0);
    }

    .close-icon,
    details[open] .menu-icon {
        opacity: 0;
        scale: 0.25;
        filter: blur(4px);
    }

    @media (prefers-reduced-motion: reduce) {
        .icon-swap :global(svg) {
            transition-property: opacity;
            scale: 1;
            filter: none;
        }
    }
</style>

<script>
    function initMobileMenu() {
        const menu = document.getElementById(
            "mobile-menu",
        ) as HTMLDetailsElement | null;
        if (!menu || menu.dataset.initialized) return;
        menu.dataset.initialized = "true";

        // Close when clicking outside or pressing Escape
        document.addEventListener("click", (e) => {
            if (menu.open && !menu.contains(e.target as Node))
                menu.open = false;
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") menu.open = false;
        });
    }

    initMobileMenu();
    document.addEventListener("astro:page-load", initMobileMenu);
</script>

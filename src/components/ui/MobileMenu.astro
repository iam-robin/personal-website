---
/**
 * Mobile navigation: a fixed "Menu" pill at the bottom of the viewport
 * that expands into a panel of links — the concept from v3, restyled for
 * v4. Shown below md, where the inline <Nav> is hidden. Also renders a
 * spacer in the page flow so the floating pill never covers the last
 * content on the page.
 */
import { Icon } from "astro-icon/components";
import { navItems } from "../../data/navigation";

const items = [{ label: "Home", href: "/" }, ...navItems];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
    href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<div class="h-24 md:hidden" aria-hidden="true"></div>

<nav class="fixed inset-x-6 bottom-6 z-50 md:hidden" aria-label="Site menu">
        <button
            type="button"
            popovertarget="mobile-menu"
            class="flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-ink font-mono text-sm text-paper shadow-[var(--shadow-floating)]"
        >
            <span class="icon-swap relative inline-flex size-4">
                <Icon name="ph:list-bold" size={16} class="menu-icon" />
                <Icon name="ph:x-bold" size={16} class="close-icon" />
            </span>
            Menu
        </button>

        <div
            id="mobile-menu"
            popover="auto"
            class="fixed inset-x-6 top-auto bottom-20 m-0 max-h-[calc(100dvh-7rem)] w-auto overflow-y-auto overscroll-contain rounded-xl border-0 bg-ink p-2 font-mono text-sm text-paper shadow-[var(--shadow-floating)] md:hidden"
        >
        <ul class="flex flex-col"
        >
            {
                items.map((item) => (
                    <li>
                        {!item.children && <a
                            href={item.href}
                            class:list={[
                                "block rounded px-4 py-3 outline-paper! underline-offset-4 transition-colors hover:bg-paper/10",
                                isActive(item.href)
                                    ? "underline"
                                    : "opacity-60",
                            ]}
                            aria-current={
                                path === item.href ? "page" : undefined
                            }
                            {...(item.external && {
                                target: "_blank",
                                rel: "noopener noreferrer",
                            })}
                        >
                            {item.label}
                            {item.external && " ↗"}
                        </a>}
                        {item.children && (
                            <>
                            <span class="block px-4 pt-3 pb-1 text-xs text-paper/60">{item.label}</span>
                            <ul class="mb-2 ml-4 border-l border-paper/20 pl-2">
                                {item.children.map((child) => (
                                    <li>
                                        <a
                                            href={child.href}
                                            class:list={[
                                                "block rounded px-4 py-3 outline-paper! underline-offset-4 hover:bg-paper/10",
                                                isActive(child.href) ? "underline" : "opacity-60",
                                            ]}
                                            aria-current={path === child.href ? "page" : undefined}
                                        >{child.label}</a>
                                    </li>
                                ))}
                            </ul>
                            </>
                        )}
                    </li>
                ))
            }
        </ul>
        </div>
</nav>

<style>
    /* List -> x. Both icons stay in the DOM, stacked, and trade
       opacity/scale/blur — `display` can't transition, so the old toggle cut
       between them with no motion at either end. Driven straight off
       :popover-open, so the pill needs no JS to animate. */
    .icon-swap :global(svg) {
        position: absolute;
        inset: 0;
        transition-property: opacity, scale, filter;
        transition-duration: 300ms;
        transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }

    .menu-icon,
    nav:has(:popover-open) .close-icon {
        opacity: 1;
        scale: 1;
        filter: blur(0);
    }

    .close-icon,
    nav:has(:popover-open) .menu-icon {
        opacity: 0;
        scale: 0.25;
        filter: blur(4px);
    }

    @media (prefers-reduced-motion: reduce) {
        .icon-swap :global(svg) {
            transition-property: opacity;
            scale: 1;
            filter: none;
        }
    }
</style>

---
/**
 * The shared wobble filter every <InkMark> references. An SVG filter has to
 * live in the DOM or the filtered graphic doesn't paint; defining it once
 * means the noise rasterizes once instead of per row.
 */

// Same pair as the bird logo, rescaled for a 24-unit box: both values are in
// user units, so the bird's own numbers (sized for 139 units) would shake an
// 18px glyph apart. seed and numOctaves are constant across every ink filter.
const filterId = "ink-wobble";
---

<svg class="absolute h-0 w-0" aria-hidden="true">
    <filter
        id={filterId}
        x="-20%"
        y="-20%"
        width="140%"
        height="140%"
        filterUnits="objectBoundingBox"
        color-interpolation-filters="sRGB"
    >
        <feTurbulence
            type="fractalNoise"
            baseFrequency="0.33"
            numOctaves="3"
            seed="81"
            result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="0.65"
        ></feDisplacementMap>
    </filter>
</svg>

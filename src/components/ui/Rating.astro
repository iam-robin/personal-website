---
interface Props {
    value: number;
    max?: number;
}

const { value, max = 5 } = Astro.props;
const clampedValue = Math.min(Math.max(value, 0), max);
const stars = "✱".repeat(max);
const fill = `${(clampedValue / max) * 100}%`;
---

<span
    class="rating"
    role="img"
    aria-label={`${value} out of ${max} stars`}
    title={`${value} out of ${max}`}
>
    <span class="rating-value" aria-hidden="true">({value})</span>
    <span class="rating-stars" aria-hidden="true">
        <span class="rating-empty">{stars}</span>
        <span class="rating-filled" style={`width: ${fill}`}>{stars}</span>
    </span>
</span>

<style>
    .rating {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--color-ink);
        line-height: 1;
        vertical-align: -0.08em;
    }

    .rating-stars {
        position: relative;
        display: inline-block;
        font-size: 1rem;
        white-space: nowrap;
        letter-spacing: 0.06em;
    }

    .rating-value {
        flex: 0 0 5ch;
        color: var(--color-ink-muted);
        font-size: var(--text-xs);
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

    .rating-empty {
        opacity: 0.12;
    }

    .rating-filled {
        position: absolute;
        inset: 0 auto 0 0;
        overflow: hidden;
        white-space: nowrap;
    }
</style>

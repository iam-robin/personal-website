---
import DOMPurify from "isomorphic-dompurify";
import { createSeededRandom } from "../../utils/seededRandom";

interface Props {
    author: string;
    body: string;
    date: Date;
    distorted?: boolean;
    hoverEffect?: boolean;
    marginBottom?: number;
    marginRight?: number;
    rotation?: number;
    penColor?: string;
    paperColor?: string;
    fontSizeFactor?: number;
    lineHeight?: number;
    authorLeftOffset?: number;
    authorTopOffset?: number;
    authorRotation?: number;
    dateLeftOffset?: number;
    dateTopOffset?: number;
    dateRotation?: number;
    bodyLeftOffset?: number;
    bodyTopOffset?: number;
    bodyRotation?: number;
    stampSvg?: string;
    country?: string | null;
    websiteUrl?: string | null;
    postOfficeStampTop?: number;
    postOfficeStampRight?: number;
    postOfficeStampRotation?: number;
    wavyStampTop?: number;
    wavyStampRight?: number;
    wavyStampRotation?: number;
}

const {
    author,
    body,
    date,
    distorted = true,
    hoverEffect = true,
    penColor = "#000000",
    paperColor = "#FAF9F6",
    stampSvg = "",
    country = null,
    websiteUrl = null,
    // A submitted postcard has its exact styling stored (see
    // postcards/new.astro); missing values are seeded below instead.
    marginBottom: marginBottomProp,
    marginRight: marginRightProp,
    rotation: rotationProp,
    fontSizeFactor: fontSizeFactorProp,
    lineHeight: lineHeightProp,
    authorLeftOffset: authorLeftOffsetProp,
    authorTopOffset: authorTopOffsetProp,
    authorRotation: authorRotationProp,
    dateLeftOffset: dateLeftOffsetProp,
    dateTopOffset: dateTopOffsetProp,
    dateRotation: dateRotationProp,
    bodyLeftOffset: bodyLeftOffsetProp,
    bodyTopOffset: bodyTopOffsetProp,
    bodyRotation: bodyRotationProp,
    postOfficeStampTop: postOfficeStampTopProp,
    postOfficeStampRight: postOfficeStampRightProp,
    postOfficeStampRotation: postOfficeStampRotationProp,
    wavyStampTop: wavyStampTopProp,
    wavyStampRight: wavyStampRightProp,
    wavyStampRotation: wavyStampRotationProp,
} = Astro.props;

// Seeded from the postcard's stable identity, so a style-less card renders
// identically on every rebuild. The ranges mirror those in new.astro, so
// seeded and stored postcards are indistinguishable.
const rand = createSeededRandom(`${author}|${date.getTime()}`);

const marginBottom = marginBottomProp ?? Math.floor(rand() * 8);
const marginRight = marginRightProp ?? Math.floor(rand() * 8);
const rotation = rotationProp ?? Math.floor(rand() * 4 - 2);
const fontSizeFactor = fontSizeFactorProp ?? 0.9 + rand() * 0.2;
const lineHeight = lineHeightProp ?? 1.1 + rand() * 0.4;
const authorLeftOffset = authorLeftOffsetProp ?? Math.floor(rand() * 10) - 5;
const authorTopOffset = authorTopOffsetProp ?? Math.floor(rand() * 6) - 3;
const authorRotation = authorRotationProp ?? Math.floor(rand() * 6) - 3;
const dateLeftOffset = dateLeftOffsetProp ?? Math.floor(rand() * 10) - 5;
const dateTopOffset = dateTopOffsetProp ?? Math.floor(rand() * 6) - 3;
const dateRotation = dateRotationProp ?? Math.floor(rand() * 6) - 3;
const bodyLeftOffset = bodyLeftOffsetProp ?? Math.floor(rand() * 8) - 4;
const bodyTopOffset = bodyTopOffsetProp ?? Math.floor(rand() * 8) - 4;
const bodyRotation = bodyRotationProp ?? Math.floor(rand() * 4) - 2;
const postOfficeStampTop =
    postOfficeStampTopProp ?? Math.floor(rand() * 93) - 12;
const postOfficeStampRight =
    postOfficeStampRightProp ?? Math.floor(rand() * 133) - 12;
const postOfficeStampRotation =
    postOfficeStampRotationProp ?? Math.floor(rand() * 31) - 15;
const wavyStampTop = wavyStampTopProp ?? Math.floor(rand() * 69) + 4;
const wavyStampRight = wavyStampRightProp ?? Math.floor(rand() * 97) - 24;
const wavyStampRotation = wavyStampRotationProp ?? Math.floor(rand() * 21) - 10;

const sanitizedStampSvg = DOMPurify.sanitize(stampSvg);

// Everything inside the card is sized off a cqw-based font anchor (see
// <style>), so lengths are in `em`. The values match the original pixel
// design at the 672px reference width.
const em = (px: number) => `${(px / 16).toFixed(3)}em`;

const fontSize = `${(fontSizeFactor * 1.2).toFixed(3)}em`; // 20% larger
const lineHeightValue = lineHeight.toFixed(2);

const bodyCharCount = body.length;
const bodyLineBreaks = body.split("\n").length - 1;

let bodyFontSizeFactor = fontSizeFactor;

if (bodyCharCount > 180) {
    bodyFontSizeFactor *= 0.95;
}

if (bodyLineBreaks > 2) {
    bodyFontSizeFactor *= 0.8;
}

if (bodyCharCount > 180 && bodyLineBreaks > 2) {
    bodyFontSizeFactor *= 0.9;
}

const bodyFontSize = `${(bodyFontSizeFactor * 1.2).toFixed(3)}em`; // 20% larger

const formattedDate = date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
});

// Placement jitter stays in px: it nudges the card in the grid, not the
// content, so it shouldn't scale with card width.
const transformStyles = distorted
    ? `transform: translateY(${marginBottom}px) translateX(${marginRight}px) rotate(${rotation}deg);`
    : `transform: rotate(${rotation}deg);`;

const shadowClass = rotation >= 0 ? "hide-after" : "hide-before";

const authorStyles = `transform: translateX(${em(authorLeftOffset)}) translateY(${em(authorTopOffset)}) rotate(${authorRotation}deg); font-size: ${fontSize}; color: ${penColor}; filter: url(#distort-xl);`;
const dateStyles = `transform: translateX(${em(dateLeftOffset)}) translateY(${em(dateTopOffset)}) rotate(${dateRotation}deg); font-size: ${fontSize}; color: ${penColor}; filter: url(#distort-xl);`;
const bodyStyles = `transform: translateX(${em(bodyLeftOffset)}) translateY(${em(bodyTopOffset)}) rotate(${bodyRotation}deg); font-size: ${bodyFontSize}; line-height: ${lineHeightValue}; color: ${penColor}; filter: url(#distort-xl); white-space: pre-wrap;`;

const stampCountryText = (country ? country : "WORLD WIDE WEB").toUpperCase();
const stampDateDay = date.toLocaleDateString("en-GB", { day: "2-digit" });
const stampDateMonth = date
    .toLocaleDateString("en-GB", { month: "short" })
    .toUpperCase();
const stampDateYear = date.toLocaleDateString("en-GB", { year: "numeric" });
const uniqueStampPathId = `stampPath-${author.replace(/\W/g, "")}${date.getTime()}`;

const postOfficeStampContainerStyles = `
    position: absolute;
    top: ${em(postOfficeStampTop)};
    right: ${em(postOfficeStampRight)};
    transform: rotate(${postOfficeStampRotation}deg);
    z-index: 10;
    opacity: 0.4;
    filter: url(#distort-xl);
`;

const wavyLinesStampContainerStyles = `
    position: absolute;
    top: ${em(wavyStampTop)};
    right: ${em(wavyStampRight)};
    transform: rotate(${wavyStampRotation}deg);
    z-index: 9;
    opacity: 0.4;
    filter: url(#distort-xl);
`;
---

<div
    class={`pc-card corner-shadow-effect w-full max-w-2xl sm:aspect-3/2 ${hoverEffect ? "hover-lift" : ""} ${shadowClass}`}
    style={transformStyles}
>
    <div
        class="pc-inner flex flex-col sm:flex-row justify-between h-full w-full border border-black/10"
        style={`background-color: ${paperColor};`}
    >
        <div
            class="relative w-full sm:w-1/2 max-h-[330px] sm:max-h-none p-[1.5em] px-[1em] sm:px-[2em] font-decorative overflow-hidden"
        >
            <span class="block sm:absolute" style={bodyStyles}>{body}</span>
        </div>
        <div class="hidden sm:block w-px h-3/4 self-center bg-black/20"></div>
        <div
            class="relative flex flex-col justify-between w-full sm:w-1/2 sm:overflow-hidden p-[1.5em] px-[2em]"
        >
            <div class="h-1/2 flex justify-end">
                <div
                    class="pc-stamp inline-block w-[4.125em] h-[4.125em] p-[0.1875em] bg-white relative drop-shadow-[0_0_1px_rgba(0,0,0,0.3)]"
                    style="background: radial-gradient(transparent 0px, transparent 0.125em, white 0.125em, white); background-size: 0.375em 0.375em; background-position: -0.5625em -0.5625em;"
                >
                    <div class="h-full w-full p-[0.125em] bg-white">
                        {
                            stampSvg ? (
                                <div
                                    class="h-full w-full flex items-center justify-center"
                                    set:html={sanitizedStampSvg}
                                />
                            ) : (
                                <div class="h-full w-full" />
                            )
                        }
                    </div>
                </div>
            </div>

            <div style={postOfficeStampContainerStyles}>
                <svg
                    style="width: 4.5em; height: 4.5em;"
                    viewBox="0 0 100 100"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <defs>
                        <path
                            id={uniqueStampPathId}
                            d="M 12,58 A 38,38 0 1 1 88,58"
                            fill="none"></path>
                    </defs>

                    <circle
                        cx="50"
                        cy="50"
                        r="47"
                        stroke="#4A4A4A"
                        stroke-width="2.5"
                        fill="none"></circle>
                    <circle
                        cx="50"
                        cy="50"
                        r="42"
                        stroke="#6C6C6C"
                        stroke-width="1.5"
                        fill="none"></circle>

                    <text
                        font-family="'Helvetica Neue', Arial, sans-serif"
                        font-size="10"
                        letter-spacing="0.5"
                        fill="#333333"
                        font-weight="600"
                    >
                        <textPath
                            href={`#${uniqueStampPathId}`}
                            startOffset="50%"
                            text-anchor="middle"
                        >
                            {stampCountryText}
                        </textPath>
                    </text>

                    <text
                        x="50"
                        y="45"
                        font-family="'Courier New', Courier, monospace"
                        font-weight="bold"
                        font-size="12"
                        text-anchor="middle"
                        fill="#333333"
                    >
                        {stampDateDay}
                    </text>
                    <text
                        x="50"
                        y="58"
                        font-family="'Courier New', Courier, monospace"
                        font-weight="bold"
                        font-size="12"
                        text-anchor="middle"
                        fill="#333333"
                    >
                        {stampDateMonth}
                    </text>
                    <text
                        x="50"
                        y="71"
                        font-family="'Courier New', Courier, monospace"
                        font-weight="bold"
                        font-size="12"
                        text-anchor="middle"
                        fill="#333333"
                    >
                        {stampDateYear}
                    </text>
                </svg>
            </div>

            <div style={wavyLinesStampContainerStyles}>
                <svg
                    style="width: 5em; height: 2.5em;"
                    viewBox="0 0 50 40"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <g
                        stroke="#333333"
                        stroke-width="1.8"
                        fill="none"
                        stroke-linecap="round"
                    >
                        <path d="M 2 6 Q 10 2, 18 6 T 34 6 T 50 6"></path>
                        <path d="M 2 12 Q 10 8, 18 12 T 34 12 T 50 12"></path>
                        <path d="M 2 18 Q 10 14, 18 18 T 34 18 T 50 18"></path>
                        <path d="M 2 24 Q 10 20, 18 24 T 34 24 T 50 24"></path>
                        <path d="M 2 30 Q 10 26, 18 30 T 34 30 T 50 30"></path>
                    </g>
                </svg>
            </div>

            <div class="h-1/2 flex items-end">
                <ul class="w-full flex flex-col gap-[0.75em]">
                    <li class="flex flex-col gap-[0.25em]">
                        <span
                            class="font-mono text-[0.75em] -mb-[0.0625em] text-black/60"
                            >From:</span
                        >
                        <div
                            class="font-decorative h-[2em] border-b border-dotted border-black/60"
                        >
                            {
                                websiteUrl ? (
                                    <a
                                        href={websiteUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="absolute hover:underline"
                                        style={authorStyles}
                                    >
                                        {author} ↗
                                    </a>
                                ) : (
                                    <span class="absolute" style={authorStyles}>
                                        {author}
                                    </span>
                                )
                            }
                        </div>
                    </li>
                    <li class="flex flex-col gap-[0.25em]">
                        <span
                            class="font-mono text-[0.75em] -mb-[0.0625em] text-black/60"
                            >Date:</span
                        >
                        <div
                            class="font-decorative h-[2em] border-b border-dotted border-black/60"
                        >
                            <span class="absolute" style={dateStyles}
                                >{formattedDate}</span
                            >
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    /* The card is a query container; the content font-size is anchored to the
       card's own width (cqw), so every inner `em` length scales with the card
       instead of the viewport. 3.13cqw == ~21px at the 672px design width
       (~30% larger than the original 16px); capped so it never grows past
       that reference size. Mobile (< sm) keeps the stacked layout, scaled to
       match. Bump both numbers together to resize the content further. */
    .pc-card {
        container-type: inline-size;
    }
    .pc-inner {
        font-size: 1.31rem;
    }
    @media (min-width: 640px) {
        .pc-inner {
            font-size: min(3.13cqw, 1.31rem);
        }
    }
    /* Generative stamp fills its (em-sized) frame regardless of its own
       intrinsic width/height attributes. */
    .pc-stamp :global(svg) {
        width: 100%;
        height: 100%;
        display: block;
    }
</style>

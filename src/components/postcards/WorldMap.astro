---
import WorldMapSvg from "./WorldMapSvg.astro";

interface Props {
    visitedCountries?: string[];
}
const { visitedCountries = [] } = Astro.props;
const TOTAL_COUNTRIES = 195;
---

<section data-world-map>
    <h2 class="mb-6 font-mono text-xs tracking-widest text-ink-muted uppercase">
        Where postcards came from ({visitedCountries.length}/{TOTAL_COUNTRIES})
    </h2>
    <div class="relative">
        <WorldMapSvg visitedCountries={visitedCountries} />
        <div
            data-map-tooltip
            aria-hidden="true"
            class="pointer-events-none fixed z-10 hidden rounded bg-ink px-2 py-1 font-mono text-2xs leading-normal whitespace-nowrap text-paper"
        ></div>
    </div>
</section>

<script>
    // Highlighting and country metadata are already in the HTML. Only following
    // the pointer needs JavaScript; one delegated listener handles every path.
    function initWorldMaps() {
        document.querySelectorAll<HTMLElement>("[data-world-map]").forEach((root) => {
            if (root.dataset.initialized) return;
            root.dataset.initialized = "true";
            const map = root.querySelector("svg");
            const tooltip = root.querySelector<HTMLElement>("[data-map-tooltip]");
            if (!map || !tooltip) return;

            map.addEventListener("pointermove", (event) => {
                const path = event.target instanceof Element
                    ? event.target.closest<SVGPathElement>("path[data-country]") : null;
                if (event.pointerType === "touch" || !path?.dataset.country) {
                    tooltip.classList.add("hidden");
                    return;
                }
                tooltip.textContent = `${path.dataset.flag ?? ""} ${path.dataset.country}`.trim();
                tooltip.classList.remove("hidden");
                tooltip.style.left = `${Math.max(8, Math.min(event.clientX + 15, innerWidth - tooltip.offsetWidth - 8))}px`;
                tooltip.style.top = `${Math.max(8, Math.min(event.clientY + 15, innerHeight - tooltip.offsetHeight - 8))}px`;
            });
            map.addEventListener("pointerleave", () => tooltip.classList.add("hidden"));
        });
    }
    initWorldMaps();
    document.addEventListener("astro:page-load", initWorldMaps);
</script>

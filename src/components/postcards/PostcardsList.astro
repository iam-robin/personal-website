---
/**
 * Postcards as if laid out on a table by hand, within the page column. One
 * column below `lg`; from `lg` two staggered columns, the right one starting
 * half a card lower so the cards never line up into rows. Each card is placed
 * by its own stored rotation and shift (PostcardItem's --pc-* variables).
 */
import type { Postcard } from "astro:db";
import PostcardItem from "./PostcardItem.astro";
import { toPostcardProps } from "../../utils/postcards";

interface Props {
    postcards: (typeof Postcard.$inferSelect)[];
}

const { postcards } = Astro.props;
---

<ol class="pc-cards">
    {
        postcards.map((postcard, index) => (
            <li class="pc-slot" style={`--pc-row: ${index + 1};`}>
                <PostcardItem {...toPostcardProps(postcard)} />
            </li>
        ))
    }
</ol>

<style>
    .pc-cards {
        /* px per step of the stored 0–7 shift; see the transform below. */
        --pc-spread: 2px;

        display: grid;
        grid-template-columns: minmax(0, var(--container-reading));
        justify-content: center;
        row-gap: 2.5rem;
        list-style: none;
    }

    /* The stored shift (0–7px, always down and right) is too faint to take the
       cards off their lines, so it's centred on zero and scaled by
       --pc-spread. The rotation (−2° to 1°) stays as stored. */
    .pc-slot :global(.pc-card) {
        transform: translate(
                calc((var(--pc-shift-x) - 3.5) * var(--pc-spread)),
                calc((var(--pc-shift-y) - 3.5) * var(--pc-spread))
            )
            rotate(var(--pc-rotate));
    }

    @media (width >= 64rem) {
        .pc-cards {
            --pc-spread: 4px; /* about ±14px */
            column-gap: 2.5rem;
            /* Within a column, the gap between two cards is one row gap. */
            row-gap: 3rem;
        }

        /* Staggered: each card spans two row tracks and starts one track after
           the card before it, so the right column runs half a card lower. */
        .pc-cards:has(> :nth-child(2)) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .pc-cards:has(> :nth-child(2)) .pc-slot {
            grid-row: var(--pc-row) / span 2;
        }
        .pc-cards:has(> :nth-child(2)) .pc-slot:nth-child(odd) {
            grid-column: 1;
        }
        .pc-cards:has(> :nth-child(2)) .pc-slot:nth-child(even) {
            grid-column: 2;
        }
    }
</style>

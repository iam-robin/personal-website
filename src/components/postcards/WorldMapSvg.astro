---
import mapSource from "../../assets/world-map.svg?raw";
import { COUNTRIES } from "../../utils/countries";

interface Props {
    visitedCountries?: string[];
}
const { visitedCountries = [] } = Astro.props;
const labels = new Map(COUNTRIES.flatMap((country) =>
    [country.name, ...(country.aliases ?? [])].map((name) => [
        name.toLowerCase(), { canonical: country.name, flag: country.flag },
    ] as const),
));
const visited = new Set(visitedCountries.map((name) =>
    (labels.get(name.toLowerCase())?.canonical ?? name).toLowerCase(),
));
const escapeAttribute = (value: string) => value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

// Only the checked-in SVG asset is parsed here, never user-supplied markup.
// Keep its paths and license in the asset; decorate country paths at build time.
const contents = mapSource.slice(mapSource.indexOf(">", mapSource.indexOf("<svg")) + 1, mapSource.lastIndexOf("</svg>"));
const markup = contents.replace(/<path\b[^>]*>/g, (tag) => {
    const name = /\bname="([^"]*)"/.exec(tag)?.[1]
        ?? /\bclass="([^"]*)"/.exec(tag)?.[1] ?? "";
    const country = labels.get(name.toLowerCase());
    const active = visited.has((country?.canonical ?? name).toLowerCase());
    return tag.replace(/\sclass="[^"]*"/, "").replace(/>$/, ` class="${active ? "active" : ""}" data-country="${escapeAttribute(name)}" data-flag="${escapeAttribute(country?.flag ?? "")}">`);
});
const label = visitedCountries.length
    ? `Postcards received from ${visitedCountries.join(", ")}.`
    : "World map. No postcard countries yet.";
---

<svg
    class="world-map"
    role="img"
    aria-label={label}
    height="auto"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="1"
    version="1.2"
    viewBox="200 0 1800 857"
    width="100%"
    xmlns="http://www.w3.org/2000/svg"
    set:html={markup}
/>

<style>
    .world-map {
        fill: var(--color-inset);
        stroke: var(--color-paper);
        stroke-width: 1;
    }
    .world-map :global(path) { transition: fill 0.2s ease-out; }
    .world-map :global(path.active) {
        fill: var(--color-ink);
        stroke: var(--color-paper);
    }
    .world-map :global(path:hover) {
        fill: color-mix(in srgb, var(--color-ink) 45%, var(--color-inset));
    }
</style>

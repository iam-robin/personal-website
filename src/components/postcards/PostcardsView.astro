---
import type { Page } from "astro";
import { db, Postcard, desc, eq } from "astro:db";
import {
    isValidCountry,
    getStandardCountryName,
    getCountryFlag,
} from "../../utils/countries";
import PostcardItem from "./PostcardItem.astro";
import WorldMap from "./WorldMap.astro";
import FilterBar from "../ui/FilterBar.astro";
import FilterTag from "../ui/FilterTag.astro";
import Pagination from "../ui/Pagination.astro";

interface Props {
    /** The current page of postcards to render (already sliced/filtered). */
    page: Page<typeof Postcard.$inferSelect>;
    /** When set, only postcards from this (standardised) country are shown. */
    selectedCountry?: string;
}
const { page, selectedCountry } = Astro.props;

// The grid renders just this page's slice…
const displayed = page.data;

// Page 1 lives at the base path; deeper pages append the number.
const baseHref = selectedCountry
    ? `/postcards/country/${selectedCountry}`
    : "/postcards";

// …but the filter chips and world map reflect the full published set.
const allPostcards = await db
    .select()
    .from(Postcard)
    .where(eq(Postcard.isPublished, true))
    .orderBy(desc(Postcard.date));

// Country chips (from every postcard, not just the filtered set).
const counts: Record<string, number> = {};
for (const p of allPostcards) {
    if (p.country && isValidCountry(p.country)) {
        const name = getStandardCountryName(p.country);
        counts[name] = (counts[name] || 0) + 1;
    }
}
const countryChips = Object.entries(counts)
    .map(([name, count]) => ({ name, count, flag: getCountryFlag(name) }))
    .sort((a, b) => b.count - a.count);

const visitedCountries = countryChips.map((c) => c.name);

/** Map a DB row to PostcardItem props (drizzle nulls → undefined). */
const toProps = (p: typeof Postcard.$inferSelect) => ({
    author: p.author,
    body: p.body,
    date: p.date,
    marginBottom: p.marginBottom ?? undefined,
    marginRight: p.marginRight ?? undefined,
    rotation: p.rotation ?? undefined,
    penColor: p.penColor ?? undefined,
    paperColor: p.paperColor ?? undefined,
    fontSizeFactor: p.fontSizeFactor ?? undefined,
    lineHeight: p.lineHeight ?? undefined,
    authorLeftOffset: p.authorLeftOffset ?? undefined,
    authorTopOffset: p.authorTopOffset ?? undefined,
    authorRotation: p.authorRotation ?? undefined,
    dateLeftOffset: p.dateLeftOffset ?? undefined,
    dateTopOffset: p.dateTopOffset ?? undefined,
    dateRotation: p.dateRotation ?? undefined,
    bodyLeftOffset: p.bodyLeftOffset ?? undefined,
    bodyTopOffset: p.bodyTopOffset ?? undefined,
    bodyRotation: p.bodyRotation ?? undefined,
    stampSvg: p.stampSvg ?? undefined,
    country: p.country,
    websiteUrl: p.websiteUrl,
    postOfficeStampTop: p.postOfficeStampTop ?? undefined,
    postOfficeStampRight: p.postOfficeStampRight ?? undefined,
    postOfficeStampRotation: p.postOfficeStampRotation ?? undefined,
    wavyStampTop: p.wavyStampTop ?? undefined,
    wavyStampRight: p.wavyStampRight ?? undefined,
    wavyStampRotation: p.wavyStampRotation ?? undefined,
});
---

{/* SVG distortion filter used by PostcardItem's handwriting */}
<svg class="hidden" aria-hidden="true">
    <defs>
        <filter id="distort-xl">
            <feTurbulence baseFrequency="1 1" numOctaves="1"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" scale="1.3"
            ></feDisplacementMap>
        </filter>
    </defs>
</svg>

<div class="flex flex-col gap-16">
    <!-- Country filter -->
    {
        countryChips.length > 0 && (
            <FilterBar>
                <FilterTag
                    href="/postcards"
                    active={!selectedCountry}
                    count={allPostcards.length}
                >
                    All
                </FilterTag>
                {countryChips.map((c) => (
                    <FilterTag
                        href={`/postcards/country/${c.name}`}
                        active={selectedCountry === c.name}
                        count={c.count}
                    >
                        <span>{c.flag}</span>
                        {c.name}
                    </FilterTag>
                ))}
            </FilterBar>
        )
    }

    <!-- Postcards: the grid breaks out of the reading column so landscape
         cards fit two per row (from lg up), and three per row on very large
         screens (2xl) where the container also widens. Fewer cards than a
         full row stay centered rather than stranded. -->
    {
        displayed.length > 0 ? (
            <div class="relative left-1/2 w-screen -translate-x-1/2 overflow-x-clip">
                <ul class="mx-auto flex max-w-7xl flex-wrap justify-center gap-x-10 gap-y-14 px-6 2xl:max-w-[120rem]">
                    {displayed.map((p) => (
                        <li
                            class:list={[
                                "flex w-full max-w-2xl justify-center",
                                displayed.length > 1 &&
                                    "lg:w-[calc(50%-1.25rem)]",
                                displayed.length > 2 &&
                                    "2xl:w-[calc(33.333%-1.667rem)]",
                            ]}
                        >
                            <PostcardItem {...toProps(p)} />
                        </li>
                    ))}
                </ul>
            </div>
        ) : (
            <p class="font-mono text-base opacity-60">
                No postcards from here yet.
            </p>
        )
    }

    {
        page.lastPage > 1 && (
            <Pagination
                currentPage={page.currentPage}
                lastPage={page.lastPage}
                baseHref={baseHref}
            />
        )
    }

    <!-- World map -->
    <WorldMap visitedCountries={visitedCountries} />
</div>

---
import TeaserSection from "../TeaserSection.astro";
import FeaturedProjectCard from "./FeaturedProjectCard.astro";
import { getFeaturedProjects } from "../../utils/projects";

const projects = await getFeaturedProjects();
const link = { href: "/projects", text: "All Projects" };
---

<TeaserSection title="Side Projects" link={link}>
    <div class="grid gap-4 md:grid-cols-3">
        {projects.map((project) => <FeaturedProjectCard project={project} />)}
    </div>
</TeaserSection>

---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { getFanImages, getFirstBodyImage } from "../../utils/projectFans";

interface Props {
    projectId: string;
}

const { projectId } = Astro.props;

// Compact one-row version of the hero fan, following the cursor. Capped at
// five — that's how many positioned slots the row has.
const images = getFanImages(projectId)?.slice(0, 5);

// Projects without a curated fan fall back to their subpage's first asset.
// Drafts have no subpage and render nothing; the hover script treats a
// missing .cover-image like a cover-less bookmark.
let single = null;
if (!images) {
    const entry = await getEntry("projects", projectId);
    if (entry && !entry.data.draft) single = getFirstBodyImage(entry.body);
}

// Photos read as plain prints (square corners), posters keep a slight
// rounding — same as the hero fans.
const rounded = projectId === "matchprint";
---

{
    images && (
        <div
            class="cover-image fan-preview pointer-events-none absolute z-10 hidden md:group-hover:block"
            aria-hidden="true"
        >
            {images.map((image) => (
                <Image
                    src={image}
                    alt=""
                    widths={[300]}
                    sizes="8rem"
                    class:list={["fan-preview-card", { "is-rounded": rounded }]}
                />
            ))}
        </div>
    )
}
{
    single && (
        <div
            class="cover-image pointer-events-none absolute z-10 hidden md:group-hover:block"
            aria-hidden="true"
        >
            <Image
                src={single}
                alt=""
                widths={[600]}
                sizes="20rem"
                class="single-preview"
            />
        </div>
    )
}

<style>
    /*
      Miniature horizontal fan: five 2:3 cards overlapping ~40%, with
      the slightly irregular rotations of the hero fans, first card on
      top. Sized in rem so it stays compact next to the cursor.
    */
    .fan-preview {
        width: 22rem;
        height: 12.5rem;
    }

    .fan-preview-card {
        position: absolute;
        top: 0;
        width: 7.5rem;
        height: auto;
        border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    }

    .fan-preview-card.is-rounded {
        border-radius: 0.375rem;
    }

    .fan-preview-card:nth-child(1) {
        left: 0;
        z-index: 5;
        transform: translateY(4%) rotate(-4deg);
    }
    .fan-preview-card:nth-child(2) {
        left: 3.6rem;
        z-index: 4;
        transform: rotate(-2.5deg);
    }
    .fan-preview-card:nth-child(3) {
        left: 7.2rem;
        z-index: 3;
        transform: translateY(2%) rotate(-0.5deg);
    }
    .fan-preview-card:nth-child(4) {
        left: 10.8rem;
        z-index: 2;
        transform: rotate(2deg);
    }
    .fan-preview-card:nth-child(5) {
        left: 14.4rem;
        z-index: 1;
        transform: translateY(3%) rotate(3.5deg);
    }

    /* Single-image fallback: first subpage asset, sized to roughly
       match the fan's footprint. */
    .single-preview {
        max-width: 22rem;
        max-height: 14rem;
        width: auto;
        height: auto;
        border-radius: 0.375rem;
        border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    }
</style>

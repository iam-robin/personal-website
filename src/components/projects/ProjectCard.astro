---
import FanPreview from "./FanPreview.astro";
import MobileFan from "./MobileFan.astro";
import InkMark from "../ui/InkMark.astro";

interface Props {
    title: string;
    description: string;
    year: string;
    slug: string;
    bgColor?: string;
    bgColorDark?: string;
    externalUrl?: string;
    tags?: string[];
    draft?: boolean;
    /** Cursor-following fan preview on hover (used on /projects). */
    showFanPreview?: boolean;
    /**
     * Static fan inside the row, for viewports and pointers where this
     * page's hover preview can't fire. The value is the breakpoint that
     * preview starts at: `lg` for the homepage hero, `md` for /projects.
     */
    mobileFanUntil?: "md" | "lg";
}

const {
    title,
    description,
    year,
    slug,
    externalUrl,
    tags,
    draft = false,
    showFanPreview = false,
    mobileFanUntil,
} = Astro.props;

const href = externalUrl || `/projects/${slug}`;
const isExternal = !!externalUrl;

const Tag = draft ? "div" : "a";
const linkAttrs = draft
    ? {}
    : {
          href,
          target: isExternal ? "_blank" : undefined,
          rel: isExternal ? "noopener noreferrer" : undefined,
      };

// A draft row is not a link, so it also drops .ink-row: the shared hover
// (mark forward, title underlined) is the site's promise that a row leads
// somewhere, and a row that doesn't must not make it.
//
// Three-column grid — mark · body · meta — rather than nested flex, so the
// description and tags can span past the meta column below `sm`. Sharing a
// column with "ongoing ↗" on a phone left them a ~40-character ribbon.
const gridClass =
    "grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-3 gap-y-1 py-5 font-mono sm:gap-x-4";
const rowClass = draft
    ? `project-card is-draft ${gridClass} cursor-not-allowed`
    : `project-card ink-row ${gridClass}`;

// Description and tags: full width on a phone, boxed into the middle
// column from `sm` up so they never run under the meta. Column *end*
// lines, not `col-span-*` — the span utilities emit the `grid-column`
// shorthand, which resets the start line back to auto.
const bodySpan = "col-start-2 col-end-4 sm:col-end-3";

const tagList = tags ?? [];
---

<Tag
    {...linkAttrs}
    data-project={slug}
    aria-disabled={draft ? "true" : undefined}
    class={rowClass}
>
    {showFanPreview && !draft && <FanPreview projectId={slug} />}
    <InkMark
        name={slug}
        class:list={[
            draft ? "opacity-55" : "ink-row-mark",
            "col-start-1 row-start-1 mt-1 h-5 w-5",
        ]}
    />
    <h3
        class:list={[
            "ink-row-title col-start-2 row-start-1 text-base",
        ]}
    >
        {title}
    </h3>
    <p
        class:list={[
            bodySpan,
            "row-start-2 text-sm text-ink-muted",
        ]}
    >
        {description}
    </p>
    {
        draft ? (
            <span
                class:list={[
                    bodySpan,
                    /* border and dot carried the opacity too — at ink/40 x 0.6.
                       Set to ink/25 so the chip keeps its weight now that the
                       text is a colour rather than a dimmed layer. */
                    "row-start-3 mt-1 inline-flex w-fit items-center gap-1.5 rounded-full border border-dotted border-ink/25 px-2.5 py-0.5 text-xs text-ink-muted",
                ]}
            >
                <span class="h-1.5 w-1.5 rounded-full bg-ink/25" />
                Coming soon
            </span>
        ) : (
            tagList.length > 0 && (
                /* Chips rather than a dimmed line of prose: the contrast floor
                   leaves ink only two steps, so the tags step back by being a
                   different kind of object instead of a lighter grey. Filled,
                   not dotted — the "Coming soon" chip above is a dotted pill,
                   and a status and a topic shouldn't read as the same thing. */
                <span
                    class:list={[
                        bodySpan,
                        "row-start-3 mt-1 flex flex-wrap gap-1.5",
                    ]}
                >
                    {tagList.map((tag) => (
                        <span class="rounded-full bg-ink/10 px-2 py-0.5 text-xs">
                            {tag}
                        </span>
                    ))}
                </span>
            )
        )
    }
    {
        mobileFanUntil && !draft && (
            <MobileFan
                projectId={slug}
                until={mobileFanUntil}
                class={`${bodySpan} row-start-4 mt-3`}
            />
        )
    }
    <span
        class:list={[
            "col-start-3 row-start-1 flex items-center gap-2 text-sm whitespace-nowrap",
            draft ? "text-ink-muted" : "ink-row-meta",
        ]}
    >
        {year}
        {
            !draft && (
                <>
                    <InkMark
                        name={isExternal ? "arrow-external" : "arrow-internal"}
                        class="h-4 w-4 shrink-0"
                    />
                    <span class="sr-only">
                        {isExternal
                            ? "Opens on an external site in a new tab"
                            : "Opens the project page on this site"}
                    </span>
                </>
            )
        }
    </span>
</Tag>

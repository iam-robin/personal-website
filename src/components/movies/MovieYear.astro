---
import LogYear from "../ui/LogYear.astro";
import LogRow from "../ui/LogRow.astro";
import type { FilmYear } from "../../utils/movies";
import { formatShortDate } from "../../utils/dates";
import { getMediaNoteLookup } from "../../utils/garden";

interface Props {
    year: FilmYear;
}

const { year } = Astro.props;

const noteFor = await getMediaNoteLookup("movies");

---

<LogYear label={year.label} count={year.films.length} noun="film">
    {
        year.films.map((film) => (
            <LogRow
                title={film.title}
                chip={film.year}
                favourite={film.liked}
                rating={film.rating}
                date={formatShortDate(film.watched)}
                cover={film.cover}
                note={noteFor(film.title)}
            />
        ))
    }
</LogYear>

---
// Robin bird logo — every state in one SVG, cross-faded on opacity so the
// shared feTurbulence filter rasterizes once.
//
// The paths for the three moods the postcard stamp also draws live in
// src/data/birdShape.ts. Angry stays inline: its brows need a <mask id>, which
// the stamp generator can't emit.
import BirdParts from "./BirdParts.astro";
import { BIRD_MOODS } from "../data/birdShape";

interface Props {
    class?: string;
    /**
     * Interactive birds are <button>s the script targets as `button.bird`.
     * False renders a <span> the script never picks up — for decorative
     * birds, e.g. inside a link.
     */
    interactive?: boolean;
}
const { class: className, interactive = true } = Astro.props;

// Unique filter id so multiple instances on a page don't collide.
const uid = Math.random().toString(36).slice(2, 8);
const filterId = `bird-turbulence-${uid}`;
const angryMaskId = `bird-angry-mask-${uid}`;

const Tag = interactive ? "button" : "span";
const tagProps: Record<string, string> = interactive
    ? { type: "button", "aria-label": "Robin logo" }
    : {};
---

<Tag class:list={["bird", className]} {...tagProps}>
    <svg
        width="139"
        height="162"
        viewBox="0 0 139 162"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <filter
            id={filterId}
            x="-20%"
            y="-20%"
            width="140%"
            height="140%"
            filterUnits="objectBoundingBox"
        >
            <feTurbulence
                type="fractalNoise"
                baseFrequency="0.07"
                numOctaves="3"
                seed="81"
                result="n"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="n" scale="3"></feDisplacementMap>
        </filter>

        <g filter={`url(#${filterId})`}>
            <!-- Default (resting) state -->
            <g class="bird-state bird-default">
                <BirdParts parts={BIRD_MOODS.resting.parts} />
            </g>

            <!-- Clicked (happy) state. The transform carries a jump offset
                 (+12 right, -20 up) on top of the alignment, so the bird looks
                 like it hops up and to the right when clicked. -->
            <g
                class="bird-state bird-clicked"
                transform={BIRD_MOODS.happy.logoTransform}
            >
                <BirdParts parts={BIRD_MOODS.happy.parts} />
            </g>

            <!-- Love state (easter egg: the bird has just eaten a crumb —
                 see BirdFeeder). Eyes shut, heart overhead. -->
            <g
                class="bird-state bird-love"
                transform={BIRD_MOODS.smitten.transform}
            >
                <BirdParts parts={BIRD_MOODS.smitten.parts} />
            </g>

            <!-- Angry state (easter egg: three clicks in a row). Drawn ~4%
                 smaller than the resting state; the transform matches the two
                 body sizes and aligns on the body center so it stays in place
                 and the same size as the other birds. -->
            <g class="bird-state bird-angry" transform="translate(-1.78 -4.96) scale(1.0385)">
                <path d="M37.753 82.7902L0 48.4693L12.0123 36.457L58.3455 72.494L37.753 82.7902Z" fill="currentColor"></path>
                <path d="M70.3581 142.852C97.8427 142.852 120.123 120.571 120.123 93.0866C120.123 65.602 97.8427 43.3213 70.3581 43.3213C42.8734 43.3213 20.5928 65.602 20.5928 93.0866C20.5928 120.571 42.8734 142.852 70.3581 142.852Z" fill="currentColor"></path>
                <path d="M89.2343 84.5061C105.346 84.5061 118.407 71.4451 118.407 55.3334C118.407 39.2217 105.346 26.1606 89.2343 26.1606C73.1226 26.1606 60.0615 39.2217 60.0615 55.3334C60.0615 71.4451 73.1226 84.5061 89.2343 84.5061Z" fill="currentColor"></path>
                <path d="M78.9378 101.667C98.8404 101.667 114.975 88.6057 114.975 72.494C114.975 56.3824 98.8404 43.3213 78.9378 43.3213C59.0352 43.3213 42.9009 56.3824 42.9009 72.494C42.9009 88.6057 59.0352 101.667 78.9378 101.667Z" fill="currentColor"></path>
                <path d="M116.691 51.9014L135.567 56.1915L116.691 60.4816V51.9014Z" fill="currentColor"></path>
                <path d="M94.3821 67.3458C103.86 67.3458 111.543 59.6628 111.543 50.1853C111.543 40.7079 103.86 33.0249 94.3821 33.0249C84.9047 33.0249 77.2217 40.7079 77.2217 50.1853C77.2217 59.6628 84.9047 67.3458 94.3821 67.3458Z" fill="var(--color-paper, white)"></path>
                <mask id={angryMaskId} style="mask-type:luminance" maskUnits="userSpaceOnUse" x="77" y="33" width="35" height="35">
                    <path d="M91.9942 67.1786C101.379 68.4976 110.057 61.9587 111.376 52.5734C112.695 43.1882 106.156 34.5107 96.7708 33.1917C87.3856 31.8727 78.7081 38.4117 77.3891 47.7969C76.0701 57.1821 82.609 65.8596 91.9942 67.1786Z" fill="white"></path>
                </mask>
                <g mask={`url(#${angryMaskId})`}>
                    <path d="M122.711 21.2414L75.1294 14.5542L70.8305 45.1424L118.412 51.8295L122.711 21.2414Z" fill="currentColor"></path>
                </g>
                <path d="M95.8346 55.6691C99.0569 55.6691 101.669 53.0569 101.669 49.8346C101.669 46.6122 99.0569 44 95.8346 44C92.6122 44 90 46.6122 90 49.8346C90 53.0569 92.6122 55.6691 95.8346 55.6691Z" fill="currentColor"></path>
                <path d="M131.106 9.34332C131.864 8.77469 132.94 8.9283 133.508 9.68644C134.077 10.4446 133.923 11.5205 133.165 12.0892C130.656 13.9714 128.015 15.0063 125.271 15.0063C122.528 15.0063 119.887 13.9714 117.377 12.0892C116.619 11.5205 116.466 10.4446 117.034 9.68644C117.603 8.9283 118.679 8.77469 119.437 9.34332C121.503 10.8931 123.439 11.5743 125.271 11.5743C127.104 11.5743 129.039 10.8931 131.106 9.34332Z" fill="currentColor"></path>
                <path d="M135.911 14.8346C136.48 14.0765 137.555 13.9229 138.314 14.4915C139.072 15.0602 139.225 16.136 138.657 16.8942C137.107 18.9606 136.426 20.8962 136.426 22.7286C136.426 24.561 137.107 26.4966 138.657 28.563C139.225 29.3212 139.072 30.397 138.314 30.9657C137.555 31.5343 136.48 31.3807 135.911 30.6226C134.029 28.1129 132.994 25.4723 132.994 22.7286C132.994 19.9849 134.029 17.3444 135.911 14.8346Z" fill="currentColor"></path>
                <path d="M125.271 30.4507C128.015 30.4507 130.656 31.4856 133.165 33.3679C133.923 33.9365 134.077 35.0124 133.508 35.7706C132.94 36.5287 131.864 36.6823 131.106 36.1137C129.039 34.564 127.104 33.8828 125.271 33.8828C123.439 33.8828 121.503 34.564 119.437 36.1137C118.679 36.6823 117.603 36.5287 117.034 35.7706C116.466 35.0124 116.619 33.9365 117.377 33.3679C119.887 31.4856 122.528 30.4507 125.271 30.4507Z" fill="currentColor"></path>
                <path d="M112.229 14.4915C112.988 13.9229 114.063 14.0765 114.632 14.8346C116.514 17.3444 117.549 19.9849 117.549 22.7286C117.549 25.4723 116.514 28.1129 114.632 30.6226C114.063 31.3807 112.988 31.5343 112.229 30.9657C111.471 30.397 111.318 29.3212 111.886 28.563C113.436 26.4966 114.117 24.561 114.117 22.7286C114.117 20.8962 113.436 18.9606 111.886 16.8942C111.318 16.136 111.471 15.0602 112.229 14.4915Z" fill="currentColor"></path>
                <path d="M61.2627 160.012V135.129C61.2627 133.897 62.2616 132.898 63.4936 132.898C64.7257 132.898 65.7246 133.897 65.7246 135.129V160.012C65.7246 161.244 64.7257 162.243 63.4936 162.243C62.2616 162.243 61.2627 161.244 61.2627 160.012Z" fill="currentColor"></path>
                <path d="M85.2871 160.012V135.129C85.2871 133.897 86.286 132.898 87.5181 132.898C88.7501 132.898 89.749 133.897 89.749 135.129V160.012C89.749 161.244 88.7501 162.243 87.5181 162.243C86.286 162.243 85.2871 161.244 85.2871 160.012Z" fill="currentColor"></path>
            </g>
        </g>
    </svg>
</Tag>

<style>
    .bird {
        display: inline-flex;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        cursor: pointer;
        line-height: 0;
        -webkit-tap-highlight-color: transparent;
    }
    .bird svg {
        height: 100%;
        width: auto;
        /* The scaled-up clicked state's tail tip reaches a few px past the
           left edge; let it paint into the surrounding whitespace. */
        overflow: visible;
    }
    /* Swap between states. Resting shows the default; .is-clicked shows the
       happy state; .is-angry shows the angry state. Instant — no transition.
       The angry rules come last so they win when both classes are briefly
       present.

       .is-eating shows the love state; BirdFeeder sets it while the bird
       swallows a crumb. It gets its own class rather than borrowing
       .is-clicked because the click handler below owns that one and clears it
       on its own timer, which would cut a meal short. */
    .bird-clicked,
    .bird-love,
    .bird-angry {
        opacity: 0;
    }
    .bird.is-clicked .bird-default {
        opacity: 0;
    }
    .bird.is-clicked .bird-clicked {
        opacity: 1;
    }
    .bird.is-eating .bird-default {
        opacity: 0;
    }
    .bird.is-eating .bird-love {
        opacity: 1;
    }
    .bird.is-angry .bird-default,
    .bird.is-angry .bird-clicked,
    .bird.is-angry .bird-love {
        opacity: 0;
    }
    .bird.is-angry .bird-angry {
        opacity: 1;
    }
    /* Hover: same resting bird, but the pupil dilates and the tail lifts.
       Static swap — no transition. .is-hovered pins that state without a
       pointer, so the colophon can stand it next to the resting bird as its
       own specimen. */
    .bird-pupil {
        transform-box: fill-box;
        transform-origin: center;
    }
    .bird-tail {
        transform-box: view-box;
        transform-origin: 50px 120px;
    }
    .bird:hover .bird-pupil,
    .bird.is-hovered .bird-pupil {
        transform: scale(1.2);
    }
    .bird:hover .bird-tail,
    .bird.is-hovered .bird-tail {
        transform: rotate(8deg);
    }
</style>

<script>
    // Two timers on purpose: the bird returns to default shortly after each
    // click, but the streak that triggers the angry state lives on a longer
    // window, so it survives the bird resetting in between.
    const VISUAL_RESET = 900;
    const STREAK_WINDOW = 3000;
    for (const btn of document.querySelectorAll<HTMLButtonElement>("button.bird")) {
        let visualTimer: ReturnType<typeof setTimeout>;
        let streakTimer: ReturnType<typeof setTimeout>;
        let streak = 0;
        btn.addEventListener("click", () => {
            streak++;
            clearTimeout(visualTimer);
            clearTimeout(streakTimer);
            if (streak >= 3) {
                btn.classList.remove("is-clicked");
                btn.classList.add("is-angry");
                streak = 0;
            } else {
                btn.classList.remove("is-angry");
                btn.classList.add("is-clicked");
            }
            visualTimer = setTimeout(() => {
                btn.classList.remove("is-clicked", "is-angry");
            }, VISUAL_RESET);
            streakTimer = setTimeout(() => {
                streak = 0;
            }, STREAK_WINDOW);
        });
    }
</script>

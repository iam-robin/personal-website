---
// Robin bird logo — two states in one SVG. Clicking swaps to the "happy"
// state, then it resets after a short beat. Both states share a single
// `feTurbulence` + `feDisplacementMap` filter (static, so the browser
// rasterizes the noise once) and we only cross-fade `opacity` between the
// two groups, which stays cheap/composited.
interface Props {
    class?: string;
    /**
     * Interactive birds are <button>s that swap to happy/angry states on
     * click (the script targets `button.bird`). Set false for a static,
     * decorative bird — e.g. inside a link — which renders as a <span> the
     * script never picks up.
     */
    interactive?: boolean;
}
const { class: className, interactive = true } = Astro.props;

// Unique filter id so multiple instances on a page don't collide.
const uid = Math.random().toString(36).slice(2, 8);
const filterId = `bird-turbulence-${uid}`;
const angryMaskId = `bird-angry-mask-${uid}`;

const Tag = interactive ? "button" : "span";
const tagProps: Record<string, string> = interactive
    ? { type: "button", "aria-label": "Robin logo" }
    : {};
---

<Tag class:list={["bird", className]} {...tagProps}>
    <svg
        width="139"
        height="162"
        viewBox="0 0 139 162"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <filter
            id={filterId}
            x="-20%"
            y="-20%"
            width="140%"
            height="140%"
            filterUnits="objectBoundingBox"
        >
            <feTurbulence
                type="fractalNoise"
                baseFrequency="0.07"
                numOctaves="3"
                seed="81"
                result="n"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="n" scale="3"></feDisplacementMap>
        </filter>


---
/**
 * The dazed robin: the same bird as the logo, but with a crossed-out eye —
 * clearly not expecting you. Used on the 404 page and in the colophon.
 * Body follows `currentColor` (set the text color on a parent); the eye
 * fills with `--color-paper` so it reads in both light and dark.
 */
interface Props {
    class?: string;
}
const { class: className } = Astro.props;

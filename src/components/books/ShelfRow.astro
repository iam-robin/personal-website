---
/**
 * The rules linking an open book to its detail line are generated in
 * books.astro: the selector crosses into BookSpine's `[open]`.
 */
import BookSpine from "./BookSpine.astro";
import ReadingStack from "./ReadingStack.astro";
import Rating from "../ui/Rating.astro";
import type { ShelfYear } from "../../utils/books";
import { formatShortDate } from "../../utils/dates";

interface Props {
    year: ShelfYear;
}

const { year } = Astro.props;

const pages = year.books.reduce((sum, book) => sum + (book.pages ?? 0), 0);

const detailsFor = (book: ShelfYear["books"][number]) =>
    [
        book.authors,
        book.pages && `${book.pages} pages`,
        book.rating,
        formatShortDate(book.finished),
    ].filter((detail): detail is string | number => Boolean(detail));

/* Resting row width, so `.shelf::after` only adds space when the row overflows. */
const SHELF_GAP = 2;
const stackUnits = year.reading.length
    ? 0.15 + Math.max(...year.reading.map((book) => book.heightRatio))
    : 0;
const rowUnits =
    year.books.reduce((sum, book) => sum + book.thicknessRatio, 0) + stackUnits;
const rowItems = year.books.length + (year.reading.length > 0 ? 1 : 0);
const rowWidth = `calc(var(--shelf-h) * ${rowUnits.toFixed(4)} + ${
    Math.max(0, rowItems - 1) * SHELF_GAP
}px)`;
---

<section class="shelf-row" style={`--row-w: ${rowWidth}`}>
    <div
        class="flex items-baseline justify-between gap-4 border-b border-dotted border-ink/30 pb-4"
    >
        <h2 class="text-sm font-bold">{year.year}</h2>
        <p class="font-mono text-xs text-ink-muted">
            {year.books.length} books{pages > 0 && ` · ${pages.toLocaleString("en-GB")} pages`}
        </p>
    </div>

    <div class="shelf-scroller">
        <ul class="shelf">
            {year.books.map((book) => <BookSpine book={book} />)}
            {year.reading.length > 0 && <ReadingStack books={year.reading} />}
        </ul>
    </div>

    {/* The text restates what the open book announces in place, so it's
        aria-hidden; the note link isn't. */}
    <p class="shelf-detail">
        {
            year.books.map((book) => (
                <span>
                    <span aria-hidden="true">{book.title}</span>
                    <i aria-hidden="true">
                        {detailsFor(book).map((detail, index) => (
                            <>
                                {index > 0 && <span aria-hidden="true"> · </span>}
                                {typeof detail === "number" ? (
                                    <Rating value={detail} />
                                ) : (
                                    detail
                                )}
                            </>
                        ))}
                    </i>
                    {book.note && (
                        <a class="shelf-note" href={book.note}>
                            Read my note
                            <span class="sr-only"> on {book.spineTitle}</span>{" "}
                            <span aria-hidden="true">→</span>
                        </a>
                    )}
                </span>
            ))
        }
    </p>
</section>

<style>
    .shelf-row {
        /* Every book's dimensions are fractions of this (see utils/books.ts). */
        --shelf-h: 22rem;

        /* No percentages: in margin and scroll-padding they resolve against different
           boxes. --shelf-edge matters: 100vw includes a classic scrollbar, which would
           leave the page scrollable sideways. */
        --shelf-edge: 0.75rem;
        --shelf-bleed: max(
            var(--spacing-gutter),
            calc(
                50vw - var(--container-shell) / 2 + var(--spacing-gutter) -
                    var(--shelf-edge)
            )
        );
    }

    .shelf-scroller {
        overflow-x: auto;
        /* Room for the focus ring: overflow-x: auto clips overflow-y too. */
        padding-top: 0.5rem;
        /* Keeps the scrollbar off the books. .shelf-detail's margin subtracts it. */
        padding-bottom: 0.5rem;
        margin-top: 0.5rem;
        margin-inline: calc(var(--shelf-bleed) * -1);
        /* Start padding only: end padding doesn't count towards scrollable overflow,
           so the far end is .shelf::after. */
        padding-inline-start: var(--shelf-bleed);
        padding-inline-end: 0;
        overscroll-behavior-x: contain;
        scroll-snap-type: x proximity;
        /* Makes scrollLeft 0 a snap point. */
        scroll-padding-inline-start: var(--shelf-bleed);
    }

    .shelf :global(.shelf-book) {
        scroll-snap-align: start;
    }


    .shelf {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        min-height: var(--shelf-h);
    }

    /* Only as wide as the row overflows: --row-w minus the content box, floored at
       0 and switched on by the x100. */
    .shelf::after {
        content: "";
        flex: 0 0 auto;
        width: clamp(
            0px,
            (var(--row-w) - 100%) * 100,
            calc(var(--shelf-bleed) - 2px)
        );
        /* A zero-height flex item adds nothing to the scrollable width. */
        align-self: stretch;
    }

    /* All lines share one grid cell, so opening a book never shifts the page. */
    .shelf-detail {
        display: grid;
        min-height: 3.25rem;
        /* 1.25rem minus the scroller's bottom padding above. */
        margin-top: 0.75rem;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.5;
    }

    .shelf-detail > span {
        grid-area: 1 / 1;
    }

    .shelf-detail i,
    .shelf-note {
        display: block;
        font-style: normal;
        color: var(--color-ink-muted);
    }

    .shelf-note {
        width: fit-content;
        margin-top: 0.75rem;
        color: var(--color-ink);
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .shelf-note:hover {
        text-decoration: none;
    }
</style>

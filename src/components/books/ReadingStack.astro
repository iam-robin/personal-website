---
/**
 * The book (or books) I'm in the middle of, lying flat at the end of the
 * current year's shelf rather than standing in it. Display only: flat, the
 * spine reads left to right, so there's nothing to click through to.
 */
import type { ShelfBook } from "../../utils/books";

interface Props {
    books: ShelfBook[];
}

const { books } = Astro.props;
---

<li class="reading-stack">
    <p class="reading-label">Currently reading</p>
    <ul class="reading-books">
        {
            books.map((book) => (
                <li
                    class="reading-book"
                    style={`--ts: ${book.thicknessRatio.toFixed(4)}; --hs: ${book.heightRatio.toFixed(4)}; --spine: ${book.spineColor}; --text: ${book.textColor}`}
                >
                    <span class="reading-title">{book.spineTitle}</span>
                </li>
            ))
        }
    </ul>
</li>

<style>
    /* A flex item of the shelf like any book, so `align-items: flex-end` sets
       it on the line the standing books stand on. */
    .reading-stack {
        position: relative;
        flex: 0 0 auto;
        /* Clear of the finished books — it hasn't joined them. */
        margin-inline-start: calc(var(--shelf-h) * 0.15);
    }

    /* Above the stack, in the headroom the scroller reserves (see ShelfRow). */
    .reading-label {
        position: absolute;
        bottom: 100%;
        left: 0;
        margin-bottom: 0.4rem;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1;
        white-space: nowrap;
        opacity: 0.45;
    }

    /* column-reverse so the first book sits at the bottom of the pile. */
    .reading-books {
        display: flex;
        flex-direction: column-reverse;
        gap: 2px;
    }

    /* Lying flat: as wide as the book is tall, as tall as it is thick — the
       standing spine's two numbers, swapped. */
    .reading-book {
        --t: calc(var(--shelf-h) * var(--ts));
        --h: calc(var(--shelf-h) * var(--hs));

        display: flex;
        align-items: center;
        width: var(--h);
        height: var(--t);
        padding-inline: 0.9rem;
        overflow: hidden;
        background: var(--spine);
        color: var(--text);
    }

    .reading-title {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

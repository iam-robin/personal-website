---
/** The books in progress, lying flat at the end of the current year's shelf. */
import type { ShelfBook } from "../../utils/books";

interface Props {
    books: ShelfBook[];
}

const { books } = Astro.props;
---

<li class="reading-stack">
    <p class="reading-label">Currently reading</p>
    <ul class="reading-books">
        {
            books.map((book) => (
                <li
                    class="reading-book"
                    style={`--ts: ${book.thicknessRatio.toFixed(4)}; --hs: ${book.heightRatio.toFixed(4)}; --spine: ${book.spineColor}; --text: ${book.textColor}; --title-lines: ${book.titleLines}`}
                >
                    <span class="reading-title">{book.spineTitle}</span>
                </li>
            ))
        }
    </ul>
</li>

<style>
    .reading-stack {
        position: relative;
        flex: 0 0 auto;
        margin-inline-start: calc(var(--shelf-h) * 0.15);
    }

    .reading-label {
        position: absolute;
        bottom: 100%;
        left: 0;
        margin-bottom: 0.4rem;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1;
        white-space: nowrap;
        color: var(--color-ink-muted);
    }

    .reading-books {
        display: flex;
        flex-direction: column-reverse;
        gap: 2px;
    }

    .reading-book {
        --t: calc(var(--shelf-h) * var(--ts));
        --h: calc(var(--shelf-h) * var(--hs));

        display: flex;
        align-items: center;
        width: var(--h);
        height: var(--t);
        padding-inline: 0.9rem;
        overflow: hidden;
        background: var(--spine);
        color: var(--text);
    }

    .reading-title {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--title-lines, 1);
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.35;
    }
</style>

---
/**
 * A four-faced 3D box that rests spine-out and turns when opened.
 * <details name="shelf"> gives one-open-at-a-time, a tab stop per book and
 * expanded/collapsed state, without JS.
 */
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ShelfBook } from "../../utils/books";

interface Props {
    book: ShelfBook;
}

const { book } = Astro.props;

const finishedLong = book.finished
    ? new Date(book.finished).toLocaleDateString("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
      })
    : "";

const described = [
    book.pages && `${book.pages} pages`,
    book.rating && `rated ${book.rating} out of 5`,
    finishedLong && `finished ${finishedLong}`,
    book.note && "my note on it is linked below the shelf",
]
    .filter(Boolean)
    .join(" · ");
---

<li
    class:list={["shelf-book", "ease-spring"]}
    data-title-lines={book.titleLines}
    style={`--ts: ${book.thicknessRatio.toFixed(4)}; --hs: ${book.heightRatio.toFixed(4)}; --cr: ${book.coverRatio.toFixed(4)}; --spine: ${book.spineColor}; --text: ${book.textColor}; --title-lines: ${book.titleLines}`}
>
    <details name="shelf">
        <summary
            aria-label={`${book.title}${book.authors ? ` — ${book.authors}` : ""}`}
        >
            <span class="book-inner" aria-hidden="true">
                <span class="face-back"></span>
                <span class="face-fore"></span>
                <span class="face-spine">
                    <span class="spine-title">{book.spineTitle}</span>
                    {
                        (book.favourite || book.note) && (
                            <span class="spine-marks">
                                {book.favourite && (
                                    <Icon name="ph:heart-fill" />
                                )}
                                {book.note && (
                                    <Icon name="ph:pen-nib-fill" />
                                )}
                            </span>
                        )
                    }
                </span>
                <span class="face-cover">
                    {
                        book.cover ? (
                            <Image
                                src={book.cover}
                                alt=""
                                widths={[200, 400]}
                                sizes="200px"
                                loading="lazy"
                            />
                        ) : (
                            <span class="cover-fallback">
                                <span class="cover-fallback-title">
                                    {book.spineTitle}
                                </span>
                                <span class="cover-fallback-author">
                                    {book.authors}
                                </span>
                            </span>
                        )
                    }
                </span>
            </span>
            {
                /* A title on the 3D-turned spine is never hit-tested, so a
                   flat target sits over the pen instead. */
                book.note && (
                    <span
                        class:list={["note-hit", book.favourite && "is-second"]}
                        title="I wrote a note on this"
                        aria-hidden="true"
                    />
                )
            }
        </summary>
        {/* The same content ShelfRow shows below the row, so "expanded" reveals something. */}
        <p class="sr-only">{described}</p>
    </details>
</li>

<style>
    /* .book-inner IS the front cover plane; the other faces hang off it:
         .face-spine  right:100%, origin right, rotateY(-90deg)
         .face-fore   left:100%,  origin left,  rotateY(90deg)
         .face-back   translateZ(-T)
       Pivot the spine from inside the plane and its title reads mirrored. */
    .shelf-book {
        --t: calc(var(--shelf-h) * var(--ts));
        --h: calc(var(--shelf-h) * var(--hs));
        --cw: calc(var(--h) * var(--cr));

        --gap: calc(var(--shelf-h) * 0.06);

        --open-angle: 20deg;

        --shade: 0.65;

        /* The projected open width; the slot must match it. The last factor is
           perspective (~7% smaller far edge). */
        --open-perspective: 0.931;
        --open-w: calc(
            (
                    var(--cw) * cos(var(--open-angle)) + var(--t) *
                        sin(var(--open-angle))
                ) *
                var(--open-perspective)
        );

        /* 0 closed, 1 open. Width, margin and rotation all derive from it. Registered
           below, or it would jump instead of interpolating. */
        --open: 0;

        position: relative;
        flex: 0 0 auto;
        height: var(--h);

        /* z-index doesn't interpolate; the delayed swap below keeps a turning book on
           top. */
        z-index: 1;

        /* Margins are safe under a click; under hover they'd walk the book away. */
        width: calc(var(--t) + (var(--open-w) - var(--t)) * var(--open));
        margin-inline: calc(var(--gap) * var(--open));
    }

    /* `inherits: true`: .book-inner reads --open too. */
    @property --open {
        syntax: "<number>";
        inherits: true;
        initial-value: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
        .shelf-book {
            /* --ease-spring overshoots to ~17deg, still short of flat. */
            transition:
                --open 600ms var(--ease-spring),
                z-index 0s linear 600ms;
        }

        .shelf-book:has(details[open]) {
            transition:
                --open 600ms var(--ease-spring),
                z-index 0s linear 0s;
        }
    }

    .shelf-book:first-child {
        margin-inline-start: 0;
    }

    .shelf-book:last-child {
        margin-inline-end: 0;
    }

    .shelf-book details,
    .shelf-book summary {
        position: absolute;
        inset: 0;
    }

    .shelf-book summary {
        display: block;
        list-style: none;
        cursor: pointer;
        /* Here, not on the <li>: perspective only applies to direct children. */
        perspective: 900px;
    }

    .shelf-book summary::-webkit-details-marker {
        display: none;
    }

    .shelf-book summary:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 3px;
    }

    /* Wider than its slot by design. Nothing on the book may set overflow: hidden. */
    .book-inner {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: var(--cw);
        transform-style: preserve-3d;
        /* Hinged at the back-left corner. The translateZ keeps the closed state at
           z = 0, or every spine renders ~5% small and soft. */
        transform-origin: left center calc(var(--t) * -1);
        transform: translateZ(calc(var(--t) * (1 - var(--open))))
            rotateY(calc(90deg - (90deg - var(--open-angle)) * var(--open)));
    }

    .shelf-book:has(details[open]) {
        --open: 1;
        z-index: 3;
    }

    .face-cover,
    .face-back {
        position: absolute;
        inset: 0;
    }

    /* Light, scaled by --open, so it is nothing at rest. */
    .face-cover::before,
    .face-cover::after {
        content: "";
        position: absolute;
        pointer-events: none;
        opacity: calc(var(--open) * var(--shade));
    }

    /* Hard stops in fixed pixels: a soft ramp reads as a paperback. */
    .face-cover::before {
        inset-block: 0;
        inset-inline-start: 0;
        width: 8px;
        background: linear-gradient(
            to right,
            rgb(255 255 255 / 0.4) 0 1px,
            rgb(0 0 0 / 0.1) 1px 5px,
            rgb(0 0 0 / 0.3) 5px 6px,
            rgb(0 0 0 / 0.07) 6px 8px
        );
    }

    .face-cover::after {
        inset: 0;
        background: linear-gradient(
            105deg,
            rgb(255 255 255 / 0.15),
            rgb(255 255 255 / 0) 34%,
            rgb(255 255 255 / 0) 72%,
            rgb(255 255 255 / 0.08)
        );
    }

    /* `to right` runs outer edge to hinge. */
    .face-spine::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
            to right,
            rgb(0 0 0 / 0.22),
            rgb(0 0 0 / 0.1)
        );
        opacity: calc(var(--open) * var(--shade));
    }

    .face-back {
        transform: translateZ(calc(var(--t) * -1));
        background: var(--spine);
    }

    .face-spine {
        position: absolute;
        top: 0;
        right: 100%;
        width: var(--t);
        height: 100%;
        transform-origin: right center;
        transform: rotateY(-90deg);
        background: var(--spine);
        color: var(--text);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-block: 0.75rem;
        overflow: hidden;
    }

    .face-fore {
        position: absolute;
        top: 0;
        left: 100%;
        width: var(--t);
        height: 100%;
        transform-origin: left center;
        transform: rotateY(90deg);
        background: #f2f0eb;
    }

    .face-cover :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .cover-fallback {
        display: flex;
        height: 100%;
        flex-direction: column;
        justify-content: flex-end;
        gap: 0.4rem;
        padding: 1rem 0.85rem;
        background: var(--spine);
        color: var(--text);
        font-family: var(--font-mono);
    }

    .cover-fallback-title {
        font-size: 0.8125rem;
        line-height: 1.25;
    }

    .cover-fallback-author {
        font-size: 0.6875rem;
        opacity: 0.7;
    }

    /* Sized off --t, not cqi: in vertical-rl the inline size is the height. */
    .spine-title {
        writing-mode: vertical-rl;
        /* `sideways-lr` isn't safe in Safari yet. */
        transform: rotate(180deg);
        overflow: hidden;
        max-height: 100%;
        /* In vertical-rl, capping the width caps the line count. */
        max-width: calc(1.35em * var(--title-lines, 1));
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: var(--font-mono);
        font-size: clamp(9px, calc(var(--t) * 0.42), 13px);
        line-height: 1.35;
        letter-spacing: 0.01em;
    }

    .shelf-book {
        --mark: clamp(10px, calc(var(--t) * 0.36), 14px);
        --mark-gap: 0.4rem;
    }

    /* Out of flow, or they'd push the title up off the foot. */
    .spine-marks {
        position: absolute;
        top: 1rem;
        inset-inline: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--mark-gap);
        color: var(--text);
    }

    .spine-marks :global(svg) {
        display: block;
        width: var(--mark);
        height: var(--mark);
    }

    /* Clearance for the out-of-flow marks above the title. */
    .face-spine:has(.spine-marks) {
        padding-top: calc(1rem + var(--mark) + 0.6rem);
    }

    .face-spine:has(.spine-marks > :nth-child(2)) {
        padding-top: calc(1rem + var(--mark) * 2 + var(--mark-gap) + 0.6rem);
    }

    /* Closed, the spine renders 1:1 over the slot, so the marks' own
       offsets place this. */
    .note-hit {
        --hit-pad: 0.25rem;
        position: absolute;
        top: calc(1rem - var(--hit-pad));
        left: 50%;
        width: calc(var(--mark) + var(--hit-pad) * 2);
        height: calc(var(--mark) + var(--hit-pad) * 2);
        translate: -50% 0;
        z-index: 1;
    }

    .note-hit.is-second {
        top: calc(1rem + var(--mark) + var(--mark-gap) - var(--hit-pad));
    }

    .shelf-book:has(details[open]) .note-hit {
        display: none;
    }

    .shelf-book[data-title-lines="2"] .spine-title {
        white-space: normal;
        text-overflow: clip;
    }

    /* The `ease-spring` class on the <li> keeps --ease-spring in :root: Tailwind
       can't see uses in scoped styles. */
</style>

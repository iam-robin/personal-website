---
// Click the band next to the logo to drop a crumb; the bird hops over and
// eats it. Two nested transforms so nothing fights over `transform`:
//   [data-feeder-bird]  travel (translate)
//   .bird               facing (scaleX) and pecking (rotate)
import Bird from "./Bird.astro";

interface Props {
    class?: string;
}
const { class: className } = Astro.props;

// A fixed pool; its size is the cap.
const MAX_CRUMBS = 8;
const TILT = [-14, 7, 22, -5, 13, -21, 3, 17];
---

<div class:list={["feeder h-20 w-full text-ink", className]} data-feeder>
    <div class="feeder-field" data-feeder-field aria-hidden="true">
        {
            Array.from({ length: MAX_CRUMBS }, (_, i) => (
                <span
                    class="crumb"
                    data-crumb
                    data-variant={i % 3}
                    style={`--rot: ${TILT[i]}deg`}
                />
            ))
        }
    </div>
    <div class="feeder-bird" data-feeder-bird>
        <Bird class="h-full w-auto" />
    </div>
    <span class="cursor-crumb" data-cursor-crumb aria-hidden="true"></span>
</div>

<style>
    .feeder {
        position: relative;
        overflow: visible;
    }

    /* The native cursor stays: a pointer would promise navigation. */
    .feeder-field {
        position: absolute;
        inset: 0;
        cursor: default;
    }

    /* Absolute, not fixed: the hero's entrance animation transforms an ancestor,
       which re-anchors fixed descendants. The tilt goes after the translate in
       the script's transform string: `rotate` would apply before `transform`. */
    .cursor-crumb {
        position: absolute;
        top: 0;
        left: 0;
        width: 7px;
        height: 5px;
        background: currentColor;
        border-radius: 60% 40% 55% 45% / 55% 60% 40% 45%;
        opacity: 0;
        pointer-events: none;
        will-change: transform;
    }
    .cursor-crumb.is-carried {
        opacity: 1;
    }
    @media (hover: none), (pointer: coarse) {
        .cursor-crumb {
            display: none;
        }
    }

    .feeder-bird {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 100%;
        will-change: transform;
    }

    /* Origin at the feet, so a peck tips the head. No transition on the mirror. */
    .feeder :global(.bird) {
        transform-origin: 50% 100%;
        will-change: transform;
    }

    .crumb {
        position: absolute;
        bottom: 0;
        left: var(--x, 0);
        width: 7px;
        height: 5px;
        margin-left: -3.5px;
        background: currentColor;
        opacity: 0;
        pointer-events: none;
        transform: rotate(var(--rot));
    }
    .crumb[data-variant="0"] {
        border-radius: 60% 40% 55% 45% / 55% 60% 40% 45%;
    }
    .crumb[data-variant="1"] {
        width: 5px;
        height: 4px;
        margin-left: -2.5px;
        border-radius: 45% 55% 40% 60% / 60% 45% 55% 40%;
    }
    .crumb[data-variant="2"] {
        width: 6px;
        height: 6px;
        margin-left: -3px;
        border-radius: 50% 60% 45% 55% / 45% 50% 60% 55%;
    }
    .crumb.is-out {
        opacity: 1;
    }
    .crumb.is-eaten {
        opacity: 0;
        transform: rotate(var(--rot)) scale(0.4);
    }

    @media (prefers-reduced-motion: no-preference) {
        .crumb.is-out {
            animation: crumb-fall 420ms both;
        }
        .crumb.is-eaten {
            transition:
                opacity 140ms ease-out,
                transform 140ms ease-out;
        }

        @keyframes crumb-fall {
            0% {
                transform: translateY(calc(-1 * var(--drop)))
                    rotate(var(--rot));
                animation-timing-function: cubic-bezier(0.5, 0, 1, 1);
            }
            55% {
                transform: translateY(0) rotate(var(--rot));
                animation-timing-function: cubic-bezier(0, 0, 0.4, 1);
            }
            72% {
                transform: translateY(calc(-0.18 * var(--drop)))
                    rotate(var(--rot));
                animation-timing-function: cubic-bezier(0.5, 0, 1, 1);
            }
            86% {
                transform: translateY(0) rotate(var(--rot));
                animation-timing-function: cubic-bezier(0, 0, 0.4, 1);
            }
            93% {
                transform: translateY(calc(-0.06 * var(--drop)))
                    rotate(var(--rot));
                animation-timing-function: cubic-bezier(0.5, 0, 1, 1);
            }
            100% {
                transform: translateY(0) rotate(var(--rot));
            }
        }
    }
</style>

<script>
    // Nominal values; every hop is scattered by `vary`.
    const HOP_LEN = 46;
    const HOP_MS = 210;
    const HOP_LIFT = 26;
    const HOP_BEAT = 70;
    const HOP_VARY = 0.12;
    const HOP_LOOK = 0.15;
    const PECK_MS = 200;
    const PECK_DEG = 22;
    const YUM_MS = 380; // how long the love state is held after a meal
    const FALL_MS = 420; // must match the crumb-fall duration above
    const MIN_DROP = 10; // a click on the floor still gets a small drop

    // Where the crumb lands, as a fraction of the bird's width. Past 1 because
    // the peck swings the beak forward. Derived from PECK_DEG; recompute if it
    // changes.
    const REACH = 1.255;

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const clamp = (v: number, lo: number, hi: number) =>
        Math.min(Math.max(v, lo), hi);

    // Mostly linear with a touch of smoothstep, so trips start and end on
    // shorter hops.
    const easeTrip = (t: number) => 0.75 * t + 0.25 * (t * t * (3 - 2 * t));

    // A sampled parabola: easing the whole transform would stall sideways at
    // the apex.
    const ARC_STEPS = 12;
    const arc = (a: number, b: number, lift: number) =>
        Array.from({ length: ARC_STEPS + 1 }, (_, k) => {
            const t = k / ARC_STEPS;
            return {
                transform: `translate3d(${a + (b - a) * t}px,${-lift * 4 * t * (1 - t)}px,0)`,
                easing: "linear",
            };
        });

    // Math.random on purpose: identical repeats are the failure mode here.
    const vary = (base: number, amount: number) =>
        base * (1 + (Math.random() * 2 - 1) * amount);

    const beat = () =>
        Math.random() < HOP_LOOK
            ? vary(HOP_BEAT * 1.35, 0.2)
            : vary(HOP_BEAT, 0.2);

    // `animation.finished` stalls in background tabs, so race it against the
    // duration. The inline transform already holds the destination.
    function play(animation: Animation, duration: number) {
        return Promise.race([
            animation.finished.catch(() => {}),
            wait(duration + 120).then(() => {
                if (animation.playState !== "idle") animation.cancel();
            }),
        ]);
    }

    // Separate from initFeeders so the null checks narrow parameters.
    // The crumb's lower-right corner touches the cursor tip.
    const CARRY_DX = -6;
    const CARRY_DY = -5;
    const CARRY_TILT = -14; // deg — see the .cursor-crumb comment

    function attach(
        field: HTMLElement,
        travel: HTMLElement,
        bird: HTMLElement,
        pool: HTMLElement[],
        carry: HTMLElement | null,
    ) {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)");

        const queue: HTMLElement[] = [];
        let cursor = 0; // round-robin pointer into the crumb pool
        let x = 0; // the bird's offset from home, px
        let face = 1; // 1 right, -1 left
        let busy = false;

        const birdW = () => bird.offsetWidth;
        const center = () => x + birdW() / 2;
        const crumbX = (el: HTMLElement) =>
            (parseFloat(el.style.getPropertyValue("--x")) / 100) *
            field.clientWidth;

        function takeCrumb() {
            for (let i = 0; i < pool.length; i++) {
                const el = pool[(cursor + i) % pool.length];
                if (el.dataset.active) continue;
                cursor = (cursor + i + 1) % pool.length;
                return el;
            }
            return null; // all eight are on the floor — that's the cap
        }

        function setFace(dir: number) {
            if (face === dir) return;
            face = dir;
            bird.style.transform = `scaleX(${dir})`;
        }

        async function hopTo(to: number) {
            const from = x;
            const dist = to - from;
            if (Math.abs(dist) < 1) {
                x = to;
                return;
            }

            if (reduce.matches) {
                const duration = Math.min(600, 260 + Math.abs(dist));
                travel.style.transform = `translate3d(${to}px,0,0)`;
                await play(
                    travel.animate(
                        [
                            { transform: `translate3d(${from}px,0,0)` },
                            { transform: `translate3d(${to}px,0,0)` },
                        ],
                        { duration, easing: "linear" },
                    ),
                    duration,
                );
                x = to;
                return;
            }

            const steps = Math.max(1, Math.ceil(Math.abs(dist) / HOP_LEN));

            // Interior landings are nudged so no two hops match.
            const marks: number[] = [];
            for (let i = 0; i <= steps; i++) {
                const settled = easeTrip(i / steps);
                const loose =
                    i === 0 || i === steps
                        ? settled
                        : settled +
                          ((Math.random() * 2 - 1) * HOP_VARY) / steps;
                marks.push(from + dist * loose);
            }

            // The inline transform is set first, so no animation needs `fill: forwards`.
            for (let i = 1; i <= steps; i++) {
                const a = marks[i - 1];
                const b = marks[i];
                const ms = vary(HOP_MS, HOP_VARY);
                // Bigger leap, bigger arc; uncoupled, short hops look like bouncing in place.
                const reach = Math.min(Math.abs(b - a) / HOP_LEN, 1.3);
                const lift = vary(HOP_LIFT * (0.8 + 0.2 * reach), HOP_VARY);
                travel.style.transform = `translate3d(${b}px,0,0)`;
                await play(travel.animate(arc(a, b, lift), { duration: ms }), ms);
                x = b;
                await settle(beat());
            }
            x = to;
        }

        // Absorb the landing over the whole beat; an empty pause reads as dropped
        // frames.
        function settle(ms: number) {
            return play(
                bird.animate(
                    [
                        // Starts upright, where the hop left it.
                        {
                            transform: `scaleX(${face}) scaleY(1)`,
                            easing: "ease-out",
                        },
                        {
                            transform: `scaleX(${face * 1.05}) scaleY(0.92)`,
                            offset: 0.28,
                            easing: "ease-out",
                        },
                        {
                            transform: `scaleX(${face * 0.995}) scaleY(1.015)`,
                            offset: 0.62,
                        },
                        { transform: `scaleX(${face}) scaleY(1)` },
                    ],
                    { duration: ms, easing: "ease-out" },
                ),
                ms,
            );
        }

        function peckOnce() {
            // The mirror flips the rotation too, so no sign flip is needed.
            return play(
                bird.animate(
                    [
                        { transform: `scaleX(${face}) rotate(0deg)` },
                        {
                            transform: `scaleX(${face}) rotate(${PECK_DEG}deg)`,
                            offset: 0.5,
                        },
                        { transform: `scaleX(${face}) rotate(0deg)` },
                    ],
                    { duration: PECK_MS, easing: "ease-in-out" },
                ),
                PECK_MS,
            );
        }

        function eat(el: HTMLElement) {
            el.classList.add("is-eaten");
            setTimeout(() => {
                el.classList.remove("is-out", "is-eaten");
                delete el.dataset.active;
            }, 180);
        }

        async function peckAndEat(el: HTMLElement) {
            const landAt = Number(el.dataset.landAt ?? 0);
            await wait(Math.max(0, landAt - performance.now()));

            if (reduce.matches) {
                eat(el);
            } else {
                await peckOnce();
                const second = peckOnce();
                await wait(PECK_MS / 2); // the crumb goes at the bottom of the second peck
                eat(el);
                await second;
            }

            bird.classList.add("is-eating");
            await wait(YUM_MS);
            bird.classList.remove("is-eating");
        }

        async function run() {
            if (busy) return;
            busy = true;
            // Takes over the expression: Bird.astro's click handler ignores .is-feeding.
            bird.classList.add("is-feeding");
            bird.classList.remove("is-startled", "is-angry");
            try {
                while (queue.length) {
                    // Re-sorted each time, so crumbs dropped mid-run join the round.
                    queue.sort(
                        (a, b) =>
                            Math.abs(crumbX(a) - center()) -
                            Math.abs(crumbX(b) - center()),
                    );
                    const el = queue.shift()!;
                    const cx = crumbX(el);
                    const dir = cx >= center() ? 1 : -1;
                    setFace(dir);
                    const anchor = dir === 1 ? REACH : 1 - REACH;
                    await hopTo(
                        clamp(
                            cx - anchor * birdW(),
                            0,
                            Math.max(field.clientWidth - birdW(), 0),
                        ),
                    );
                    await peckAndEat(el);
                }
                if (x > 0) setFace(-1); // turn around rather than moonwalk
                await hopTo(0);
                setFace(1);
            } catch {
                // An animation was cancelled mid-flight; leave the bird where
                // it stands rather than fighting for it.
            } finally {
                busy = false;
                bird.classList.remove("is-feeding");
            }
        }

        // Mouse only: a touch point has no tip to hang it off.
        if (carry) {
            const follow = (event: PointerEvent) => {
                if (event.pointerType !== "mouse") return;
                // Read per move: an entrance animation may still be shifting the feeder.
                const rect = field.getBoundingClientRect();
                carry.style.transform = `translate3d(${event.clientX - rect.left + CARRY_DX}px,${event.clientY - rect.top + CARRY_DY}px,0) rotate(${CARRY_TILT}deg)`;
                carry.classList.add("is-carried");
            };
            field.addEventListener("pointerenter", follow);
            field.addEventListener("pointermove", follow);
            field.addEventListener("pointerleave", () =>
                carry.classList.remove("is-carried"),
            );
        }

        field.addEventListener("click", (event) => {
            const el = takeCrumb();
            if (!el) return;

            carry?.classList.remove("is-carried");

            const rect = field.getBoundingClientRect();
            if (!rect.width) return;
            const px = clamp(event.clientX - rect.left, 4, rect.width - 4);
            const py = clamp(event.clientY - rect.top, 0, rect.height);

            el.style.setProperty("--x", `${(px / rect.width) * 100}%`);
            el.style.setProperty(
                "--drop",
                `${Math.max(rect.height - py, MIN_DROP)}px`,
            );
            el.dataset.active = "true";
            el.dataset.landAt = String(
                performance.now() + (reduce.matches ? 0 : FALL_MS),
            );

            el.classList.remove("is-out", "is-eaten");
            void el.offsetWidth;
            el.classList.add("is-out");

            queue.push(el);
            run();
        });
    }

    function initFeeders() {
        const feeders =
            document.querySelectorAll<HTMLElement>("[data-feeder]");
        for (const feeder of feeders) {
            if (feeder.dataset.initialized) continue;

            const field = feeder.querySelector<HTMLElement>(
                "[data-feeder-field]",
            );
            const travel = feeder.querySelector<HTMLElement>(
                "[data-feeder-bird]",
            );
            const bird = travel?.querySelector<HTMLElement>(".bird");
            if (!field || !travel || !bird) continue;

            feeder.dataset.initialized = "true";
            attach(
                field,
                travel,
                bird,
                [...feeder.querySelectorAll<HTMLElement>("[data-crumb]")],
                feeder.querySelector<HTMLElement>("[data-cursor-crumb]"),
            );
        }
    }

    initFeeders();
    document.addEventListener("astro:page-load", initFeeders);
</script>

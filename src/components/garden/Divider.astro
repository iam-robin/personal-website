---
interface Props {
    isBlack?: boolean;
    class?: string;
}

const { isBlack, class: className = "" } = Astro.props;
---

{/* 204 literal hyphens: hidden from assistive tech and selection. */}
<div
    aria-hidden="true"
    class:list={[
        "w-full select-none overflow-hidden font-mono tracking-widest whitespace-nowrap text-clip",
        isBlack ? "text-black" : "text-black/20",
        className,
    ]}
>
    ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
</div>

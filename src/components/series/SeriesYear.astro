---
import LogYear from "../ui/LogYear.astro";
import LogRow from "../ui/LogRow.astro";
import type { SeasonYear } from "../../utils/series";
import { formatShortDate } from "../../utils/dates";
import { getMediaNoteLookup } from "../../utils/garden";

interface Props {
    year: SeasonYear;
}

const { year } = Astro.props;

// Finished only: the season in progress hasn't been watched yet.
const count = year.seasons.filter((season) => !season.watching).length;

const noteFor = await getMediaNoteLookup("series");
---

<LogYear label={year.label} count={count} noun="season">
    {
        year.seasons.map((season) => (
            <LogRow
                title={season.title}
                chip={season.season && `S${season.season}`}
                favourite={season.favourite}
                rating={season.watching ? null : season.rating}
                date={season.watching ? "" : formatShortDate(season.finished)}
                meta={season.watching ? "Watching" : ""}
                cover={season.cover}
                note={noteFor(season.title)}
            />
        ))
    }
</LogYear>

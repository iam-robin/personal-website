---
/**
 * The post's Mastodon thread, mirrored at build time. No `mastodonId`, no
 * section. Sanitizing and filtering happen in utils/mastodon.ts.
 */
import { getMastodonThread } from "../../utils/mastodon";
import { Icon } from "astro-icon/components";
import Link from "../ui/Link.astro";
import MastodonReply from "./MastodonReply.astro";

interface Props {
    mastodonId?: string;
}

const { mastodonId } = Astro.props;

const thread = await getMastodonThread(mastodonId);

/* An unreachable API looks like a thread without replies, on purpose: the
   link is built from the id and still works. */
const hasReplies = thread !== null && thread.branches.length > 0;

/* Counts what's on the page. `replies_count` only counts direct replies. */
const shownCount = thread
    ? thread.branches.reduce((total, b) => total + 1 + b.children.length, 0)
    : 0;
---

{/* Same card as AiDisclosure: muted text after footnotes gets skimmed past. */}
{
    thread && (
        <section
            aria-labelledby="mastodon-replies"
            class="mt-16 rounded-lg border border-dotted border-ink/25 bg-inset/60 px-6 py-5"
        >
            {hasReplies ? (
                /* Folded by default: a long thread stands between the reader and the end of
                   the post. */
                <details class="replies">
                    {/* <summary> takes phrasing content or one heading, not both. */}
                    {/* py-3 grows the tap target past 24px; -my-3 keeps the layout unchanged. */}
                    <summary class="-my-3 cursor-pointer py-3">
                        <h2 class="flex items-center gap-2 font-mono text-xs font-bold tracking-wide transition-colors hover:text-ink-muted">
                            <span aria-hidden="true" class="caret inline-block">
                                ›
                            </span>
                            <span aria-hidden="true" class="inline-flex">
                                <Icon name="ph:mastodon-logo-bold" size={16} />
                            </span>
                            <span id="mastodon-replies">
                                Replies ({shownCount})
                            </span>
                        </h2>
                    </summary>

                    <ul class="mt-9 flex flex-col gap-8">
                        {thread.branches.map((reply) => (
                            <li>
                                <MastodonReply reply={reply} showAcct />

                                {reply.children.length > 0 && (
                                    /* One level only; the threads run four deep. */
                                    <ul class="mt-6 flex flex-col gap-6 border-l border-dotted border-ink/30 pl-4">
                                        {reply.children.map((child) => (
                                            <li>
                                                <MastodonReply reply={child} />
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))}
                    </ul>

                    <p class="mt-10 font-mono text-sm text-ink-muted">
                        {thread.hiddenCount > 0 && (
                            <>
                                {thread.hiddenCount} more{" "}
                                {thread.hiddenCount === 1 ? "reply" : "replies"}{" "}
                                over there.{" "}
                            </>
                        )}
                        <Link href={thread.url} external class="text-sm">
                            Join in on Mastodon
                        </Link>
                    </p>
                </details>
            ) : (
                <>
                    <h2
                        id="mastodon-replies"
                        class="flex items-center gap-2 font-mono text-xs font-bold tracking-wide"
                    >
                        <span aria-hidden="true" class="inline-flex">
                            <Icon name="ph:mastodon-logo-bold" size={16} />
                        </span>
                        Join in
                    </h2>
                    <p class="mt-4 text-sm text-ink-muted">
                        This one's over on Mastodon too. That's where I'd love
                        to hear what you make of it.{" "}
                        <Link href={thread.url} external class="text-sm">
                            Reply on Mastodon
                        </Link>
                    </p>
                </>
            )}
        </section>
    )
}

<style>
    .replies > summary {
        list-style: none;
    }
    .replies > summary::-webkit-details-marker {
        display: none;
    }

    .caret {
        transition: transform 150ms ease;
    }
    .replies[open] > summary .caret {
        transform: rotate(90deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .caret {
            transition: none;
        }
    }
</style>

<style is:global>
    /* Reply HTML comes through set:html, so this has to be global CSS. */

    /* One long URL would prise the min-w-0 column open. `anywhere`, because
       `break-word` won't break a token alone on its line. */
    .mastodon-reply {
        overflow-wrap: anywhere;
    }

    .mastodon-reply p + p {
        margin-top: 0.75em;
    }

    .mastodon-reply a {
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .mastodon-reply a:hover {
        text-decoration: none;
    }

    .mastodon-reply pre {
        overflow-x: auto;
    }

    .mastodon-reply blockquote {
        border-left: 1px dotted var(--color-ink);
        padding-left: 0.75rem;
    }
</style>

---
import { categorySlug, categoryLabel } from "../../utils/blog";
import FilterBar from "../ui/FilterBar.astro";
import FilterTag from "../ui/FilterTag.astro";

interface Props {
    categories: string[];
    active?: string | null;
}

const { categories, active = null } = Astro.props;
---

<FilterBar>
    <FilterTag href="/blog" active={active === null}>All</FilterTag>
    {
        categories.map((category) => (
            <FilterTag
                href={`/blog/category/${categorySlug(category)}`}
                active={active === category}
            >
                {categoryLabel(category)}
            </FilterTag>
        ))
    }
</FilterBar>

---
import { categorySlug, categoryLabel } from "../../utils/blog";
import FilterBar from "../ui/FilterBar.astro";
import FilterTag from "../ui/FilterTag.astro";

interface Props {
    categories: string[];
    active?: string | null;
}

const { categories, active = null } = Astro.props;
---

<FilterBar items={categories} isActive={(category) => category === active}>
    <FilterTag slot="lead" href="/blog" active={active === null}>All</FilterTag>
    {
        (category: string) => (
            <FilterTag
                href={`/blog/category/${categorySlug(category)}`}
                active={active === category}
            >
                {categoryLabel(category)}
            </FilterTag>
        )
    }
</FilterBar>

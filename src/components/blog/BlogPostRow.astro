---
/**
 * One blog post as a list row: date · title · Read →. Shared by the
 * homepage teaser and the /blog index. `showYear` off drops the year
 * from the date (used when the index groups rows under a year heading).
 */
import type { CollectionEntry } from "astro:content";
import { categoryLabel } from "../../utils/blog";
import InkMark from "../ui/InkMark.astro";

interface Props {
    post: CollectionEntry<"blog">;
    showYear?: boolean;
    showCategory?: boolean;
}

const { post, showYear = true, showCategory = false } = Astro.props;

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", {
        month: "short",
        day: "2-digit",
        ...(showYear ? { year: "numeric" } : {}),
    });
---

<a
    href={`/blog/${post.id}`}
    class="ink-row flex items-start gap-4 py-5 font-mono"
>
    <InkMark name="post" class="ink-row-mark mt-px h-5 w-5 shrink-0" />
    <span class="shrink-0 whitespace-nowrap text-sm opacity-40">
        {formatDate(post.data.date)}
    </span>
    <span class="ink-row-title min-w-0 flex-1 text-base">
        {post.data.title}
    </span>
    {
        showCategory && post.data.category && (
            <span class="hidden shrink-0 text-sm opacity-40 sm:inline">
                {categoryLabel(post.data.category)}
            </span>
        )
    }
    <span class="ink-row-meta shrink-0 text-base" aria-hidden="true">
        →
    </span>
</a>

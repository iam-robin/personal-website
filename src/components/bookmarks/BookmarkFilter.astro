---
import { tagSlug } from "../../utils/bookmarks";
import FilterBar from "../ui/FilterBar.astro";
import FilterTag from "../ui/FilterTag.astro";

interface Props {
    tags: { name: string; count: number }[];
    total: number;
    active?: string | null;
}

const { tags, total, active = null } = Astro.props;
---

<FilterBar items={tags} isActive={(tag) => tag.name === active}>
    <FilterTag slot="lead" href="/bookmarks" active={active === null} count={total}>
        All
    </FilterTag>
    {
        (tag: Props["tags"][number]) => (
            <FilterTag
                href={`/bookmarks/tag/${tagSlug(tag.name)}`}
                active={active === tag.name}
                count={tag.count}
            >
                #{tag.name}
            </FilterTag>
        )
    }
</FilterBar>

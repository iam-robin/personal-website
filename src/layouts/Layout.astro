---
import "../styles/global.css";
import { getPaperKey, papers } from "../utils/paper";

interface Props {
    title: string;
    description?: string;
    /**
     * Site-root-relative path, e.g. "/og/blog/my-post.png". Defaults to the
     * shared card.
     */
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    noindex?: boolean;
    structuredData?: unknown;
}

const DEFAULT_DESCRIPTION =
    "Robin Spielmann — a design engineer at the intersection of code, design and art. My own little space on the internet.";

const {
    title,
    description = DEFAULT_DESCRIPTION,
    ogImage: ogImagePath,
    ogImageAlt = "Robin Spielmann — Design Engineer",
    ogType = "website",
    noindex = false,
    structuredData,
} = Astro.props;

/* Built against `site`, not the request origin: on the Node adapter a preview
   or health-check host would leak into the canonical and og:image. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* Every card is 1200x630. Several scrapers trust the width/height below over
   the file, so change them together. */
const ogImage = new URL(ogImagePath ?? "/opengraph.png", Astro.site).href;

/* Resolved from the URL. The inline custom properties are the mechanism;
   `data-paper` is only a DevTools hook. */
const paperKey = getPaperKey(Astro.url.pathname);
const paper = papers[paperKey];

const serializedStructuredData = structuredData
    ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
    : null;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />

        <!-- SVG first: the robin that inverts with the colour scheme. -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <link
            rel="preload"
            href="/fonts/apercu-regular-pro.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/apercu-bold-pro.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/fira-mono-v14-latin-regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content={paper.hex} />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, follow" />}

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="iamrobin" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        {
            serializedStructuredData && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={serializedStructuredData}
                />
            )
        }

        <!-- Self-hosted Umami, same site id as v3. data-domains matches the hostname
             exactly, so www is listed separately. -->
        <script
            defer
            src="https://umami.iamrob.in/script.js"
            data-website-id="9e274244-e311-4ebe-8ff0-c691ce080455"></script>

        <link
            rel="alternate"
            type="application/rss+xml"
            title="iamrobin — Blog"
            href="/blog-rss.xml"
        />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="iamrobin — Bookmarks"
            href="/bookmarks-rss.xml"
        />
    </head>
    <body
        data-paper={paperKey}
        style={`--paper: ${paper.hex}; --surface: ${paper.surface}; --inset: ${paper.inset}`}
    >
        <slot />
    </body>
</html>

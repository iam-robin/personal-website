---
/**
 * One reading column, optionally with a sticky rail. The tracks add up to
 * --container-shell (see theme/layout.css).
 */
import SubpageLayout from "./SubpageLayout.astro";

interface Props {
    title: string;
    description?: string;
    documentTitle?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    structuredData?: unknown;
    /**
     * A prop, not `Astro.slots.has("rail")`: a conditional slot still counts as
     * present and leaves an empty gutter.
     */
    rail?: boolean;
}

const {
    title,
    description,
    documentTitle,
    ogImage,
    ogImageAlt,
    ogType,
    structuredData,
    rail = false,
} = Astro.props;
---

<SubpageLayout
    title={title}
    description={description}
    documentTitle={documentTitle}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    ogType={ogType}
    structuredData={structuredData}
    hideHero
>
    <div
        class:list={[
            "mx-auto w-full max-w-reading",
            // Don't centre the grid — that reintroduces a gutter the header
            // doesn't have.
            rail && "lg:max-w-none lg:grid-rail",
        ]}
    >
        {
            rail && (
                <aside class="hidden lg:block">
                    {/* Stretches to the row's height so the inner element can stick. No self-start. */}
                    <div class="sticky top-8 flex flex-col gap-8">
                        <slot name="rail" />
                    </div>
                </aside>
            )
        }

        {/* @container here, so the type scale follows the reading column while the rail
            resolves against the shell. min-w-0 keeps wide code or tables from prising
            the track open. */}
        <div class="@container min-w-0">
            <slot />
        </div>
    </div>
</SubpageLayout>

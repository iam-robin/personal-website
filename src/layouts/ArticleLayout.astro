---
/**
 * The article construct: one reading column, optionally with a sticky rail to
 * its left. Used by blog posts and /work, which skip the shared subpage hero
 * and open with their own words.
 *
 * The two tracks add up to the shell's content width, so the rail starts under
 * the logo and the column ends under the RSS icon. --container-shell is
 * derived from those tracks in theme/layout.css, so it can't drift.
 *
 * Set `rail` and fill the `rail` slot for the sidebar; omit both for a plain
 * centred column.
 */
import SubpageLayout from "./SubpageLayout.astro";

interface Props {
    title: string;
    description?: string;
    /** Override the <title> tag; defaults to "<title> — Robin Spielmann". */
    documentTitle?: string;
    /** This page's own link preview card. See Layout.astro. */
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    /**
     * Show the sticky sidebar. A prop and not `Astro.slots.has("rail")`: a
     * conditionally-rendered slot still registers as present when the
     * condition is false, leaving an empty 16rem gutter.
     */
    rail?: boolean;
}

const {
    title,
    description,
    documentTitle,
    ogImage,
    ogImageAlt,
    ogType,
    rail = false,
} = Astro.props;
---

<SubpageLayout
    title={title}
    description={description}
    documentTitle={documentTitle}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    ogType={ogType}
    hideHero
>
    <div
        class:list={[
            "mx-auto w-full max-w-reading",
            // Don't centre the grid — that reintroduces a gutter the header
            // doesn't have.
            rail && "lg:max-w-none lg:grid-rail",
        ]}
    >
        {
            rail && (
                <aside class="hidden lg:block">
                    {/* The aside stretches to the grid row's full height,
                        which is what gives the inner element something to
                        stick against. Don't add self-start. */}
                    <div class="sticky top-8 flex flex-col gap-8">
                        <slot name="rail" />
                    </div>
                </aside>
            )
        }

        {/* `@container` calibrates the fluid type scale to the reading column
            rather than the whole shell, so headings stay in proportion to the
            text. It belongs here and not on the wrapper above: the rail is
            meant to keep resolving against the shell, the way the rest of the
            page chrome does.

            `min-w-0` stops a long code line or a wide table from prising the
            42rem track open and pulling the column out of line with the
            header. */}
        <div class="@container min-w-0">
            <slot />
        </div>
    </div>
</SubpageLayout>

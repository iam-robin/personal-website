---
/**
 * Shell for every subpage. Wide on purpose, for lists and grids; long-form
 * content uses ArticleLayout.
 */
import Layout from "./Layout.astro";
import Nav from "../components/ui/Nav.astro";
import Footer from "../components/ui/Footer.astro";
import RssDropdown from "../components/ui/RssDropdown.astro";
import MobileMenu from "../components/ui/MobileMenu.astro";
import Bird from "../components/Bird.astro";

interface Props {
    title: string;
    description?: string;
    documentTitle?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    hideHero?: boolean;
    noindex?: boolean;
    structuredData?: unknown;
}

const {
    title,
    description,
    documentTitle,
    ogImage,
    ogImageAlt,
    ogType,
    hideHero = false,
    noindex = false,
    structuredData,
} = Astro.props;
---

<Layout
    title={documentTitle ?? `${title} — Robin Spielmann`}
    description={description}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    ogType={ogType}
    noindex={noindex}
    structuredData={structuredData}
>
    <div
        class="@container mx-auto flex min-h-dvh max-w-shell flex-col px-gutter py-8"
    >
        <!-- Auto-width middle column so the nav never wraps. -->
        <header class="grid grid-cols-[1fr_auto_1fr] items-center gap-4">
            <a
                href="/"
                aria-label="Back to homepage"
                class="justify-self-start"
            >
                <Bird class="h-8 w-auto text-ink" interactive={false} />
            </a>
            <Nav class="justify-self-center" />
            <!-- col-start-3 keeps the icons right when the nav is hidden on mobile. -->
            <div class="col-start-3 flex items-center justify-self-end">
                <RssDropdown />
            </div>
        </header>

        {
            !hideHero && (
                <div class="mt-24 grid grid-cols-1 gap-x-12 gap-y-6 md:grid-cols-5">
                    <div class="flex flex-col items-start gap-10 md:col-span-2">
                        <h1 class="text-3xl font-bold">{title}</h1>
                        <slot name="cta" />
                    </div>
                    {(description || Astro.slots.has("description")) && (
                        <p class="font-mono text-base md:col-span-3 md:pt-2">
                            <slot name="description">{description}</slot>
                        </p>
                    )}
                </div>
            )
        }

        <main class:list={["flex-1", hideHero ? "mt-10 md:mt-16" : "mt-16"]}>
            <slot />
        </main>
        {/* Twice the pages' `gap-24` rhythm, or the footer reads as another section. */}
        <Footer class="mt-48" />
        <MobileMenu />
    </div>
</Layout>

---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Link from "../../components/ui/Link.astro";
import SectionRail from "../../components/ui/SectionRail.astro";
import AiDisclosure from "../../components/blog/AiDisclosure.astro";
import MastodonComments from "../../components/blog/MastodonComments.astro";
import { categoryLabel, getTocHeadings } from "../../utils/blog";
import { getMastodonThread } from "../../utils/mastodon";
import "../../styles/markdown.css";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
const category = post.data.category ? categoryLabel(post.data.category) : null;

/* Shares the build's single fetch per toot with MastodonComments below —
   utils/mastodon memoises on the status id, so asking again here costs no
   extra request.

   Nothing is shown at zero: a post nobody has favourited yet shouldn't say so,
   and `favourites` is also null when the API was unreachable. Both cases
   collapse to the same "just don't mention it". */
const thread = await getMastodonThread(post.data.mastodonId);
const favourites = thread?.favourites ?? 0;
const likes = favourites
    ? `${favourites} ${favourites === 1 ? "like" : "likes"}`
    : null;

const meta = [formattedDate, category, likes].filter(Boolean).join(" · ");

const sections = getTocHeadings(headings).map((heading) => ({
    id: heading.slug,
    text: heading.text,
    nested: heading.depth === 3,
}));

// Without a contents list the rail would be a permanently empty gutter.
const showRail = sections.length >= 2;

/* Generated by src/pages/og/blog/[slug].png.ts from this post's own title,
   unless the post brings a hand-made card of its own. */
const ogImage = post.data.ogImage ?? `/og/blog/${post.id}.png`;
---

{
    /* From `lg` up a sticky rail holds the contents list; below that the
  collapsed inline version takes over. The column and the rail grid come
  from ArticleLayout — passing the `rail` slot turns the sidebar on.

  `description` before `subtitle`: ArticleLayout hides the hero, so that prop
  only feeds the meta tag and og:description, and a subtitle is written to
  follow the title ("and Where It's Made") — on its own in a search result or
  a link preview it reads as a fragment. */
}
<ArticleLayout
    title={post.data.title}
    description={post.data.description ?? post.data.subtitle}
    documentTitle={`${post.data.title} — Robin Spielmann`}
    ogImage={ogImage}
    ogImageAlt={`${post.data.title} — a post on iamrob.in`}
    ogType="article"
    rail={showRail}
>
    {
        showRail && (
            <Fragment slot="rail">
                <SectionRail sections={sections} variant="rail" />
                {/* Date and category stack rather than joining with a "·" —
                    at 13rem the joined form wraps mid-line. */}
                <div class="font-mono text-xs text-ink-muted">
                    <p>{formattedDate}</p>
                    {category && <p class="mt-1">{category}</p>}
                    {likes && <p class="mt-1">{likes}</p>}
                </div>
            </Fragment>
        )
    }

    <article>
        <header>
            <h1 class="text-balance text-2xl font-bold">{post.data.title}</h1>
            {
                post.data.subtitle && (
                    /* Close to the title: it finishes the sentence the title
                       starts, so it belongs to that block and not to the
                       chrome underneath. */
                    <p class="mt-3 font-mono text-base text-ink-muted">
                        {post.data.subtitle}
                    </p>
                )
            }

            {
                /* Date, category and the contents list are both chrome for the
                same article, so they sit in one tight group with a clear step
                away from the title block above and the prose below. Loose and
                evenly spaced, the way they were, each line floated on its own
                and the header dissolved downwards on a narrow screen.

                Hidden as a whole once the rail carries the same two things —
                on the children it would leave the group's own top margin
                behind as a gap on wide screens. */
            }
            <div
                class:list={[
                    "mt-8 flex flex-col items-start gap-2",
                    showRail && "lg:hidden",
                ]}
            >
                <p class="font-mono text-xs text-ink-muted">{meta}</p>
                {/* gap-2 plus the summary's own 8px of hit-area padding is the
                    16px this group is spaced at; `-mb-2` takes the matching
                    padding below back out again. */}
                <SectionRail sections={sections} class="-mb-2" />
            </div>
        </header>

        {
            post.data.image && (
                <Image
                    src={post.data.image}
                    alt=""
                    widths={[672, 1344]}
                    sizes="(min-width: 672px) 672px, 100vw"
                    loading="eager"
                    fetchpriority="high"
                    class="mt-12 w-full rounded-lg outline outline-1 -outline-offset-1 outline-black/10"
                />
            )
        }

        <div class="blog-prose mt-12">
            <Content />
        </div>

        {post.data.aiDisclosure && <AiDisclosure />}

        <MastodonComments mastodonId={post.data.mastodonId} />

        <footer class="mt-24">
            <Link href="/blog" class="text-sm">← All posts</Link>
        </footer>
    </article>
</ArticleLayout>

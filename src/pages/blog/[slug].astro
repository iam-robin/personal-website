---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Link from "../../components/ui/Link.astro";
import SectionRail from "../../components/ui/SectionRail.astro";
import AiDisclosure from "../../components/blog/AiDisclosure.astro";
import MastodonComments from "../../components/blog/MastodonComments.astro";
import { categoryLabel, getTocHeadings } from "../../utils/blog";
import { getMastodonThread } from "../../utils/mastodon";
import {
    blogPostingSchema,
    graphSchema,
    personSchema,
    websiteSchema,
} from "../../utils/schema";
import "../../styles/markdown.css";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
const category = post.data.category ? categoryLabel(post.data.category) : null;

/* Memoised per toot, so this costs no extra request. Nothing shown at zero,
   which also covers an unreachable API (null). */
const thread = await getMastodonThread(post.data.mastodonId);
const favourites = thread?.favourites ?? 0;
const likes = favourites
    ? `${favourites} ${favourites === 1 ? "like" : "likes"}`
    : null;

const meta = [formattedDate, category, likes].filter(Boolean).join(" · ");

const sections = getTocHeadings(headings).map((heading) => ({
    id: heading.slug,
    text: heading.text,
    nested: heading.depth === 3,
}));

const showRail = sections.length >= 2;

const ogImage = post.data.ogImage ?? `/og/blog/${post.id}.png`;
const description = post.data.description ?? post.data.subtitle;
const structuredData = graphSchema([
    personSchema,
    websiteSchema,
    blogPostingSchema({
        url: new URL(Astro.url.pathname, Astro.site).href,
        title: post.data.title,
        description,
        image: new URL(ogImage, Astro.site).href,
        datePublished: post.data.date,
        keywords: post.data.category ? [categoryLabel(post.data.category)] : undefined,
    }),
]);
---

{/* `description` before `subtitle`: with the hero hidden it only feeds meta
    tags, and a subtitle reads as a fragment on its own. */}
<ArticleLayout
    title={post.data.title}
    description={description}
    documentTitle={`${post.data.title} — Robin Spielmann`}
    ogImage={ogImage}
    ogImageAlt={`${post.data.title} — a post on iamrob.in`}
    ogType="article"
    structuredData={structuredData}
    rail={showRail}
>
    {
        showRail && (
            <Fragment slot="rail">
                <SectionRail sections={sections} variant="rail" />
                {/* Stacked, not joined with a dot: at 13rem the joined form wraps. */}
                <div class="font-mono text-xs text-ink-muted">
                    <p>{formattedDate}</p>
                    {category && <p class="mt-1">{category}</p>}
                    {likes && <p class="mt-1">{likes}</p>}
                </div>
            </Fragment>
        )
    }

    <article>
        <header>
            <h1 class="text-balance text-2xl font-bold">{post.data.title}</h1>
            {
                post.data.subtitle && (
                    <p class="mt-3 font-mono text-base text-ink-muted">
                        {post.data.subtitle}
                    </p>
                )
            }

            {/* Hidden as a whole once the rail carries the same things; hiding the
                children would leave the group's margin behind. */}
            <div
                class:list={[
                    "mt-8 flex flex-col items-start gap-2",
                    showRail && "lg:hidden",
                ]}
            >
                <p class="font-mono text-xs text-ink-muted">{meta}</p>
                {/* gap-2 plus the summary's 8px hit-area padding makes the group's 16px;
                    -mb-2 takes the padding back out below. */}
                <SectionRail sections={sections} class="-mb-2" />
            </div>
        </header>

        {
            post.data.image && (
                <Image
                    src={post.data.image}
                    alt=""
                    widths={[672, 1344]}
                    sizes="(min-width: 672px) 672px, 100vw"
                    loading="eager"
                    fetchpriority="high"
                    class="mt-12 w-full rounded-lg outline outline-1 -outline-offset-1 outline-black/10"
                />
            )
        }

        <div class="blog-prose mt-12">
            <Content />
        </div>

        {post.data.aiDisclosure && <AiDisclosure />}

        <MastodonComments mastodonId={post.data.mastodonId} />

        <footer class="mt-24">
            <Link href="/blog" class="text-sm">← All posts</Link>
        </footer>
    </article>
</ArticleLayout>

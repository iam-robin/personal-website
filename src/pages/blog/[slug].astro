---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Link from "../../components/ui/Link.astro";
import SectionRail from "../../components/ui/SectionRail.astro";
import { categoryLabel, getTocHeadings } from "../../utils/blog";
import "../../styles/markdown.css";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
const category = post.data.category ? categoryLabel(post.data.category) : null;
const meta = [formattedDate, category].filter(Boolean).join(" · ");

const sections = getTocHeadings(headings).map((heading) => ({
    id: heading.slug,
    text: heading.text,
    nested: heading.depth === 3,
}));

// Without a contents list the rail would be a permanently empty gutter.
const showRail = sections.length >= 2;
---

{/* From `lg` up a sticky rail holds the contents list; below that the
  collapsed inline version takes over. The column and the rail grid come
  from ArticleLayout — passing the `rail` slot turns the sidebar on.

  `description` before `subtitle`: ArticleLayout hides the hero, so that prop
  only feeds the meta tag and og:description, and a subtitle is written to
  follow the title ("and Where It's Made") — on its own in a search result or
  a link preview it reads as a fragment. */}
<ArticleLayout
    title={post.data.title}
    description={post.data.description ?? post.data.subtitle}
    documentTitle={`${post.data.title} — Robin Spielmann`}
    rail={showRail}
>
    {
        showRail && (
            <Fragment slot="rail">
                <SectionRail sections={sections} variant="rail" />
                {/* Date and category stack rather than joining with a "·" —
                    at 13rem the joined form wraps mid-line. */}
                <div class="font-mono text-xs opacity-50">
                    <p>{formattedDate}</p>
                    {category && <p class="mt-1">{category}</p>}
                </div>
            </Fragment>
        )
    }

    <article>
        <header>
            <h1 class="text-2xl font-bold">{post.data.title}</h1>
            {
                post.data.subtitle && (
                    <p class="mt-4 font-mono text-base opacity-60">
                        {post.data.subtitle}
                    </p>
                )
            }
            {/* Steps aside once the rail is carrying it */}
            <p
                class:list={[
                    "mt-6 font-mono text-sm opacity-40",
                    showRail && "lg:hidden",
                ]}
            >
                {meta}
            </p>
        </header>

        {
            post.data.image && (
                <Image
                    src={post.data.image}
                    alt=""
                    widths={[672, 1344]}
                    sizes="(min-width: 672px) 672px, 100vw"
                    class="mt-12 w-full rounded-lg"
                />
            )
        }

        {/* Steps aside once the rail is carrying the same list */}
        <SectionRail
            sections={sections}
            class={showRail ? "mt-12 lg:hidden" : "mt-12"}
        />

        <div class="blog-prose mt-12">
            <Content />
        </div>

        <footer class="mt-24">
            <Link href="/blog" class="text-sm">← All posts</Link>
        </footer>
    </article>
</ArticleLayout>

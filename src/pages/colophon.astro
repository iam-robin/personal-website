---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import Bird from "../components/Bird.astro";
import Bird404 from "../components/Bird404.astro";
import { timeSince } from "../utils/timeSince";
import { changelog } from "../data/changelog";
import { papers } from "../utils/paper";

const latest = changelog[0];

// The swatches use bg-ink/bg-paper/bg-surface, so they render *this* page's
// stock. Two labels therefore describe how the value is derived rather than
// quoting a hex the swatch beside them would contradict.
const colors = [
    {
        name: "--color-ink",
        value: "#1a1919",
        role: "Text & foreground",
        swatch: "bg-ink",
    },
    {
        name: "--color-paper",
        value: papers.meta.hex + " on this page",
        role: "Page background — one stock per section",
        swatch: "bg-paper",
    },
    {
        name: "--color-surface",
        value: "ink 10% over paper",
        role: "Cards & surfaces — derived",
        swatch: "bg-surface",
    },
];

// Read from the same map the pages use, so the list can't drift.
const stocks = Object.values(papers);

const typefaces = [
    {
        token: "font-sans",
        name: "Apercu",
        role: "Headlines & interface",
        foundry: "Colophon Foundry",
        cls: "font-sans",
        sample: "The quick brown fox jumps over the lazy dog",
    },
    {
        token: "font-mono",
        name: "Fira Mono",
        role: "Body copy & labels",
        foundry: "Carrois · Mozilla",
        cls: "font-mono",
        sample: "The quick brown fox jumps over the lazy dog",
    },
    {
        token: "font-decorative",
        name: "LiebeHeide",
        role: "Handwritten accents",
        foundry: "LiebeFonts",
        cls: "font-decorative",
        sample: "The quick brown fox jumps over the lazy dog",
    },
];

const typeScale = [
    { cls: "text-4xl", token: "text-4xl" },
    { cls: "text-3xl", token: "text-3xl" },
    { cls: "text-2xl", token: "text-2xl" },
    { cls: "text-xl", token: "text-xl" },
    { cls: "text-lg", token: "text-lg" },
    { cls: "text-md", token: "text-md" },
    { cls: "text-base", token: "text-base" },
    { cls: "text-sm", token: "text-sm" },
    { cls: "text-xs", token: "text-xs" },
];

// Every mood is its own specimen, hover included — one box can't show the
// logo at rest and change under the cursor.
const birds = [
    { label: "Resting", note: "The logo", cls: "" },
    { label: "Curious", note: "On hover", cls: "is-hovered" },
    { label: "Happy", note: "One click", cls: "is-clicked" },
    { label: "Angry", note: "Three clicks", cls: "is-angry" },
    // The note is the whole clue on purpose.
    { label: "Smitten", note: "Fed a crumb", cls: "is-eating" },
];
---

<SubpageLayout
    title="Colophon"
    description="The pieces this site is built from — colours, type, and the robin. A reference for how it's put together."
>
    <div class="flex flex-col gap-24">
        <!-- Colours -->
        <section>
            <h2
                class="mb-8 font-mono text-xs tracking-widest text-ink-muted uppercase"
            >
                Colours
            </h2>
            <p class="mb-8 max-w-xl font-mono text-sm">
                Three tokens. Ink never moves. The paper changes per section,
                and the surface is mixed from whatever paper it lands on — so
                every card, hairline and code chip follows the room it's in.
            </p>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                {
                    colors.map((c) => (
                        <div class="flex flex-col gap-3">
                            <div
                                class:list={[
                                    "aspect-[4/3] w-full rounded-md border border-ink/10",
                                    c.swatch,
                                ]}
                            />
                            <div class="font-mono text-sm">
                                <div>{c.role}</div>
                                <div class="text-ink-muted">{c.name}</div>
                                <div class="text-ink-muted">{c.value}</div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <p class="mt-12 mb-6 max-w-xl font-mono text-sm">
                The stocks. The tinted ones sit at the same lightness and the
                same chroma — only the hue moves — so no section shouts louder
                than another. Home, the garden and the postcards keep the blank
                one. Home because colour should mean you've gone somewhere, and
                the other two because they arrive full of colour already.
            </p>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
                {
                    stocks.map((stock) => (
                        <div class="flex flex-col gap-2">
                            <div
                                class="aspect-[4/3] w-full rounded-md border border-ink/10"
                                style={`background-color: ${stock.hex}`}
                            />
                            <div class="font-mono text-xs">
                                <div>{stock.name}</div>
                                <div class="text-ink-muted">{stock.hex}</div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Typefaces -->
        <section>
            <h2
                class="mb-8 font-mono text-xs tracking-widest text-ink-muted uppercase"
            >
                Typefaces
            </h2>
            <div class="flex flex-col divide-y divide-dotted divide-ink/30">
                {
                    typefaces.map((t) => (
                        <div class="flex flex-col gap-3 py-8 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:gap-8">
                            <div class="shrink-0 font-mono text-sm sm:w-48">
                                <div>{t.name}</div>
                                <div class="text-ink-muted">{t.token}</div>
                                <div class="text-ink-muted">{t.role}</div>
                                <div class="text-ink-muted">{t.foundry}</div>
                            </div>
                            <p class:list={[t.cls, "text-lg"]}>{t.sample}</p>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Type scale -->
        <section>
            <h2
                class="mb-8 font-mono text-xs tracking-widest text-ink-muted uppercase"
            >
                Type scale
            </h2>
            <p class="mb-8 max-w-xl font-mono text-sm">
                A fluid scale tuned to the container width, not the viewport.
            </p>
            <div class="flex flex-col divide-y divide-dotted divide-ink/30">
                {
                    typeScale.map((s) => (
                        <div class="flex items-baseline gap-6 py-4 first:pt-0 last:pb-0">
                            <span class="w-20 shrink-0 font-mono text-xs text-ink-muted">
                                {s.token}
                            </span>
                            <span class:list={[s.cls, "font-sans font-bold"]}>
                                Ag
                            </span>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- The bird -->
        <section>
            <h2
                class="mb-8 font-mono text-xs tracking-widest text-ink-muted uppercase"
            >
                The robin
            </h2>
            <p class="mb-8 max-w-xl font-mono text-sm">
                One bird, a few moods. It's the logo and the favicon. Click the
                one in the corner.
            </p>
            <!-- Six cards, so 2-up and 3-up both come out even. -->
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
                {
                    birds.map((b) => (
                        <div class="flex flex-col items-center gap-4 rounded-md border border-ink/10 bg-surface/40 p-6 text-center">
                            {/* Inert: each specimen is pinned to one mood,
                                so the resting bird can't perk up on hover. */}
                            <Bird
                                interactive={false}
                                class:list={[
                                    b.cls,
                                    "pointer-events-none h-24 w-auto text-ink",
                                ]}
                            />
                            <div class="font-mono text-sm">
                                <div>{b.label}</div>
                                <div class="text-ink-muted">{b.note}</div>
                            </div>
                        </div>
                    ))
                }
                <div
                    class="flex flex-col items-center gap-4 rounded-md border border-ink/10 bg-surface/40 p-6 text-center"
                >
                    <Bird404 class="h-24 w-auto text-ink" />
                    <div class="font-mono text-sm">
                        <div>Dazed</div>
                        <div class="text-ink-muted">You found a 404</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Signature details -->
        <section>
            <h2
                class="mb-8 font-mono text-xs tracking-widest text-ink-muted uppercase"
            >
                Signature details
            </h2>
            <div class="flex flex-col divide-y divide-dotted divide-ink/30">
                <div
                    class="flex flex-col gap-2 py-6 first:pt-0 sm:flex-row sm:items-center sm:gap-8"
                >
                    <div class="shrink-0 font-mono text-sm text-ink-muted sm:w-48">
                        .marker
                    </div>
                    <p class="font-mono text-base">
                        A <span class="marker">marker highlight</span>, skewed
                        and slightly rotated.
                    </p>
                </div>
                <div
                    class="flex flex-col gap-2 py-6 last:pb-0 sm:flex-row sm:items-center sm:gap-8"
                >
                    <div class="shrink-0 font-mono text-sm text-ink-muted sm:w-48">
                        a:hover
                    </div>
                    <p class="font-mono text-base">
                        Every <a href="/colophon">link tilts into italic</a> on hover.
                    </p>
                </div>
            </div>
        </section>

        <!-- Built with -->
        <section>
            <h2
                class="mb-8 font-mono text-xs tracking-widest text-ink-muted uppercase"
            >
                Built with
            </h2>
            <p class="max-w-xl font-mono text-base">
                Version four, built with Astro and Tailwind CSS. Static wherever
                it can be — the personal sections (books, films, bookmarks,
                garden notes) come straight from my Obsidian vault. Type is set
                in Apercu, Fira Mono and LiebeHeide. It lives at iamrob.in,
                served by a small Node server on Hetzner via Coolify.
            </p>
            <p class="mt-6 font-mono text-sm text-ink-muted">
                Last updated {timeSince(new Date(latest.date))} —{" "}
                <a href="/changelog">v{latest.version}</a>
            </p>
        </section>
    </div>
</SubpageLayout>

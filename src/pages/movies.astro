---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import MovieYear from "../components/movies/MovieYear.astro";
import Link from "../components/ui/Link.astro";
import Placeholder from "../components/ui/Placeholder.astro";
import { getFilmYears, FEED_LIMIT, PROFILE_URL } from "../utils/movies";

/* One sentence, rendered linked in the hero and flat in the meta description. */
const intro = {
    before: "Films go into ",
    linked: "Letterboxd",
    after: " rather than my Obsidian vault, so this log comes straight from there. Hover a title and its poster comes up.",
};

const years = await getFilmYears();
---

<SubpageLayout
    title="Movies"
    description={`${intro.before}${intro.linked}${intro.after}`}
>
    <Fragment slot="description">
        {intro.before}<Link href={PROFILE_URL} external class="text-base"
            >{intro.linked}</Link
        >{intro.after}
    </Fragment>

    {
        years.length > 0 ? (
            <>
                <div class="flex flex-col gap-16">
                    {years.map((year) => (
                        <MovieYear year={year} />
                    ))}
                </div>

                <p class="mt-16 max-w-xl font-mono text-xs text-ink-muted">
                    Only my last {FEED_LIMIT} films show up here. The older
                    ones are on{" "}
                    <Link href={PROFILE_URL} external>my Letterboxd profile</Link>.
                </p>
            </>
        ) : (
            /* Letterboxd was unreachable at build time. */
            <Placeholder label="Couldn't reach Letterboxd — check back soon" />
        )
    }
</SubpageLayout>

<script src="../scripts/listHoverPreview.ts"></script>

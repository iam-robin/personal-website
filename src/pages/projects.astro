---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import ProjectList from "../components/projects/ProjectList.astro";
import { getAllProjects } from "../utils/projects";

// Every project, newest first, in the same rows as the homepage.
const projects = await getAllProjects();
---

<SubpageLayout
    title="Projects"
    description="Side projects where I try ideas in code, design, generative art and small tools. Some stay small. A few actually become real."
>
    <section aria-label="All projects">
        <ProjectList projects={projects} />
    </section>
</SubpageLayout>

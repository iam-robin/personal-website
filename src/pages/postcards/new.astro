---
import { db, Postcard, eq, and, gt } from "astro:db";
import SubpageLayout from "../../layouts/SubpageLayout.astro";
import Button from "../../components/ui/Button.astro";
import { sendPostcardNotification } from "../../utils/email";

export const prerender = false;

const penColors = [
    "#000000", // Black
    "#0A3161", // Navy Blue
    "#00356B", // Dark Blue
    "#1F3A3D", // Dark Teal
    "#2E5090", // Royal Blue
    "#3B2F2F", // Dark Brown
];

const paperColors = [
    "#FCFAF7", // Off-white
    "#FAF9F6", // Eggshell
    "#F9F8F4", // Lighter Cream
    "#F8F7F2", // Pale Parchment
    "#F9F6F0", // Soft Ivory
    "#F8F6F2", // Pale Beige
    "#F7F4EF", // Lighter Antique
    "#F2F0E6", // Soft Ecru
];

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const author = formData?.get("author");
        const body = formData?.get("body");
        const country = formData?.get("country");
        const websiteUrl = formData?.get("websiteUrl");
        const date = new Date();
        const isPublished = false;
        const stampSvg = formData?.get("stamp-svg");

        // Every postcard is drawn once, at submission, and the values are
        // stored — so a card looks the same on every later render.
        const randomMarginBottom = Math.floor(Math.random() * 8);
        const randomMarginRight = Math.floor(Math.random() * 8);
        const randomRotation = Math.floor(Math.random() * 4 - 2);

        const randomPenColorIndex = Math.floor(
            Math.random() * penColors.length,
        );
        const penColor = penColors[randomPenColorIndex];
        const randomPaperColorIndex = Math.floor(
            Math.random() * paperColors.length,
        );
        const paperColor = paperColors[randomPaperColorIndex];

        const fontSizeFactor = 0.9 + Math.random() * 0.2;
        const lineHeightFactor = 1.1 + Math.random() * 0.4;

        const authorLeftOffset = Math.floor(Math.random() * 10) - 5;
        const authorTopOffset = Math.floor(Math.random() * 6) - 3;
        const authorRotation = Math.floor(Math.random() * 6) - 3;

        const dateLeftOffset = Math.floor(Math.random() * 10) - 5;
        const dateTopOffset = Math.floor(Math.random() * 6) - 3;
        const dateRotation = Math.floor(Math.random() * 6) - 3;

        const bodyLeftOffset = Math.floor(Math.random() * 8) - 4;
        const bodyTopOffset = Math.floor(Math.random() * 8) - 4;
        const bodyRotation = Math.floor(Math.random() * 4) - 2;

        const postOfficeStampTop = Math.floor(Math.random() * 93) - 12; // -12px to 80px
        const postOfficeStampRight = Math.floor(Math.random() * 133) - 12; // -12px to 120px
        const postOfficeStampRotation = Math.floor(Math.random() * 31) - 15; // -15 to +15 degrees

        const wavyStampTop = Math.floor(Math.random() * 69) + 4; // 4px to 72px
        const wavyStampRight = Math.floor(Math.random() * 97) - 24; // -24px to 72px
        const wavyStampRotation = Math.floor(Math.random() * 21) - 10; // -10 to +10 degrees

        if (typeof author === "string" && typeof body === "string") {
            // Swallow a double submit rather than storing the card twice.
            const fiveMinutesAgo = new Date(Date.now() - 5 * 60 * 1000);
            const existing = await db
                .select({ id: Postcard.id })
                .from(Postcard)
                .where(
                    and(
                        eq(Postcard.author, author),
                        eq(Postcard.body, body),
                        gt(Postcard.date, fiveMinutesAgo),
                    ),
                );

            if (existing.length > 0) {
                return Astro.redirect("/postcards/success");
            }

            await db.insert(Postcard).values({
                author,
                body,
                date,
                isPublished,
                marginBottom: randomMarginBottom,
                marginRight: randomMarginRight,
                rotation: randomRotation,
                penColor,
                paperColor,
                fontSizeFactor,
                lineHeight: lineHeightFactor,
                authorLeftOffset,
                authorTopOffset,
                authorRotation,
                dateLeftOffset,
                dateTopOffset,
                dateRotation,
                bodyLeftOffset,
                bodyTopOffset,
                bodyRotation,
                stampSvg: typeof stampSvg === "string" ? stampSvg : "",
                country:
                    typeof country === "string" && country.trim() !== ""
                        ? country
                        : undefined,
                websiteUrl:
                    typeof websiteUrl === "string" && websiteUrl.trim() !== ""
                        ? websiteUrl
                        : undefined,
                postOfficeStampTop,
                postOfficeStampRight,
                postOfficeStampRotation,
                wavyStampTop,
                wavyStampRight,
                wavyStampRotation,
            });

            await sendPostcardNotification({
                author,
                body,
                country:
                    typeof country === "string" && country.trim() !== ""
                        ? country
                        : undefined,
                websiteUrl:
                    typeof websiteUrl === "string" && websiteUrl.trim() !== ""
                        ? websiteUrl
                        : undefined,
                date,
            });

            return Astro.redirect("/postcards/success");
        } else {
            return Astro.redirect("/postcards/error");
        }
    } catch (error) {
        console.error("Error submitting postcard:", error);
        return Astro.redirect("/postcards/error");
    }
}
---

<SubpageLayout
    title="Send a postcard"
    description="Leave a little trace. Tell me what you're thinking, where you're visiting from, or simply that you stopped by — even just a line."
>
    <form method="POST" class="mx-auto flex max-w-md flex-col gap-8">
        <div class="flex flex-col">
            <label for="author" class="mb-1 font-mono text-sm">Your Name</label>
            <input
                id="author"
                name="author"
                required
                class="rounded-md border border-ink/20 bg-paper p-3 font-mono text-base focus:border-ink"
            />
        </div>

        <div class="flex flex-col">
            <label for="body" class="mb-1 font-mono text-sm">Your Message</label>
            <textarea
                id="body"
                name="body"
                rows="6"
                required
                maxlength="270"
                class="rounded-md border border-ink/20 bg-paper p-3 font-mono text-base focus:border-ink"
            ></textarea>
            <span class="mt-1 font-mono text-xs opacity-50"
                >Max. 270 characters, line breaks allowed</span
            >
        </div>

        <div class="flex flex-col">
            <label for="country" class="mb-1 font-mono text-sm"
                >Country (Optional)</label
            >
            <input
                id="country"
                name="country"
                maxlength="18"
                class="rounded-md border border-ink/20 bg-paper p-3 font-mono text-base focus:border-ink"
            />
            <span class="mt-1 font-mono text-xs opacity-50"
                >It's just used to include a cute stamp from your country</span
            >
        </div>

        <div class="flex flex-col">
            <label for="websiteUrl" class="mb-1 font-mono text-sm"
                >Your Website (Optional)</label
            >
            <input
                id="websiteUrl"
                name="websiteUrl"
                type="url"
                placeholder="https://example.com"
                class="rounded-md border border-ink/20 bg-paper p-3 font-mono text-base focus:border-ink"
            />
            <span class="mt-1 font-mono text-xs opacity-50"
                >Make your postcard linked to your website</span
            >
        </div>

        <div class="flex flex-col pb-4">
            <label class="mb-1 font-mono text-sm">Your Stamp</label>
            <span class="mb-4 font-mono text-xs opacity-50"
                >Two flavours. Hit regenerate until one feels like yours.</span
            >

            <div class="mb-4 flex w-fit gap-2">
                <Button
                    data-stamp-variant="shapes"
                    pressed={true}
                    size="sm"
                    class="variant-pill"
                >
                    Shapes
                </Button>
                <Button
                    data-stamp-variant="bird"
                    pressed={false}
                    size="sm"
                    class="variant-pill"
                >
                    Robin
                </Button>
            </div>

            <div class="flex w-fit items-center gap-4">
                <div
                    class="stamp relative inline-block h-[144px] w-[144px] bg-white p-[6px]"
                >
                    <div class="h-full w-full bg-white">
                        <div id="stamp-preview"></div>
                        <div id="stamp-preview-bird" hidden></div>
                    </div>
                </div>

                <Button
                    id="regenerate-stamp"
                    variant="outline"
                    size="sm"
                    class="shrink-0 text-xs"
                >
                    Regenerate
                </Button>
            </div>
            <input type="hidden" id="stamp-svg" name="stamp-svg" value="" />
        </div>

        <Button type="submit" variant="primary" size="lg" shape="box" class="submit-btn">
            Send Postcard
        </Button>
        <p class="mt-2 text-center font-mono text-xs opacity-50">
            Only the information you provide above is stored in a database.<br
            />No IP addresses or any other personal data is collected.
        </p>
    </form>
</SubpageLayout>

<script is:inline>
    document.querySelector("form").addEventListener("submit", function () {
        const btn = document.querySelector(".submit-btn");
        // The native `disabled` attribute is the whole mechanism: it blocks the
        // second click, and `disabled:` styling carries the look. Setting
        // opacity and pointer-events inline did the same job in a way no
        // stylesheet could see or override.
        btn.disabled = true;
        btn.textContent = "Sending…";
    });
</script>

<style>
    /* The picked variant flips to solid ink, same as an active FilterTag. */
    .variant-pill[aria-pressed="true"] {
        background-color: var(--color-ink);
        color: var(--color-paper);
    }

    .stamp {
        -webkit-filter: drop-shadow(0px 0px 2px rgba(0, 0, 0, 0.5));
        background: radial-gradient(
            transparent 0px,
            transparent 4px,
            white 4px,
            white
        );
        background-size: 12px 12px;
        background-position: -18px -18px;
    }
</style>

<script>
    import p5 from "p5";
    import P5SVGExtension from "p5.js-svg";
    import { generateBirdStamp } from "../../utils/stamps/birdStamp";

    if (typeof P5SVGExtension === "function") {
        P5SVGExtension(p5);
    } else {
        console.error(
            "P5SVGExtension is not a function. SVG rendering might fail.",
        );
    }

    // Two generators, one hidden input. Each keeps its own last result so
    // switching back and forth restores exactly what's still on screen —
    // neither preview is redrawn when it's only being revealed again.
    type StampVariant = "shapes" | "bird";
    let activeVariant: StampVariant = "shapes";
    let shapesSvg = "";
    let birdSvg = "";

    const setStampSvgInput = (svg: string) => {
        const hiddenInput = document.getElementById(
            "stamp-svg",
        ) as HTMLInputElement | null;
        if (!hiddenInput) {
            console.error("Hidden input #stamp-svg not found!");
            return;
        }
        hiddenInput.value = svg;
    };

    const sketch = (p: any) => {
        const CANVAS_WIDTH = 132;
        const CANVAS_HEIGHT = 132;
        const MIN_CELLS = 1;
        const MAX_CELLS = 3;

        const CANVAS_COLOR = "#fff"; // Overall canvas background

        let p5canvas: any;
        let numCells: number;
        let cellSize: number;
        let shapeDrawingFunctions: Array<
            (x: number, y: number, size: number) => void
        > = [];
        let currentPalette: string[] | undefined;

        const colorPalettes: string[][] = [
            ["#FF6B6B", "#FFD93D", "#6BCB77", "#4D96FF"], // Bright & Playful
            ["#2C3E50", "#E74C3C", "#ECF0F1", "#3498DB", "#2ECC71"], // Modern Flat
            ["#A8DADC", "#457B9D", "#1D3557", "#F1FAEE", "#E63946"], // Oceanic
            ["#264653", "#2A9D8F", "#E9C46A", "#F4A261", "#E76F51"], // Earthy & Warm
            ["#003049", "#D62828", "#F77F00", "#FCBF49", "#EAE2B7"], // Retro
            ["#333333", "#666666", "#999999", "#CCCCCC", "#EEEEEE"], // Grayscale
            ["#E63946", "#F1FAEE", "#A8DADC", "#457B9D", "#1D3557"], // Vibrant Red/Blue (variation of Oceanic)
            ["#D90429", "#EF233C", "#EDF2F4", "#8D99AE", "#2B2D42"], // Strong Reds & Grays
            ["#007F5F", "#2B9348", "#55A630", "#80B918", "#AACC00"], // Shades of Green
            ["#023E8A", "#0077B6", "#0096C7", "#00B4D8", "#48CAE4"], // Shades of Blue
            ["#6A0572", "#A6036F", "#D0006F", "#FF006E", "#FFB703"], // Shades of Purple/Blue/Orange
            ["#FF9A8B", "#FF6F61", "#6A0572", "#D0006F", "#FFB703"], // Pink/Red/Orange
            ["#ACB0D4", "#6F6FF1", "#F38556", "#03017F", "#45519D"], // Purple/Blue/Orange
            ["#5F45B2", "#9467C6", "#C888D9", "#FEACEE", "#428FFB"], // Pastel Purple/Blue
        ];

        const getRandomColorFromPalette = (): string => {
            if (currentPalette && currentPalette.length > 0) {
                return p.random(currentPalette);
            }
            // Should not happen — a palette is picked before any draw.
            return (
                "#" +
                Math.floor(Math.random() * 16777215)
                    .toString(16)
                    .padStart(6, "0")
            );
        };

        const selectNewPalette = () => {
            currentPalette = p.random(colorPalettes);
        };

        const generateGridParameters = () => {
            numCells = p.floor(p.random(MIN_CELLS, MAX_CELLS + 1));
            cellSize = CANVAS_WIDTH / numCells;
        };

        const initializeShapeFunctions = (): void => {
            shapeDrawingFunctions = [
                (x: number, y: number, size: number) => {
                    p.rect(x, y, size, size);
                },
                (x: number, y: number, size: number) => {
                    p.ellipse(x + size / 2, y + size / 2, size, size);
                },
                (x: number, y: number, size: number) => {
                    p.triangle(x, y, x + size, y, x, y + size);
                },
                (x: number, y: number, size: number) => {
                    p.triangle(x + size, y + size, x, y + size, x + size, y);
                },
                (x: number, y: number, size: number) => {
                    p.triangle(x, y, x + size, y, x + size, y + size);
                },
                (x: number, y: number, size: number) => {
                    p.triangle(x, y + size, x + size, y + size, x, y);
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x + size / 2,
                        y + size / 2,
                        size,
                        size,
                        p.PI,
                        p.TWO_PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x + size / 2,
                        y + size / 2,
                        size,
                        size,
                        0,
                        p.PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x + size / 2,
                        y + size / 2,
                        size,
                        size,
                        p.HALF_PI,
                        p.PI + p.HALF_PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x + size / 2,
                        y + size / 2,
                        size,
                        size,
                        p.PI + p.HALF_PI,
                        p.HALF_PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x + size,
                        y + size,
                        size * 2,
                        size * 2,
                        p.PI,
                        p.PI + p.HALF_PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x,
                        y + size,
                        size * 2,
                        size * 2,
                        p.PI + p.HALF_PI,
                        p.TWO_PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(
                        x + size,
                        y,
                        size * 2,
                        size * 2,
                        p.HALF_PI,
                        p.PI,
                        p.PIE,
                    );
                },
                (x: number, y: number, size: number) => {
                    p.arc(x, y, size * 2, size * 2, 0, p.HALF_PI, p.PIE);
                },
                (x: number, y: number, size: number) => {
                    p.beginShape();
                    p.vertex(x, y);
                    p.quadraticVertex(x, y + size, x + size, y + size);
                    p.quadraticVertex(x + size, y, x, y);
                    p.endShape(p.CLOSE);
                },
                (x: number, y: number, size: number) => {
                    p.beginShape();
                    p.vertex(x + size, y);
                    p.quadraticVertex(x, y, x, y + size);
                    p.quadraticVertex(x + size, y + size, x + size, y);
                    p.endShape(p.CLOSE);
                },
                // Four triangles meeting at the centre, one colour each.
                (x: number, y: number, size: number) => {
                    const centerX = x + size / 2;
                    const centerY = y + size / 2;

                    p.fill(getRandomColorFromPalette());
                    p.triangle(x, y, x + size, y, centerX, centerY);

                    p.fill(getRandomColorFromPalette());
                    p.triangle(
                        x + size,
                        y,
                        x + size,
                        y + size,
                        centerX,
                        centerY,
                    );

                    p.fill(getRandomColorFromPalette());
                    p.triangle(
                        x + size,
                        y + size,
                        x,
                        y + size,
                        centerX,
                        centerY,
                    );

                    p.fill(getRandomColorFromPalette());
                    p.triangle(x, y + size, x, y, centerX, centerY);
                },
                (x: number, y: number, size: number) => {
                    const centerX = x + size / 2;
                    const centerY = y + size / 2;
                    const outerDiameter = size;
                    const innerDiameter = size * 0.6; // Inner circle is 60% of the outer

                    p.fill(getRandomColorFromPalette());
                    p.ellipse(centerX, centerY, outerDiameter, outerDiameter);

                    p.fill(getRandomColorFromPalette());
                    p.ellipse(centerX, centerY, innerDiameter, innerDiameter);
                },
            ];
        };

        const updateStampSvgInput = () => {
            if (
                p5canvas &&
                (p5canvas as any).svg &&
                typeof (p5canvas as any).svg.outerHTML === "string"
            ) {
                const svgString = (p5canvas as any).svg.outerHTML;
                shapesSvg =
                    svgString &&
                    svgString.length > 0 &&
                    svgString.startsWith("<svg")
                        ? svgString
                        : "";
            } else {
                shapesSvg = "";
            }

            // p5 draws on setup regardless of which variant is showing; only
            // the active one owns the input.
            if (activeVariant === "shapes") setStampSvgInput(shapesSvg);
        };

        p.setup = () => {
            const renderer = (p5 as any).SVG || (p as any).SVG;
            p5canvas = p.createCanvas(
                CANVAS_WIDTH,
                CANVAS_HEIGHT,
                renderer || undefined,
            );

            const parentDiv = document.getElementById("stamp-preview");
            if (!parentDiv) {
                console.error("[p.setup] Parent div #stamp-preview not found!");
            } else {
                if (p5canvas) {
                    p5canvas.parent("stamp-preview");
                }
            }

            p.noStroke();
            p.noLoop();

            initializeShapeFunctions();
            selectNewPalette(); // Select initial palette
            generateGridParameters();
        };

        p.draw = () => {
            p.background(CANVAS_COLOR);

            for (let i = 0; i < numCells; i++) {
                for (let j = 0; j < numCells; j++) {
                    const cellX = i * cellSize;
                    const cellY = j * cellSize;

                    p.fill(getRandomColorFromPalette());
                    p.rect(cellX, cellY, cellSize, cellSize);

                    p.fill(getRandomColorFromPalette());

                    if (
                        shapeDrawingFunctions &&
                        shapeDrawingFunctions.length > 0
                    ) {
                        const drawRandomShape = p.random(shapeDrawingFunctions);
                        drawRandomShape(cellX, cellY, cellSize);
                    }
                }
            }
            updateStampSvgInput();
        };

        (p as any).regenerate = () => {
            selectNewPalette(); // Select a new palette on regenerate
            generateGridParameters();
            p.redraw();
        };
    };

    const p5Instance = new p5(sketch);

    const shapesPreview = document.getElementById("stamp-preview");
    const birdPreview = document.getElementById("stamp-preview-bird");

    const regenerateShapes = () => {
        if (typeof (p5Instance as any).regenerate === "function") {
            (p5Instance as any).regenerate();
        } else {
            console.error("p5 instance or regenerate function not available.");
        }
    };

    const regenerateBird = () => {
        birdSvg = generateBirdStamp();
        if (birdPreview) birdPreview.innerHTML = birdSvg;
        setStampSvgInput(birdSvg);
    };

    const setVariant = (variant: StampVariant) => {
        activeVariant = variant;

        for (const button of document.querySelectorAll<HTMLButtonElement>(
            "[data-stamp-variant]",
        )) {
            button.setAttribute(
                "aria-pressed",
                String(button.dataset.stampVariant === variant),
            );
        }

        shapesPreview?.toggleAttribute("hidden", variant !== "shapes");
        birdPreview?.toggleAttribute("hidden", variant !== "bird");

        // The revealed preview is still showing its last result, so hand the
        // input that same string rather than drawing a new one.
        if (variant === "bird" && !birdSvg) regenerateBird();
        else setStampSvgInput(variant === "bird" ? birdSvg : shapesSvg);
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>(
        "[data-stamp-variant]",
    )) {
        button.addEventListener("click", () => {
            const variant = button.dataset.stampVariant;
            if (variant === "shapes" || variant === "bird") setVariant(variant);
        });
    }

    const regenerateButton = document.getElementById("regenerate-stamp");
    if (regenerateButton) {
        regenerateButton.addEventListener("click", () => {
            if (activeVariant === "bird") regenerateBird();
            else regenerateShapes();
        });
    } else {
        console.error("Regenerate button not found.");
    }
</script>

---
import type { GetStaticPaths } from "astro";
import {
    isValidCountry,
    getStandardCountryName,
} from "../../../../utils/countries";
import SubpageLayout from "../../../../layouts/SubpageLayout.astro";
import PostcardsView from "../../../../components/postcards/PostcardsView.astro";
import SendPostcardCta from "../../../../components/postcards/SendPostcardCta.astro";
import {
    getPublishedPostcards,
    POSTCARDS_PAGE_SIZE,
} from "../../../../utils/postcards";

export const getStaticPaths = (async ({ paginate }) => {
    const postcards = await getPublishedPostcards();

    const countries = [
        ...new Set(
            postcards
                .map((p) => p.country)
                .filter((c): c is string => !!c && isValidCountry(c))
                .map((c) => getStandardCountryName(c)),
        ),
    ];

    // One paginated set of routes per country.
    return countries.flatMap((country) => {
        const cards = postcards.filter(
            (p) => p.country && getStandardCountryName(p.country) === country,
        );
        return paginate(cards, {
            pageSize: POSTCARDS_PAGE_SIZE,
            params: { country },
            props: { selectedCountry: country },
        });
    });
}) satisfies GetStaticPaths;

const { page, selectedCountry } = Astro.props;
const description = `An archive of postcards sent to this website from ${selectedCountry}.`;
---

<SubpageLayout
    title="Postcards"
    documentTitle={`Postcards from ${selectedCountry}${
        page.currentPage > 1 ? ` (page ${page.currentPage})` : ""
    } — Robin Spielmann`}
    description={description}
    noindex
>
    <SendPostcardCta slot="cta" />
    <PostcardsView page={page} selectedCountry={selectedCountry} />
</SubpageLayout>

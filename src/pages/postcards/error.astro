---
import SubpageLayout from "../../layouts/SubpageLayout.astro";
import Button from "../../components/ui/Button.astro";
---

<SubpageLayout
    title="Something went wrong"
    documentTitle="Postcard error — Robin Spielmann"
    description="Unable to send your postcard. Please try again, or get in touch if the problem persists."
    noindex
>
    <div class="flex flex-col items-start gap-4">
        <Button href="/postcards/new" variant="primary" size="lg" shape="box">
            Try again
        </Button>
        <a
            href="/postcards"
            class="font-mono text-sm underline underline-offset-4 text-ink-muted hover:text-ink"
        >
            Back to postcards
        </a>
    </div>
</SubpageLayout>

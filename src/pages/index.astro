---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import TeaserSection from "../components/TeaserSection.astro";
import BirdFeeder from "../components/BirdFeeder.astro";
import ProjectsTeaser from "../components/projects/ProjectsTeaser.astro";
import BlogTeaser from "../components/blog/BlogTeaser.astro";
import Link from "../components/ui/Link.astro";
import Nav from "../components/ui/Nav.astro";
import ContactSection from "../components/ui/ContactSection.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import FooterColumns from "../components/ui/FooterColumns.astro";
import RssDropdown from "../components/ui/RssDropdown.astro";
import MobileMenu from "../components/ui/MobileMenu.astro";
import PostcardItem from "../components/postcards/PostcardItem.astro";
import { getFeaturedProjects } from "../utils/projects";
import { getFanImages } from "../utils/projectFans";
import { getNewestPostcards, toPostcardProps } from "../utils/postcards";

const projects = await getFeaturedProjects();

// Fan images shown in the hero on card hover — shared with the /projects
// previews via the util. handcoded.art has the project id "geeenerated".
const matchprintPosters = getFanImages("matchprint")!;
const fanPhotos = getFanImages("robins-photos")!;
const handcodedArt = getFanImages("geeenerated")!;

const newestPostcards = await getNewestPostcards(3);

// Hovering a card swaps the hero's default intro for that card's panel — pure
// CSS via :has(), no client JS. Each entry pairs the trigger a hovered <li>'s
// direct child carries with the [data-panel] it reveals.
//
// The predicate is the <li> (li:hover > trigger), not the trigger itself:
// adjacent li boxes are contiguous, so crossing a divider never drops the
// state. Panels fade with a ~100ms delay so quick pass-throughs don't flicker.
// Transitions come from the destination state: showing flips visibility at the
// delay start, hiding holds it until the fade ends (that half lives on the
// [data-panel] base rule below).
const SHOW_TRANSITION =
    "transition: opacity 0.15s ease-out 0.1s, visibility 0s 0.1s;";
const HIDE_TRANSITION =
    "transition: opacity 0.15s ease-out 0.1s, visibility 0s 0.25s;";

const heroPanels = [
    ...projects.map((project) => ({
        trigger: `[data-project="${project.id}"]`,
        panel: project.id,
    })),
    { trigger: `[data-hero-panel="postcards"]`, panel: "postcards" },
];

// Hovering any trigger hides the default intro...
const hideDefaultCss = `
${heroPanels
    .map((p) => `.home:has(li:hover > ${p.trigger}) [data-panel="default"]`)
    .join(",\n")} {
    opacity: 0;
    visibility: hidden;
    ${HIDE_TRANSITION}
}`;

// ...and reveals that trigger's own panel.
const panelCss = heroPanels
    .map(
        (p) => `
.home:has(li:hover > ${p.trigger}) [data-panel="${p.panel}"] {
    opacity: 1;
    visibility: visible;
    ${SHOW_TRANSITION}
}`,
    )
    .join("\n");

// Gated to lg: below it the hero stacks above the cards, where a tap's sticky
// :hover would invisibly swap (or blank) the hero off-screen. And to pointers
// that hover: a touch tablet clears the width but not the interaction, and
// gets the cards' own static fans (MobileFan) instead.
const hoverCss = `@media (min-width: 64rem) and (hover: hover) {\n${hideDefaultCss}\n${panelCss}\n}`;
---

<Layout
    title="Robin Spielmann — Design Engineer"
    description="Design engineer at the intersection of code, design and art. My own little space on the internet: side projects, writing, photography and postcards."
>
    <script is:inline>
        /**
         * Gate for the landing entrance (the `[data-entrance="play"]` rules
         * below). CSS does the animating; this only decides whether it runs,
         * so without JS the page renders in its final state. Runs at the top
         * of <body> so the attribute is set before the hero is parsed.
         */
        (() => {
            const root = document.documentElement;
            const mode = new URLSearchParams(location.search).get("transition");

            let navType = "navigate";
            try {
                navType =
                    performance.getEntriesByType("navigation")[0]?.type ??
                    "navigate";
            } catch {}

            let fromThisSite = false;
            try {
                fromThisSite =
                    !!document.referrer &&
                    new URL(document.referrer).origin === location.origin;
            } catch {}

            // Never when asked not to, and never on a restored scroll
            // position — a page opening mid-column has nothing to introduce.
            if (mode === "off" || window.scrollY > 0) return;

            // The entrance is for *arriving*, so internal navigations and
            // back/forward are out. A reload has to outrank both explicitly:
            // it carries a same-origin referrer of its own.
            if (
                navType !== "reload" &&
                (navType === "back_forward" || fromThisSite)
            )
                return;

            root.dataset.entrance = "play";

            // Any deliberate input cuts to the finished page. Every animation
            // ends on the base state, so dropping the attribute mid-flight
            // lands exactly where it was headed.
            const events = [
                "pointerdown",
                "keydown",
                "wheel",
                "touchstart",
                "scroll",
            ];
            const end = () => {
                root.removeAttribute("data-entrance");
                for (const type of events) removeEventListener(type, end);
            };
            for (const type of events)
                addEventListener(type, end, { passive: true });

            // Cleanup once the last beat has landed (the sheet slide).
            setTimeout(end, 1550);
        })();
    </script>

    <div class="home lg:grid lg:grid-cols-2">
        <!-- Left half: sticky hero. z-10 keeps it above the entrance sheet,
             which in turn sits above the right column. -->
        <header
            class="@container relative z-10 flex flex-col lg:sticky lg:top-0 lg:h-screen"
        >
            <!-- justify-end keeps the RSS icon right where the nav is hidden
                 on mobile and MobileMenu takes over. -->
            <div
                data-entrance-chrome
                class="flex items-center justify-end px-gutter py-8 md:justify-between lg:px-gutter-lg"
            >
                <Nav />
                <RssDropdown />
            </div>
            <div
                data-entrance-hero
                class="relative flex w-full flex-1 items-center px-gutter lg:px-gutter-lg"
            >
                <div data-panel="default">
                    <BirdFeeder class="mb-8" />
                    <!-- Spans rather than a <br> so each line balances its own
                         text; .entrance-line makes the break unconditional. -->
                    <h1 class="max-w-3xl text-3xl font-bold text-balance">
                        <span class="entrance-line">Robin&nbsp;Spielmann —</span
                        >
                        <span class="entrance-line"
                            >a <a href="/work" class="marker entrance-marker"
                                >design engineer</a
                            > at the intersection of code, design&nbsp;&amp;&nbsp;art.</span
                        >
                    </h1>
                    <p class="mt-8 max-w-xl font-mono text-base">
                        This website is my own little space on the internet — a
                        place to share my work, interests and passions without
                        pleasing the algorithms of social media platforms. I
                        hope you enjoy exploring my digital living room as much
                        as I enjoyed building it.
                    </p>
                </div>

                <!-- Project panels: swap in over the hero content on hover -->
                {
                    projects.map((project) => {
                        // Projects with visuals show only those — the hovered
                        // card already carries title, description and tags.
                        // Ones without assets fall back to a text panel.
                        const hasFan = !!getFanImages(project.id);
                        return (
                            <div
                                data-panel={project.id}
                                class="pointer-events-none invisible absolute inset-0 flex flex-col justify-center px-gutter opacity-0 lg:px-gutter-lg"
                            >
                                {!hasFan && (
                                    <>
                                        <h2 class="text-xl font-bold">
                                            {project.data.title}
                                        </h2>
                                        <p class="mt-4 max-w-md font-mono text-base">
                                            {project.data.description}
                                        </p>
                                        <span class="mt-4 block font-mono text-sm opacity-50">
                                            {[
                                                project.data.year,
                                                ...(project.data.tags ?? []),
                                            ].join(" · ")}
                                        </span>
                                    </>
                                )}
                                {project.id === "robins-photos" && (
                                    <div class="photo-fan" aria-hidden="true">
                                        {fanPhotos.map((photo) => (
                                            <Image
                                                src={photo}
                                                alt=""
                                                width={600}
                                                widths={[300, 600]}
                                                sizes="18vw"
                                                loading="lazy"
                                                fetchpriority="low"
                                                class="photo-fan-card"
                                            />
                                        ))}
                                    </div>
                                )}
                                {project.id === "matchprint" && (
                                    <div class="poster-fan" aria-hidden="true">
                                        {matchprintPosters.map((poster) => (
                                            <Image
                                                src={poster}
                                                alt=""
                                                width={600}
                                                widths={[300, 600]}
                                                sizes="18vw"
                                                loading="lazy"
                                                fetchpriority="low"
                                                class="poster-fan-card"
                                            />
                                        ))}
                                    </div>
                                )}
                                {project.id === "geeenerated" && (
                                    <div class="art-fan" aria-hidden="true">
                                        {handcodedArt.map((art) => (
                                            <Image
                                                src={art}
                                                alt=""
                                                width={600}
                                                widths={[300, 600]}
                                                sizes="16vw"
                                                loading="lazy"
                                                fetchpriority="low"
                                                class="art-fan-card"
                                            />
                                        ))}
                                    </div>
                                )}
                            </div>
                        );
                    })
                }

                {
                    /* Swaps in when the contact section's "Send a postcard" row
                    is hovered (see hoverCss + data-hero-panel). */
                }
                <div
                    data-panel="postcards"
                    class="pointer-events-none invisible absolute inset-0 flex flex-col justify-center px-gutter opacity-0 lg:px-gutter-lg"
                >
                    {
                        /* The handwriting's distortion filter must be in the DOM
                        or the filtered text is not rendered. */
                    }
                    <svg class="hidden" aria-hidden="true">
                        <defs>
                            <filter id="distort-xl">
                                <feTurbulence baseFrequency="1 1" numOctaves="1"
                                ></feTurbulence>
                                <feDisplacementMap
                                    in="SourceGraphic"
                                    scale="1.3"></feDisplacementMap>
                            </filter>
                        </defs>
                    </svg>
                    <div class="postcard-fan" aria-hidden="true">
                        {
                            newestPostcards.map((postcard) => (
                                <div class="postcard-fan-card">
                                    <PostcardItem
                                        {...toPostcardProps(postcard)}
                                        distorted={false}
                                        hoverEffect={false}
                                        rotation={0}
                                    />
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
            <!-- Desktop only: on mobile the hero stacks above the teasers, so
                 this would land mid-page. FooterColumns stands in below. -->
            <div data-entrance-chrome class="hidden lg:block">
                <SiteFooter class="px-gutter py-8 lg:px-gutter-lg" />
            </div>
        </header>

        <!-- Right half: scrollable teasers. pt-20 below lg gives room where
             they stack under the hero; pt-8 once the split layout kicks in. -->
        <main
            class="content-column @container border-ink/15 px-gutter pt-20 pb-8 lg:border-l lg:px-gutter-lg lg:pt-8"
        >
            <div class="flex flex-col gap-24">
                <ProjectsTeaser />
                <BlogTeaser />
                <ContactSection />
            </div>
        </main>

        <!-- The entrance sheet: a full-viewport pane of paper that slides off
             to the left, uncovering the right column. Fixed rather than
             absolute so it covers the viewport exactly and isn't a grid item;
             display:none unless the entrance is playing. -->
        <div class="entrance-cover" aria-hidden="true"></div>

        <!-- Mobile-only: stands in for the hero's SiteFooter. -->
        <FooterColumns
            class="border-t border-dotted border-ink/30 px-gutter py-12 lg:hidden"
        />

        <MobileMenu />
    </div>

    <style is:inline set:html={hoverCss}></style>

    <style>
        /*
          ── Entrance ────────────────────────────────────────────────────
          Two acts, gated by the inline script above. Act 1: one sheet of
          paper over the whole viewport with the hero alone on it, which
          then marks its own words. Act 2: that sheet slides off to the
          left, uncovering the right column — which sits in its final
          position throughout and is never animated.

          One rule governs everything here: animations run FROM a start
          state TO the base CSS, with `backwards` fill and no `forwards`.
          The finished page is the unstyled page, so cutting an animation
          short at any moment lands exactly where it was going.

          Act 2 is gated to lg — below it there's no second column, so the
          title card simply is the page.
        */

        /* A custom property because the entrance sheet's edge rule has to be
           mixed against this exact value (see .entrance-cover's box-shadow). */
        .home {
            --content-bg: color-mix(
                in srgb,
                var(--color-surface) 40%,
                var(--color-paper)
            );
        }

        /* Only where there are two columns to tell apart — stacked, the tint
           reads as an arbitrary darker band between two paper ones. */
        @media (min-width: 64rem) {
            .content-column {
                background-color: var(--content-bg);
            }
        }

        /* Unconditional: these spans replace the headline's old <br>. */
        .entrance-line {
            display: block;
        }

        /* Off by default, so no JS, reduced motion and every non-lg width get
           the plain page — no state can strand a pane over the content. */
        .entrance-cover {
            display: none;
        }

        @media (prefers-reduced-motion: no-preference) {
            /* ── Act 1 ── */

            /* The hero arrives as one composition, not three staggered beats.
               Opacity only — the one movement belongs to the sheet in Act 2. */
            :global([data-entrance="play"]) [data-panel="default"] {
                animation: entrance-fade-in 400ms ease-out 80ms backwards;
            }

            /* The highlight draws after its sentence settles. `backwards`
               holds it fully clipped through the delay. */
            :global([data-entrance="play"]) .entrance-marker::before {
                animation: entrance-marker-draw 260ms ease-out 520ms backwards;
            }

            /* Chrome comes in under cover of the slide rather than as a beat
               of its own — by then the eye is on the sheet. */
            :global([data-entrance="play"]) [data-entrance-chrome] {
                animation: entrance-fade-in 340ms ease-out 980ms backwards;
            }

            /* Both ends stated explicitly: an implicit `to` interpolates
               towards the base value, and clip-path's base is `none`, which
               doesn't interpolate at all — the wipe pops instead. */
            @keyframes entrance-fade-in {
                from {
                    opacity: 0;
                }
                to {
                    opacity: 1;
                }
            }

            @keyframes entrance-marker-draw {
                from {
                    clip-path: inset(0 100% 0 0);
                }
                to {
                    clip-path: inset(0 0 0 0);
                }
            }

            /* ── Act 2 ── */
            @media (min-width: 64rem) {
                /*
                  Cued by the marker finishing. The right column takes no
                  part — it's painted in its final position from the first
                  frame and the reveal is simply the sheet leaving.

                  Both halves share a duration and easing so they read as one
                  movement, but travel different distances (sheet 50vw, hero
                  25vw) — a cover being drawn off, not a page the hero is
                  printed on. No spring: the overshoot reads as a wobble on a
                  single hairline.
                */
                :global([data-entrance="play"]) .entrance-cover {
                    display: block;
                    position: fixed;
                    inset: 0;
                    /* Above the right column, below the hero (header is z-10). */
                    z-index: 1;
                    pointer-events: none;
                    background-color: var(--color-paper);
                    /*
                      The gutter rule, riding the sheet's right edge. A shadow
                      rather than a border so it draws just outside the box and
                      lands on exactly the pixels <main>'s border-l occupies —
                      a border-right would land 1px early and jump.

                      Opaque, because two coinciding ink/15 lines compound to
                      ~28% and the rule would darken for the length of the
                      slide. Mixed against --content-bg, not paper: it's drawn
                      over the content column the whole way.
                    */
                    box-shadow: 1px 0 0
                        color-mix(
                            in srgb,
                            var(--color-ink) 15%,
                            var(--content-bg)
                        );
                    /* -50% of the sheet's own width, not -50vw: `vw` counts
                       the scrollbar and the grid column doesn't, so 50vw
                       parks the edge short and the rule jumps at the
                       handover. */
                    transform: translateX(-50%);
                    animation: entrance-cover-slide 620ms
                        cubic-bezier(0.33, 1, 0.68, 1) 780ms backwards;
                }

                /* On the hero's content, not the <header> — that one is
                   sticky and has no business carrying an animation. 50% of
                   its own width centres the hero on the full-width sheet. */
                :global([data-entrance="play"]) [data-entrance-hero] {
                    animation: entrance-hero-settle 620ms
                        cubic-bezier(0.33, 1, 0.68, 1) 780ms backwards;
                }

                @keyframes entrance-cover-slide {
                    from {
                        transform: translateX(0);
                    }
                    to {
                        transform: translateX(-50%);
                    }
                }

                @keyframes entrance-hero-settle {
                    from {
                        transform: translateX(50%);
                    }
                    to {
                        transform: translateX(0);
                    }
                }
            }
        }

        /* Base-state halves of the panel fade (see hoverCss above): a project
           panel starts hidden so it carries the hiding transition; the default
           panel starts visible so it carries the showing one. */
        [data-panel] {
            transition:
                opacity 0.15s ease-out 0.1s,
                visibility 0s 0.25s;
        }

        [data-panel="default"] {
            transition:
                opacity 0.15s ease-out 0.1s,
                visibility 0s 0.1s;
        }

        @media not all and (min-width: 64rem), (hover: none) {
            .photo-fan,
            .poster-fan,
            .art-fan {
                display: none;
            }
        }

        /* Loose two-row stack of 2:3 cards, like prints laid out on a table.
           The width cap's vh term keeps it inside the h-screen hero on short
           viewports (nav + footer + breathing room ≈ 16rem). */
        .poster-fan,
        .photo-fan {
            position: relative;
            aspect-ratio: 20 / 21;
            width: min(100%, 34rem, calc((100vh - 16rem) * 20 / 21));
            margin-inline: auto;
        }

        .poster-fan-card,
        .photo-fan-card {
            position: absolute;
            width: 38%;
            height: auto;
            border-radius: 0.375rem;
            border: 1px solid
                color-mix(in srgb, var(--color-ink) 15%, transparent);
        }

        /* Photos read as plain prints: square corners. */
        .photo-fan-card {
            border-radius: 0;
        }

        /* Offsets and rotations are irregular on purpose — hand-placed
           rather than a tidy grid. */
        .poster-fan-card:nth-child(1),
        .photo-fan-card:nth-child(1) {
            left: 0;
            top: 0;
            z-index: 6;
            transform: rotate(-3.5deg);
        }
        .poster-fan-card:nth-child(2),
        .photo-fan-card:nth-child(2) {
            left: 30%;
            top: 3%;
            z-index: 5;
            transform: rotate(1deg);
        }
        .poster-fan-card:nth-child(3),
        .photo-fan-card:nth-child(3) {
            left: 61%;
            top: 1%;
            z-index: 4;
            transform: rotate(4deg);
        }
        .poster-fan-card:nth-child(4),
        .photo-fan-card:nth-child(4) {
            left: 13%;
            top: 48%;
            z-index: 3;
            transform: rotate(-2deg);
        }
        .poster-fan-card:nth-child(5),
        .photo-fan-card:nth-child(5) {
            left: 46%;
            top: 51%;
            z-index: 2;
            transform: rotate(3deg);
        }

        /* handcoded.art: seven near-square prints scattered 3 / 2 / 2. Squarer
           cards are shorter, so a third row fits the same hero height. */
        .art-fan {
            position: relative;
            aspect-ratio: 5 / 6;
            width: min(100%, 33rem, calc((100vh - 14rem) * 5 / 6));
            margin-inline: auto;
        }

        .art-fan-card {
            position: absolute;
            width: 40%;
            height: auto;
            border-radius: 0.375rem;
            border: 1px solid
                color-mix(in srgb, var(--color-ink) 15%, transparent);
        }

        /* Row 1 (3 cards) */
        .art-fan-card:nth-child(1) {
            left: 2%;
            top: 2%;
            z-index: 7;
            transform: rotate(-4deg);
        }
        .art-fan-card:nth-child(2) {
            left: 31%;
            top: 0%;
            z-index: 6;
            transform: rotate(2deg);
        }
        .art-fan-card:nth-child(3) {
            left: 60%;
            top: 3%;
            z-index: 5;
            transform: rotate(4.5deg);
        }
        /* Row 2 (2 cards, offset into the gaps above) */
        .art-fan-card:nth-child(4) {
            left: 13%;
            top: 31%;
            z-index: 4;
            transform: rotate(-2.5deg);
        }
        .art-fan-card:nth-child(5) {
            left: 48%;
            top: 29%;
            z-index: 3;
            transform: rotate(3deg);
        }
        /* Row 3 (2 cards) */
        .art-fan-card:nth-child(6) {
            left: 3%;
            top: 60%;
            z-index: 2;
            transform: rotate(-3deg);
        }
        .art-fan-card:nth-child(7) {
            left: 39%;
            top: 58%;
            z-index: 1;
            transform: rotate(3.5deg);
        }

        /* The three newest cards as a loose hand: newest front and centre,
           the older two fanning up behind. Landscape, so a wider spread. */
        .postcard-fan {
            position: relative;
            aspect-ratio: 1 / 1;
            width: min(100%, 32rem, calc(100vh - 13rem));
            margin-inline: auto;
        }

        .postcard-fan-card {
            position: absolute;
            width: 84%;
        }

        /* First = newest (front); later children peek out behind. */
        .postcard-fan-card:nth-child(1) {
            left: 8%;
            top: 30%;
            z-index: 3;
            transform: rotate(1.5deg);
        }
        .postcard-fan-card:nth-child(2) {
            left: 1%;
            top: 12%;
            z-index: 2;
            transform: rotate(-5deg);
        }
        .postcard-fan-card:nth-child(3) {
            left: 15%;
            top: 15%;
            z-index: 1;
            transform: rotate(5.5deg);
        }
    </style>
</Layout>

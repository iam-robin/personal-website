---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import BookmarkItem from "../components/bookmarks/BookmarkItem.astro";
import BookmarkFilter from "../components/bookmarks/BookmarkFilter.astro";
import { getBookmarks, getTags } from "../utils/bookmarks";

const bookmarks = await getBookmarks();
const tags = getTags(bookmarks);

const legend = [
    { label: "Article", color: "oklch(0.75 0.16 155)" },
    { label: "Website", color: "oklch(0.81 0.11 295)" },
    { label: "Video", color: "oklch(0.7 0.13 255.5)" },
    { label: "Misc", color: "oklch(0.73 0.14 22.5)" },
];
---

<SubpageLayout
    title="Bookmarks"
    description="Daily I receive new articles, videos, essays, etc. in the RSS reader of my choice, Unread. The ones I love I tag and save into my Obsidian vault — and from there they flow straight onto this page."
>
    <ul class="flex flex-wrap items-center gap-4 font-mono text-xs opacity-70">
        {
            legend.map((item) => (
                <li class="flex items-center gap-1.5">
                    <span
                        class="inline-block h-2 w-2 rounded-full"
                        style={`background-color: ${item.color}`}
                    />
                    {item.label}
                </li>
            ))
        }
    </ul>

    <div class="mt-10">
        <BookmarkFilter tags={tags} total={bookmarks.length} />
    </div>

    <ul class="mt-10 md:mt-8">
        {bookmarks.map((bookmark) => <BookmarkItem bookmark={bookmark.data} />)}
    </ul>
</SubpageLayout>

<script src="../scripts/listHoverPreview.ts"></script>

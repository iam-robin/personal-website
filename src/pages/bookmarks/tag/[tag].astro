---
import SubpageLayout from "../../../layouts/SubpageLayout.astro";
import BookmarkItem from "../../../components/bookmarks/BookmarkItem.astro";
import BookmarkFilter from "../../../components/bookmarks/BookmarkFilter.astro";
import { getBookmarks, getTags, tagSlug } from "../../../utils/bookmarks";

export async function getStaticPaths() {
    const bookmarks = await getBookmarks();
    return getTags(bookmarks).map((tag) => ({
        params: { tag: tagSlug(tag.name) },
        props: { tagName: tag.name },
    }));
}

const { tagName } = Astro.props;

const allBookmarks = await getBookmarks();
const tags = getTags(allBookmarks);
const bookmarks = allBookmarks.filter((b) => b.data.tags.includes(tagName));
const description = `Bookmarks I saved about ${tagName}. Articles, essays, videos and small internet finds from my linkding.`;
---

<SubpageLayout
    title="Bookmarks"
    description={description}
    documentTitle={`#${tagName} — Bookmarks — Robin Spielmann`}
>
    <BookmarkFilter tags={tags} total={allBookmarks.length} active={tagName} />

    <ul class="mt-10 md:mt-8">
        {bookmarks.map((bookmark) => <BookmarkItem bookmark={bookmark.data} />)}
    </ul>
</SubpageLayout>

<script src="../../../scripts/listHoverPreview.ts"></script>

---
import Button from "../../components/ui/Button.astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import {
    creativeWorkSchema,
    graphSchema,
    personSchema,
    websiteSchema,
} from "../../utils/schema";
import "../../styles/markdown.css";

// Only for projects the cards link to internally — the rest open their own
// site (externalUrl) or are unlinked (draft).
export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects
        .filter((p) => !p.data.externalUrl && !p.data.draft)
        .map((project) => ({
            params: { slug: project.id },
            props: { project },
        }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, year } = project.data;

const projectDocumentTitles: Record<string, string> = {
    lumon: "Lumon — Severance interface recreation",
    "meaningful-animations": "Meaningful animations — UX motion thesis",
    "media-camp": "media.camp — Student barcamp website",
    "notion-budget": "Notion budget dashboard",
    "oh-my": "oh my — Browser extension for web habits",
};

const documentTitle = projectDocumentTitles[project.id] ?? `${title} — Project`;

const structuredData = graphSchema([
    personSchema,
    websiteSchema,
    creativeWorkSchema({
        url: new URL(Astro.url.pathname, Astro.site).href,
        title,
        description,
        keywords: tags,
        dateCreated: year,
    }),
]);
---

<Layout
    title={documentTitle}
    description={description}
    structuredData={structuredData}
>
    <Button
        href="/projects"
        label="Close"
        iconOnly
        size="lg"
        variant="ghost"
        class="fixed top-4 right-4 z-50 no-underline"
    >
        <Icon name="ph:x-bold" size={24} />
    </Button>

    {/* A focused reading view. The measure is `prose` (65ch) rather than the
      `reading` token, since this page aligns to nothing.

      Deliberately no `@container`: without one the fluid type scale falls
      back to its viewport line, and the oversized title is the page. */}
    <article class="mx-auto w-full max-w-prose px-gutter py-16 md:py-24">
        <header>
            <h1 class="text-3xl font-bold md:text-4xl">{title}</h1>
            <p class="mt-2 text-lg">{description}</p>
            {
                tags && tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <span class="rounded-full bg-ink/10 px-3 py-1 font-mono text-sm">
                                {tag}
                            </span>
                        ))}
                    </div>
                )
            }
            {year && <p class="mt-4 font-mono text-sm text-ink-muted">{year}</p>}
        </header>

        <div class="blog-prose mt-12">
            <Content />
        </div>
    </article>
</Layout>

<style>
</style>

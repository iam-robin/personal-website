---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import ShelfRow from "../components/books/ShelfRow.astro";
import { getShelfYears } from "../utils/books";

/* "On the pile" is held back for now. getPile() in utils/books.ts still
   works; add an <Eyebrow> and a list to restore it. */
const years = await getShelfYears();

const total = years.reduce((sum, year) => sum + year.books.length, 0);

/* Links an open book to its line under the row. Not a scoped style: the
   selector crosses ShelfRow and BookSpine, and scoping would stamp one hash on
   both. One rule per index, derived from the data. `visibility` carries the
   delay, or the outgoing line would still catch the pointer. */
const maxBooks = Math.max(...years.map((year) => year.books.length));

const detailCss = `
.shelf-detail > span {
    opacity: 0;
    visibility: hidden;
}

@media (prefers-reduced-motion: no-preference) {
    .shelf-detail > span {
        transition: opacity 160ms ease-out, visibility 0s 160ms;
    }
${Array.from(
    { length: maxBooks },
    (_, i) => `
    .shelf-row:has(.shelf > li:nth-child(${i + 1}) details[open]) .shelf-detail > span:nth-child(${i + 1}) {
        transition: opacity 220ms ease-out 380ms, visibility 0s 380ms;
    }`,
).join("")}
}
${Array.from(
    { length: maxBooks },
    (_, i) => `
.shelf-row:has(.shelf > li:nth-child(${i + 1}) details[open]) .shelf-detail > span:nth-child(${i + 1}) {
    opacity: 1;
    visibility: visible;
}`,
).join("")}`;
---

<SubpageLayout
    title="Books"
    description="Every book I finish, logged from Obsidian with covers, page counts and spine colours. Click a book to turn it around."
>
    <div class="flex flex-col gap-16">
        {years.map((year) => <ShelfRow year={year} />)}
    </div>

    <p class="mt-16 font-mono text-xs text-ink-muted">
        {total} books on the shelf.
    </p>
</SubpageLayout>

<style is:inline set:html={detailCss}></style>

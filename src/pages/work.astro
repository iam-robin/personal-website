---
import { Image } from "astro:assets";
import ArticleLayout from "../layouts/ArticleLayout.astro";
import Button from "../components/ui/Button.astro";
import RoleDiagram from "../components/work/RoleDiagram.astro";
import InkMark from "../components/ui/InkMark.astro";
import portrait from "../assets/robin-portrait.avif";

// Used on the page and in the meta description below — declared once.
const headline =
    "Design Engineer with 8+ years of experience in building digital products, web applications and design systems.";
const focus =
    "Focus on scalable interfaces and a close collaboration between design and development.";

// ArticleLayout passes hideHero, so this only reaches the meta tag.
const metaDescription = `${headline} ${focus}`;

const facets: { icon: string; title: string; body: string }[] = [
    {
        icon: "build",
        title: "Building it for real",
        body: "A design engineer is being able to implement the interfaces and work together with other developers on the codebase. Nothing gets lost between the design and what ships, and the person who drew it handles the part a design file can't hold: real-world cases, the states nobody sketched, accessibility, performance.",
    },
    {
        icon: "feel",
        title: "Look and feel",
        body: "It's not just important how a product looks, but also how it feels while it's being used. Microinteractions, states, the small bits of feedback that confirm something happened. On most teams nobody owns that part. A design engineer is the person who does.",
    },
    {
        icon: "longevity",
        title: "Longevity",
        body: "Shipping a product once isn't the job. A design engineer helps setting the guidelines and rules together with the design and development team, so the quality doesn't erode with every feature added after launch.",
    },
    {
        icon: "both-languages",
        title: "Speaking both languages",
        body: "Designers and developers judge the same work by different criteria. The design engineer speaks both, and keeps the two sides building one thing instead of talking past each other.",
    },
];

// Kept in sync with cv.iamrob.in — a shortlist, not the full proficiencies.
const details: { label: string; value: string }[] = [
    {
        label: "Focus",
        value: "Design systems, web applications, digital products",
    },
    {
        label: "Tools",
        value: "TypeScript, React, Next.js, Astro, Tailwind, Storybook, Figma, Claude Code, Claude Design",
    },
    {
        label: "Languages",
        value: "German (native), English (fluent)",
    },
];

// Raw SVG rather than <img> so the fills, rewritten to currentColor, inherit
// the page's ink. A client with no file falls back to its name set in type.
const logoSvgs = import.meta.glob<string>("../assets/logos/*.svg", {
    query: "?raw",
    import: "default",
    eager: true,
});

const clients: { name: string; logo: string }[] = [
    { name: "Union Investment", logo: "ui" },
    { name: "Scout24", logo: "scout24" },
    { name: "Caritas", logo: "caritas" },
    { name: "Sto", logo: "sto" },
    { name: "shareDnC", logo: "sharednc" },
];

const sectionHeading = "scroll-mt-8 text-lg font-bold";
---

{
    /* No rail: too few sections for a contents list to be navigation rather
    than furniture. */
}
<ArticleLayout title="Work" description={metaDescription}>
    <div class="mt-4">
        {
            /* The statement sits on the lead measure, which is what makes the
            pair fit: 30rem + 2rem gap + the 10rem portrait is the reading
            column exactly. */
        }
        <header
            class="flex flex-col gap-10 md:grid md:grid-cols-[minmax(0,var(--container-lead))_auto] md:items-start md:gap-8"
        >
            <div>
                <p class="font-mono text-sm opacity-50">
                    Robin Spielmann — Munich, and remote
                </p>
                <h1 class="mt-6 text-2xl font-bold text-balance">{headline}</h1>
            </div>
            {
                /* order-first below md, so the portrait doesn't split the
                statement from the paragraph continuing it. */
            }
            <Image
                src={portrait}
                alt="Black-and-white portrait of Robin Spielmann in profile"
                widths={[160, 320]}
                sizes="(min-width: 768px) 160px, 40vw"
                loading="eager"
                fetchpriority="high"
                class="order-first w-[130px] rotate-4 mt-12 border-4 border-white sm:w-40 md:order-0"
            />
            <p class="max-w-lead text-prose leading-relaxed">
                {focus} What I care about most is the part after the code works: how
                something feels, the states nobody planned for and the system behind
                it.
            </p>
        </header>

        <div class="mt-8 flex flex-wrap gap-3">
            <Button href="mailto:hey@iamrob.in" variant="primary">
                Get in touch
            </Button>
            <Button href="https://cv.iamrob.in" external>View CV</Button>
        </div>

        <div class="mt-24 flex flex-col gap-24">
            <section>
                <dl
                    class="divide-y divide-dotted divide-ink/30 border-y border-dotted border-ink/30"
                >
                    {
                        details.map((detail) => (
                            <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
                                <dt class="font-mono text-sm opacity-50">
                                    {detail.label}
                                </dt>
                                <dd class="font-mono text-sm">
                                    {detail.value}
                                </dd>
                            </div>
                        ))
                    }
                </dl>
            </section>

            <section>
                <h2 id="what-a-design-engineer-does" class={sectionHeading}>
                    What's a Design Engineer?
                </h2>
                <p class="mt-2 text-prose leading-relaxed">
                    Since there isn't (yet) a universally accepted definition
                    for this job description, here's my take on the skills a
                    design engineer can bring to a team.
                </p>
                <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2">
                    {
                        facets.map((facet) => (
                            <div>
                                <h3 class="flex items-center gap-2.5 text-prose font-bold">
                                    <InkMark
                                        name={facet.icon}
                                        class="h-5 w-5 shrink-0 opacity-60"
                                    />
                                    {facet.title}
                                </h3>
                                <p class="mt-2 text-prose leading-relaxed">
                                    {facet.body}
                                </p>
                            </div>
                        ))
                    }
                </div>
                <p class="mt-10 text-prose leading-relaxed">
                    All of this matters more than it ever has. Writing code
                    stopped being the bottleneck a while ago. Keeping a product
                    consistent and the quality high is the hard part now, and
                    teams ship faster than ever, which means more chances to
                    pull it out of shape. Holding it together is what this role
                    is for.
                </p>
                <RoleDiagram class="mt-12 w-full max-w-[320px] text-ink" />
            </section>

            <section>
                <h2 id="where-i-come-from" class={sectionHeading}>
                    Where I come from
                </h2>
                <div
                    class="mt-5 flex flex-col gap-4 text-prose leading-relaxed"
                >
                    <p>
                        I started in graphic design. Then I studied media
                        computer science, because I wanted to build the things I
                        was drawing. Then a master's in interactive media,
                        because building them had taught me things about
                        designing them. Looking back, it reads less like three
                        changes of direction and more like the same subject
                        approached from three sides.
                    </p>
                    <p>
                        Professionally I went deep on front-end. Years of
                        building interfaces for production, with a fair amount
                        of architecture and under-the-hood work underneath them.
                        Often quite technical, but never really about the code.
                        Code is the vehicle. What has to come out right is
                        whether the product is any good.
                    </p>
                    <p>
                        The design half never stopped either. I kept building
                        design systems meant to still hold up a year later, and
                        adding the micro-animations that make a product feel
                        like it responds properly, usually the first thing cut
                        when time gets short. I also ran coding workshops and
                        mentored the developers coming up behind me, which does
                        much the same job as a design system: get the shared
                        language right, and the team builds consistently without
                        anyone having to police it.
                    </p>
                </div>
            </section>

            <section>
                <h2 id="companies" class={sectionHeading}>
                    Companies I've worked with
                </h2>
                <ul
                    class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-8 text-ink"
                >
                    {
                        clients.map((client) => {
                            const mark =
                                logoSvgs[`../assets/logos/${client.logo}.svg`];
                            return (
                                <li class="flex items-center">
                                    <span
                                        class:list={
                                            mark
                                                ? "sr-only"
                                                : "text-lg font-bold"
                                        }
                                    >
                                        {client.name}
                                    </span>
                                    {mark && (
                                        <span
                                            aria-hidden="true"
                                            class="[&>svg]:h-7 [&>svg]:w-auto"
                                            set:html={mark}
                                        />
                                    )}
                                </li>
                            );
                        })
                    }
                </ul>
            </section>
        </div>
    </div>
</ArticleLayout>

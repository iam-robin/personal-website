---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import SeriesYear from "../components/series/SeriesYear.astro";
import { getSeasonYears } from "../utils/series";

const years = await getSeasonYears();

// Finished only, to match the year headers. Shows are counted too, since
// seasons repeat a show.
const seasons = years
    .flatMap((year) => year.seasons)
    .filter((season) => !season.watching);
const shows = new Set(seasons.map((season) => season.title)).size;
---

<SubpageLayout
    title="Series"
    description="Every season I finish gets logged in Obsidian — poster, cast, the year I got through it. This page is that log, year by year."
>
    <div class="flex flex-col gap-16">
        {years.map((year) => <SeriesYear year={year} />)}
    </div>

    <p class="mt-16 font-mono text-xs text-ink-muted">
        {seasons.length} seasons across {shows} shows.
    </p>
</SubpageLayout>

<script src="../scripts/listHoverPreview.ts"></script>

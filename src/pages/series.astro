---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import SeriesYear from "../components/series/SeriesYear.astro";
import { getSeasonYears, getWatchlist } from "../utils/series";

const [years, watchlist] = await Promise.all([
    getSeasonYears(),
    getWatchlist(),
]);

// Finished only, so the total agrees with the year headers and with the count
// /shelf shows. Seasons is the honest unit — the log records one per season —
// but a list with Ozark on it four times needs the second number to be read
// properly.
const seasons = years
    .flatMap((year) => year.seasons)
    .filter((season) => !season.watching);
const shows = new Set(seasons.map((season) => season.title)).size;
---

<SubpageLayout
    title="Series"
    description="Every season I finish gets logged in Obsidian — poster, cast, the year I got through it. This page is that log, year by year."
>
    <div class="flex flex-col gap-16">
        {years.map((year) => <SeriesYear year={year} />)}
    </div>

    <p class="mt-16 font-mono text-xs text-ink-muted">
        {seasons.length} seasons across {shows} shows.
    </p>

    {
        watchlist.length > 0 && (
            <section class="mt-24">
                <Eyebrow class="border-b border-dotted border-ink/30 pb-4">
                    On the list
                </Eyebrow>
                <ul class="mt-4 flex flex-col gap-2">
                    {watchlist.map((item, i) => (
                        <li class="flex items-baseline gap-3 font-mono text-sm">
                            {/* The label names the group, not the row — the
                                same list /shelf uses for "Right now". */}
                            {/* The label register — uppercase + tracking — carries the column,
                                since the contrast floor leaves ink only two steps
                                and the muted one is already spent on the author. */}
                            <span class="w-32 shrink-0 text-xs tracking-widest text-ink-muted uppercase">
                                {watchlist[i - 1]?.label === item.label
                                    ? ""
                                    : item.label}
                            </span>
                            <span>
                                {item.title}
                                {item.season && (
                                    <span class="text-ink-muted">
                                        {" "}
                                        — Season {item.season}
                                    </span>
                                )}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }
</SubpageLayout>

<script src="../scripts/listHoverPreview.ts"></script>
